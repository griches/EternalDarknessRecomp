+/* Emit a paired-single result whose two lanes are evaluated into temporaries
+ * before fD is written, so fD may alias any source register. */
+static void emit_ps_pair(FILE* out, const PPCInst* inst, const char* lane0,
+                         const char* lane1) {
+    fprintf(out, "    {\n");
+    fprintf(out, "        f64 lane0 = dolrecomp_ps_round(%s);\n", lane0);
+    fprintf(out, "        f64 lane1 = dolrecomp_ps_round(%s);\n", lane1);
+    fprintf(out, "        ctx->fpr[%u] = lane0;\n", inst->rD);
+    fprintf(out, "        ctx->ps1[%u] = lane1;\n", inst->rD);
+    if (inst->rc) emit_set_cr1_from_fpscr(out);
+    fprintf(out, "    }\n");
+}

+static void emit_fast_ram(FILE* out) {
+    static const struct { unsigned bits; const char* type; const char* swap; } sizes[] = {
+        { 8u, "u8", "" },
+        { 16u, "u16", "__builtin_bswap16" },
+        { 32u, "u32", "__builtin_bswap32" },
+        { 64u, "u64", "__builtin_bswap64" },
+    };
+    unsigned i;
+    /* DOLRECOMP_STATIC_CPU=<symbol>: the host keeps its one guest CPU in that
+     * global, and chunk functions address it directly (a link-time constant)
+     * instead of through their ctx argument, which in a chunk-sized function
+     * the register allocator spills and reloads at nearly every instruction. */
+    fprintf(out, "#if defined(DOLRECOMP_CHUNK) && defined(DOLRECOMP_STATIC_CPU)\n");
+    fprintf(out, "#if defined(__GNUC__) || defined(__clang__)\n");
+    fprintf(out, "extern CPUState DOLRECOMP_STATIC_CPU __attribute__((visibility(\"hidden\")));\n");
+    fprintf(out, "#else\n");
+    fprintf(out, "extern CPUState DOLRECOMP_STATIC_CPU;\n");
+    fprintf(out, "#endif\n");
+    fprintf(out, "#define DOLRECOMP_CTX(arg) (&DOLRECOMP_STATIC_CPU)\n");
+    fprintf(out, "#else\n");
+    fprintf(out, "#define DOLRECOMP_CTX(arg) (arg)\n");
+    fprintf(out, "#endif\n\n");

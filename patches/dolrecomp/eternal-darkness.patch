+/* Fast RAM access for chunk files (DOLRECOMP_CHUNK): loads and stores to
+ * cached MEM1 (0x80000000 + ram_size) go straight to ctx->ram instead of through
+ * the runtime's mem_read / mem_write calls. Everything else (the uncached
+ * mirror, MMIO, locked cache, MEM2), and any store while a lwarx reservation is
+ * held, still takes the runtime path. The host enables it with
+ * dolrecomp_fast_ram: bit 0 loads, bit 1 stores (off while it watches stores). */
+static void emit_fast_ram(FILE* out) {
+    static const struct { unsigned bits; const char* type; const char* swap; } sizes[] = {
+        { 8u, "u8", "" },
+        { 16u, "u16", "__builtin_bswap16" },
+        { 32u, "u32", "__builtin_bswap32" },
+        { 64u, "u64", "__builtin_bswap64" },
+    };
+    unsigned i;
+    fprintf(out, "#if defined(DOLRECOMP_CHUNK) && !defined(DOLRECOMP_NO_FAST_RAM)\n");
+    fprintf(out, "extern u8 dolrecomp_fast_ram;\n\n");
+    for (i = 0; i < sizeof sizes / sizeof sizes[0]; i++) {
+        const unsigned bits = sizes[i].bits, bytes = bits / 8u;
+        const char* t = sizes[i].type;
+        const char* sw = sizes[i].swap;
+        fprintf(out, "static inline %s dolrecomp_mem_read%u(CPUState* ctx, u32 ea) {\n", t, bits);
+        fprintf(out, "    const u32 off = ea - 0x80000000u;\n");
+        fprintf(out, "    if ((dolrecomp_fast_ram & 1u) != 0u && off <= ctx->ram_size - %uu) {\n", bytes);
+        fprintf(out, "        %s v;\n", t);
+        fprintf(out, "        memcpy(&v, ctx->ram + off, %uu);\n", bytes);
+        fprintf(out, "        return %s(v);\n", sw);
+        fprintf(out, "    }\n");
+        fprintf(out, "    return (mem_read%u)(ctx, ea);\n", bits);
+        fprintf(out, "}\n\n");
+        fprintf(out, "static inline void dolrecomp_mem_write%u(CPUState* ctx, u32 ea, %s value) {\n", bits, t);
+        fprintf(out, "    const u32 off = ea - 0x80000000u;\n");
+        fprintf(out, "    if ((dolrecomp_fast_ram & 2u) != 0u && !ctx->reserve_valid &&\n");
+        fprintf(out, "        off <= ctx->ram_size - %uu) {\n", bytes);
+        fprintf(out, "        value = %s(value);\n", sw);
+        fprintf(out, "        memcpy(ctx->ram + off, &value, %uu);\n", bytes);
+        fprintf(out, "        return;\n");
+        fprintf(out, "    }\n");
+        fprintf(out, "    (mem_write%u)(ctx, ea, value);\n", bits);
+        fprintf(out, "}\n\n");
+    }
+    for (i = 0; i < sizeof sizes / sizeof sizes[0]; i++) {
+        fprintf(out, "#define mem_read%u(ctx, ea) dolrecomp_mem_read%u(ctx, ea)\n",
+                sizes[i].bits, sizes[i].bits);
+        fprintf(out, "#define mem_write%u(ctx, ea, v) dolrecomp_mem_write%u(ctx, ea, v)\n",
+                sizes[i].bits, sizes[i].bits);
+    }
+    fprintf(out, "#endif\n\n");
 }
 

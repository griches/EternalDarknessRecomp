+/* Fast RAM access for chunk files (DOLRECOMP_CHUNK): loads and stores to
+ * cached MEM1 (0x80000000 + ram_size) go straight to ctx->ram instead of through
+ * the runtime's mem_read / mem_write calls. Everything else (the uncached
+ * mirror, MMIO, locked cache, MEM2), and any store while a lwarx reservation is
+ * held, still takes the runtime path. The host enables it with
+ * dolrecomp_fast_ram: bit 0 loads, bit 1 stores (off while it watches stores),
+ * bit 2 stores to the GX write-gather pipe (0xCC008000, 32 bytes), which go
+ * straight to the host's dolrecomp_wgp_write instead of the MMIO lookup.
+ *
+ * Paired-single loads and stores (psq_l / psq_st) and fmadd(s) are inline too
+ * for the common case, with the same results as the runtime's ppc_psq_load,
+ * ppc_psq_store and ppc_fma (FPRF included): psq on cached MEM1 or the
+ * write-gather pipe with any valid quantization type, fma with finite inputs
+ * (and, for fmadds, a frC that is not a denormal). Everything else calls the
+ * runtime. */
+static const char fast_ps_source[] =
+    "/* 2^n as a double (n in -64..64): the GQR dequantize / quantize scale. */\n"
+    "static inline f64 dolrecomp_pow2(s32 n) {\n"
+    "    return dolrecomp_f64_from_bits((u64)(1023 + n) << 52);\n"
+    "}\n"
+    "\n"
+    "static inline s32 dolrecomp_gqr_scale(u32 field) {\n"
+    "    const s32 s = (s32)(field & 0x3Fu);\n"
+    "    return (s & 0x20) != 0 ? s - 64 : s;\n"
+    "}\n"
+    "\n"
+    "static inline int dolrecomp_psq_enabled(const CPUState* ctx, bool indexed) {\n"
+    "    const u32 need = indexed ? PPC_HID2_PSE : (PPC_HID2_PSE | PPC_HID2_LSQE);\n"
+    "    return (ctx->hid2 & need) == need;\n"
+    "}\n"
+    "\n"
+    "static inline f64 dolrecomp_psq_dequant(const u8* p, u32 type, f64 mul) {\n"
+    "    f64 v;\n"
+    "    switch (type) {\n"
+    "    case 4u: v = (f64)p[0]; break;\n"
+    "    case 5u: v = (f64)(u16)((p[0] << 8) | p[1]); break;\n"
+    "    case 6u: v = (f64)(s8)p[0]; break;\n"
+    "    default: v = (f64)(s16)(u16)((p[0] << 8) | p[1]); break;\n"
+    "    }\n"
+    "    return (f64)(f32)(v * mul);\n"
+    "}\n"
+    "\n"
+    "static inline void dolrecomp_psq_load(CPUState* ctx, u8 frD, u32 ea, bool w,\n"
+    "                                      u8 gi, bool indexed, u32 cia) {\n"
+    "    const u32 gqr = ctx->gqr[gi & 7u];\n"
+    "    const u32 type = (gqr >> 16) & 7u;\n"
+    "    const u32 off = ea - 0x80000000u;\n"
+    "    if ((dolrecomp_fast_ram & 1u) != 0u && off <= DOLRECOMP_RAM_SIZE - 8u &&\n"
+    "        dolrecomp_psq_enabled(ctx, indexed)) {\n"
+    "        const u8* p = ctx->ram + off;\n"
+    "        if (type == 0u && (ea & 3u) == 0u) {\n"
+    "            u32 bits;\n"
+    "            memcpy(&bits, p, 4u);\n"
+    "            ctx->fpr[frD] = (f64)dolrecomp_f32_from_bits(__builtin_bswap32(bits));\n"
+    "            if (w) {\n"
+    "                ctx->ps1[frD] = 1.0;\n"
+    "            } else {\n"
+    "                memcpy(&bits, p + 4, 4u);\n"
+    "                ctx->ps1[frD] = (f64)dolrecomp_f32_from_bits(__builtin_bswap32(bits));\n"
+    "            }\n"
+    "            return;\n"
+    "        }\n"
+    "        if (type >= 4u) {\n"
+    "            const f64 mul = dolrecomp_pow2(-dolrecomp_gqr_scale(gqr >> 24));\n"
+    "            ctx->fpr[frD] = dolrecomp_psq_dequant(p, type, mul);\n"
+    "            ctx->ps1[frD] = w ? 1.0 : dolrecomp_psq_dequant(p + ((type & 1u) ? 2u : 1u), type, mul);\n"
+    "            return;\n"
+    "        }\n"
+    "    }\n"
+    "    (ppc_psq_load)(ctx, frD, ea, w, gi, indexed, cia);\n"
+    "}\n"
+    "\n"
+    "static inline u32 dolrecomp_psq_quant(f64 v, s32 lo, s32 hi, f64 mul) {\n"
+    "    if (v != v)\n"
+    "        return (u32)hi;\n"
+    "    const f64 s = trunc(v * mul);\n"
+    "    if (s <= (f64)lo)\n"
+    "        return (u32)lo;\n"
+    "    if (s >= (f64)hi)\n"
+    "        return (u32)hi;\n"
+    "    return (u32)(s32)s;\n"
+    "}\n"
+    "\n"
+    "static inline u32 dolrecomp_psq_store_bits(f64 v, u32 type, f64 mul) {\n"
+    "    switch (type) {\n"
+    "    case 0u: {\n"
+    "        const u32 bits = dolrecomp_f32_to_bits((f32)v);\n"
+    "        return (bits & 0x7F800000u) == 0u && (bits & 0x007FFFFFu) != 0u ? 0u : bits;\n"
+    "    }\n"
+    "    case 4u: return dolrecomp_psq_quant(v, 0, 255, mul) & 0xFFu;\n"
+    "    case 5u: return dolrecomp_psq_quant(v, 0, 65535, mul) & 0xFFFFu;\n"
+    "    case 6u: return dolrecomp_psq_quant(v, -128, 127, mul) & 0xFFu;\n"
+    "    default: return dolrecomp_psq_quant(v, -32768, 32767, mul) & 0xFFFFu;\n"
+    "    }\n"
+    "}\n"
+    "\n"
+    "static inline void dolrecomp_psq_put(u8* p, u32 v, u32 size) {\n"
+    "    if (size == 4u) {\n"
+    "        v = __builtin_bswap32(v);\n"
+    "        memcpy(p, &v, 4u);\n"
+    "    } else if (size == 2u) {\n"
+    "        p[0] = (u8)(v >> 8);\n"
+    "        p[1] = (u8)v;\n"
+    "    } else {\n"
+    "        p[0] = (u8)v;\n"
+    "    }\n"
+    "}\n"
+    "\n"
+    "static inline void dolrecomp_psq_store(CPUState* ctx, u8 frS, u32 ea, bool w,\n"
+    "                                       u8 gi, bool indexed, u32 cia) {\n"
+    "    const u32 gqr = ctx->gqr[gi & 7u];\n"
+    "    const u32 type = gqr & 7u;\n"
+    "    const u32 off = ea - 0x80000000u;\n"
+    "    const int ram = (dolrecomp_fast_ram & 2u) != 0u && !ctx->reserve_valid &&\n"
+    "                    off <= DOLRECOMP_RAM_SIZE - 8u;\n"
+    "    const int wgp = (dolrecomp_fast_ram & 4u) != 0u && ea - 0xCC008000u < 0x18u;\n"
+    "    if ((ram || wgp) && dolrecomp_psq_enabled(ctx, indexed) &&\n"
+    "        (type == 0u ? (ea & 3u) == 0u : type >= 4u)) {\n"
+    "        const u32 size = type == 0u ? 4u : (type & 1u) ? 2u : 1u;\n"
+    "        const f64 mul = type == 0u ? 1.0 : dolrecomp_pow2(dolrecomp_gqr_scale(gqr >> 8));\n"
+    "        const u32 v0 = dolrecomp_psq_store_bits(ctx->fpr[frS], type, mul);\n"
+    "        const u32 v1 = w ? 0u : dolrecomp_psq_store_bits(ctx->ps1[frS], type, mul);\n"
+    "        if (ram) {\n"
+    "            dolrecomp_psq_put(ctx->ram + off, v0, size);\n"
+    "            if (!w)\n"
+    "                dolrecomp_psq_put(ctx->ram + off + size, v1, size);\n"
+    "        } else {\n"
+    "            dolrecomp_wgp_write(ctx, ea, v0, (u8)size);\n"
+    "            if (!w)\n"
+    "                dolrecomp_wgp_write(ctx, ea + size, v1, (u8)size);\n"
+    "        }\n"
+    "        return;\n"
+    "    }\n"
+    "    (ppc_psq_store)(ctx, frS, ea, w, gi, indexed, cia);\n"
+    "}\n"
+    "\n"
+    "static inline u32 dolrecomp_fprf_f64(u64 bits) {\n"
+    "    const u64 e = bits & 0x7FF0000000000000ull, f = bits & 0x000FFFFFFFFFFFFFull;\n"
+    "    const int s = (int)(bits >> 63);\n"
+    "    if (e == 0x7FF0000000000000ull)\n"
+    "        return f ? 0x11u : (s ? 0x09u : 0x05u);\n"
+    "    if (e == 0u)\n"
+    "        return f ? (s ? 0x18u : 0x14u) : (s ? 0x12u : 0x02u);\n"
+    "    return s ? 0x08u : 0x04u;\n"
+    "}\n"
+    "\n"
+    "static inline u32 dolrecomp_fprf_f32(u32 bits) {\n"
+    "    const u32 e = bits & 0x7F800000u, f = bits & 0x007FFFFFu;\n"
+    "    const int s = (int)(bits >> 31);\n"
+    "    if (e == 0x7F800000u)\n"
+    "        return f ? 0x11u : (s ? 0x09u : 0x05u);\n"
+    "    if (e == 0u)\n"
+    "        return f ? (s ? 0x18u : 0x14u) : (s ? 0x12u : 0x02u);\n"
+    "    return s ? 0x08u : 0x04u;\n"
+    "}\n"
+    "\n"
+    "/* ppc_fma for finite inputs: fmadds rounds frC to 25 bits and corrects the\n"
+    " * double rounding exactly as the runtime does; a denormal frC (fmadds) or any\n"
+    " * NaN / infinity goes to the runtime. */\n"
+    "static inline bool dolrecomp_fma(CPUState* ctx, f64 a, f64 c, f64 b, bool single,\n"
+    "                                 bool subtract, bool negative, f64* output) {\n"
+    "    const u64 cb = dolrecomp_f64_to_bits(c);\n"
+    "    if (isfinite(a) && isfinite(b) && isfinite(c) &&\n"
+    "        (!single || (cb & 0x7FF0000000000000ull) != 0u ||\n"
+    "         (cb & 0x000FFFFFFFFFFFFFull) == 0u)) {\n"
+    "        const f64 addend = subtract ? -b : b;\n"
+    "        f64 result;\n"
+    "        u32 fprf;\n"
+    "        if (!single) {\n"
+    "            result = fma(a, c, addend);\n"
+    "            if (negative)\n"
+    "                result = -result;\n"
+    "            fprf = dolrecomp_fprf_f64(dolrecomp_f64_to_bits(result));\n"
+    "        } else {\n"
+    "            const f64 rc = dolrecomp_f64_from_bits((cb & 0xFFFFFFFFF8000000ull) +\n"
+    "                                                   (cb & 0x0000000008000000ull));\n"
+    "            result = fma(a, rc, addend);\n"
+    "            u64 bits = dolrecomp_f64_to_bits(result);\n"
+    "            if ((bits & 0x000000001FFFFFFFull) == 0x0000000010000000ull) {\n"
+    "                const f64 a_prime = addend - result;\n"
+    "                const f64 b_prime = result + a_prime;\n"
+    "                const f64 error = fma(a, rc, a_prime) + (addend - b_prime);\n"
+    "                if (error != 0.0) {\n"
+    "                    if ((error > 0.0) == (result > 0.0)) bits++;\n"
+    "                    else bits--;\n"
+    "                    result = dolrecomp_f64_from_bits(bits);\n"
+    "                }\n"
+    "            }\n"
+    "            result = (f64)(f32)result;\n"
+    "            if (negative)\n"
+    "                result = -result;\n"
+    "            fprf = dolrecomp_fprf_f32(dolrecomp_f32_to_bits((f32)result));\n"
+    "        }\n"
+    "        ctx->fpscr = (ctx->fpscr & ~(0x1Fu << 12)) | (fprf << 12);\n"
+    "        *output = result;\n"
+    "        return true;\n"
+    "    }\n"
+    "    return (ppc_fma)(ctx, a, c, b, single, subtract, negative, output);\n"
+    "}\n"
+    "\n"
+    "#define ppc_psq_load(ctx, r, ea, w, i, x, cia) dolrecomp_psq_load(ctx, r, ea, w, i, x, cia)\n"
+    "#define ppc_psq_store(ctx, r, ea, w, i, x, cia) dolrecomp_psq_store(ctx, r, ea, w, i, x, cia)\n"
+    "#define ppc_fma(ctx, a, c, b, s, sub, neg, out) dolrecomp_fma(ctx, a, c, b, s, sub, neg, out)\n";

+// After the frame's passes: copy the surface texture for a later map.
+Slot* copy(wgpu::CommandEncoder& encoder, const wgpu::Texture& texture) {
+  const uint32_t frame = g_frame++;
+  static const uint32_t first = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_FIRST");
+    return e != nullptr ? static_cast<uint32_t>(std::atoi(e)) : 0u;
+  }();
+  static const uint32_t count = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_COUNT");
+    return e != nullptr ? static_cast<uint32_t>(std::atoi(e)) : 600u;
+  }();
+  if (dir() == nullptr || frame < first || frame >= first + count) {
+    return nullptr;
+  }
+  Slot* slot = nullptr;
+  for (auto& s : g_slots) {
+    if (!s.busy.load(std::memory_order_acquire)) {
+      slot = &s;

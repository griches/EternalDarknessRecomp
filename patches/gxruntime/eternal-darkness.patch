+bool flare(const float light[2], const float scene[4][4], float m[2][2], const void* user) {
+  const PhotoView& v = *static_cast<const PhotoView*>(user);
+  if (scene[0][0] == 0.f || scene[1][1] == 0.f)
+    return false;
+  const float d[4]{(light[0] + scene[0][2] - scene[0][3]) / scene[0][0],
+                   (light[1] + scene[1][2] - scene[1][3]) / scene[1][1], -1.f, 0.f};
+  float q[4][4];
+  projection(scene, q, user);
+  float c[4];
+  for (int i = 0; i < 4; ++i)
+    c[i] = q[i][0] * d[0] + q[i][1] * d[1] + q[i][2] * d[2] + q[i][3] * d[3];
+  if (c[3] <= 1e-4f)
+    return false;  // behind the camera
+  const float to[2]{c[0] / c[3], c[1] / c[3]};
+  if (std::fabs(to[0]) > 1.4f || std::fabs(to[1]) > 1.4f)
+    return false;  // well off the screen
+  const float a = v.aspect > 0.f ? v.aspect : 16.f / 9.f;
+  const float fx = light[0] * a, fy = light[1], tx = to[0] * a, ty = to[1];
+  const float from = std::sqrt(fx * fx + fy * fy);
+  if (from < 1e-3f) {
+    m[0][0] = m[1][1] = 1.f;
+    m[0][1] = m[1][0] = 0.f;
+    return true;
+  }
+  const float scale = std::sqrt(tx * tx + ty * ty) / from;
+  const float turn = std::atan2(ty, tx) - std::atan2(fy, fx);
+  const float r00 = scale * std::cos(turn), r01 = -scale * std::sin(turn), r10 = scale * std::sin(turn),

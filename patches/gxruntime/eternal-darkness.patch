+// Primitives whose triangles a joined draw can carry as another run: only
+// whole triangles, since a stray index would shift every run after it.
+bool joinable_primitive(std::uint32_t primitive, std::uint32_t vertex_count) {
+  switch (primitive & 0xF8u) {
+  case 0x80u:  // quads (a partial quad adds no indices)
+    return true;
+  case 0x90u:  // triangles
+    return vertex_count % 3u == 0u;
+  case 0x98u:  // strip
+  case 0xA0u:  // fan
+    return vertex_count >= 3u;
+  default:
+    return false;
+  }
+}

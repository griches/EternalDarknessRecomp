+            "r1=0x%08X r26=0x%08X r27=0x%08X r28=0x%08X r29=0x%08X r30=0x%08X "
+            "r31=0x%08X\n",
+            cpu->pc, cpu->lr, addr, size, (unsigned long long)value, cpu->gpr[1],
+            cpu->gpr[26], cpu->gpr[27], cpu->gpr[28], cpu->gpr[29], cpu->gpr[30],
+            cpu->gpr[31]);

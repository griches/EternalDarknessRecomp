+bool wanted() {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    const char* env = std::getenv("DOL_GX_THREAD");
+    if (env != nullptr && std::strcmp(env, "0") == 0)
+        return false;
+    // Trace recording interleaves FIFO records with the memory the decode
+    // resolves, which needs the decode inside the write.
+    return g_initialized && g_gx_core_enabled && g_shadow_frontend_enabled &&
+           !g_trace_armed;
+#else
+    return false;
+#endif
+}

+  static const float paper = [] {
+    const char* e = std::getenv("AURORA_HDR_PAPER_NITS");
+    return e != nullptr && std::atof(e) > 0 ? static_cast<float>(std::atof(e)) : 140.f;
+  }();
+  static const float scale = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_HDR_SCALE");
+    return e != nullptr && std::atof(e) > 0 ? static_cast<float>(std::atof(e)) : 1.f;
+  }();
+  const float e = static_cast<float>(code) / 1023.f;
+  const float p = std::pow(e, 1.f / 78.84375f);
+  const float y = std::pow(std::max(p - 0.8359375f, 0.f) / (18.8515625f - 18.6875f * p), 1.f / 0.1593017578125f);
+  const float v = std::min(y * 10000.f / paper / scale, 1.f);
+  const float s = v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(v, 1.f / 2.4f) - 0.055f;
+  return static_cast<uint8_t>(std::lround(s * 255.f));
+}
+
+// A 16-bit float (linear, extended) value as an 8-bit sRGB one, divided by
+// AURORA_FRAME_DUMP_HDR_SCALE (1) first to see what goes past white.
+uint8_t half_to_srgb8(const uint8_t* p) {
+  const uint16_t h = static_cast<uint16_t>(p[0] | (p[1] << 8));
+  const uint32_t sign = (h >> 15) & 1u, exp = (h >> 10) & 0x1fu, mant = h & 0x3ffu;
+  float v = exp == 0 ? std::ldexp(static_cast<float>(mant), -24)
+          : exp == 31 ? 65504.f
+                      : std::ldexp(static_cast<float>(mant | 0x400u), static_cast<int>(exp) - 25);
+  if (sign != 0)
+    v = 0.f;
+  static const float scale = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_HDR_SCALE");
+    return e != nullptr && std::atof(e) > 0 ? static_cast<float>(std::atof(e)) : 1.f;
+  }();
+  v = std::min(v / scale, 1.f);
+  const float s = v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(v, 1.f / 2.4f) - 0.055f;
+  return static_cast<uint8_t>(std::lround(s * 255.f));
+}
+uint32_t g_frame = 0;
+
+void write_ppm(std::string path, std::vector<uint8_t> rgb, uint32_t w, uint32_t h) {
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+    std::fwrite(rgb.data(), 1, rgb.size(), f);
+    std::fclose(f);
+  }
+}
+
+// After the frame's passes: copy the surface texture for a later map.
+Slot* copy(wgpu::CommandEncoder& encoder, const wgpu::Texture& texture) {
+  const uint32_t frame = g_frame++;
+  static const uint32_t first = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_FIRST");
+    return e != nullptr ? static_cast<uint32_t>(std::atoi(e)) : 0u;
+  }();
+  static const uint32_t count = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_COUNT");
+    return e != nullptr ? static_cast<uint32_t>(std::atoi(e)) : 600u;
+  }();
+  // AURORA_FRAME_DUMP_STEP (1): every Nth frame of the range.
+  static const uint32_t step = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP_STEP");
+    return e != nullptr && std::atoi(e) > 0 ? static_cast<uint32_t>(std::atoi(e)) : 1u;
+  }();
+  if (dir() == nullptr || frame < first || frame >= first + count || (frame - first) % step != 0) {
+    return nullptr;
+  }
+  Slot* slot = nullptr;
+  for (auto& s : g_slots) {
+    if (!s.busy.load(std::memory_order_acquire)) {
+      slot = &s;
+      break;
+    }
+  }
+  if (slot == nullptr) {
+    std::fprintf(stderr, "[frame-dump] frame %u skipped (readbacks busy)\n", frame);
+    return nullptr;
+  }
+  const uint32_t width = texture.GetWidth(), height = texture.GetHeight();
+  // An HDR surface is 16-bit float (8 bytes a pixel).
+  const bool half = texture.GetFormat() == wgpu::TextureFormat::RGBA16Float;
+  // The PS5's HDR10 surface: 10-bit PQ, four bytes a pixel.
+  const bool pq10 = texture.GetFormat() == wgpu::TextureFormat::RGB10A2Unorm;
+  const uint32_t bytesPerRow = (width * (half ? 8u : 4u) + 255u) & ~255u;
+  const uint64_t size = static_cast<uint64_t>(bytesPerRow) * height;
+  if (!slot->buffer || slot->size != size) {
+    const wgpu::BufferDescriptor desc{
+        .label = "Frame dump buffer",
+        .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+        .size = size,
+    };
+    slot->buffer = g_device.CreateBuffer(&desc);
+    slot->size = size;
+  }
+  const auto format = texture.GetFormat();
+  slot->bgra = format == wgpu::TextureFormat::BGRA8Unorm || format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  slot->half = half;
+  slot->pq10 = pq10;
+  slot->width = width;
+  slot->height = height;
+  slot->bytesPerRow = bytesPerRow;
+  slot->frame = frame;
+  slot->busy.store(true, std::memory_order_release);
+  const wgpu::TexelCopyTextureInfo src{.texture = texture};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = bytesPerRow, .rowsPerImage = height},
+      .buffer = slot->buffer,
+  };
+  const wgpu::Extent3D extent{.width = width, .height = height, .depthOrArrayLayers = 1};
+  encoder.CopyTextureToBuffer(&src, &dst, &extent);
+  return slot;
+}
+
+// After the submit: map, shrink, write on a thread of its own.
+void map(Slot* slot) {
+  if (slot == nullptr) {
+    return;
+  }
+  slot->buffer.MapAsync(
+      wgpu::MapMode::Read, 0, slot->size, wgpu::CallbackMode::AllowSpontaneous,
+      [slot](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        if (status == wgpu::MapAsyncStatus::Success) {
+          const auto* data = static_cast<const uint8_t*>(slot->buffer.GetConstMappedRange(0, slot->size));
+          static const uint32_t target = [] {
+            const char* e = std::getenv("AURORA_FRAME_DUMP_WIDTH");
+            return e != nullptr && std::atoi(e) > 0 ? static_cast<uint32_t>(std::atoi(e)) : 320u;
+          }();
+          const uint32_t step = std::max(1u, slot->width / target);
+          const uint32_t w = slot->width / step, h = slot->height / step;
+          std::vector<uint8_t> rgb(static_cast<size_t>(w) * h * 3u);
+          for (uint32_t y = 0; y < h; y++) {
+            const uint8_t* row = data + static_cast<size_t>(y) * step * slot->bytesPerRow;
+            for (uint32_t x = 0; x < w; x++) {
+              uint8_t* o = &rgb[(static_cast<size_t>(y) * w + x) * 3u];
+              if (slot->pq10) {
+                const uint8_t* p = row + static_cast<size_t>(x) * step * 4u;
+                const uint32_t v = static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+                                   (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
+                o[0] = pq10_to_srgb8(v & 1023u);
+                o[1] = pq10_to_srgb8((v >> 10) & 1023u);
+                o[2] = pq10_to_srgb8((v >> 20) & 1023u);
+                continue;
+              }
+              if (slot->half) {
+                const uint8_t* p = row + static_cast<size_t>(x) * step * 8u;
+                o[0] = half_to_srgb8(p);
+                o[1] = half_to_srgb8(p + 2);
+                o[2] = half_to_srgb8(p + 4);
+                continue;
+              }
+              const uint8_t* p = row + static_cast<size_t>(x) * step * 4u;
+              o[0] = slot->bgra ? p[2] : p[0];
+              o[1] = p[1];
+              o[2] = slot->bgra ? p[0] : p[2];
+            }
+          }
+          slot->buffer.Unmap();
+          char name[64];
+          std::snprintf(name, sizeof name, "/frame-%05u.ppm", slot->frame);
+          std::thread(write_ppm, std::string(dir()) + name, std::move(rgb), w, h).detach();
+        }
+        slot->busy.store(false, std::memory_order_release);
+      });
+}

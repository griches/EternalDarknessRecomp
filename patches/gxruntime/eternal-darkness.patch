+    if (!g_initialized || in == nullptr)
+        return;
+    AuroraQuickState s;
+    std::memcpy(&s, in, sizeof s);
+    if (s.has_render_mode != 0u) {
+        GXRenderModeObj mode{};
+        mode.viTVmode = static_cast<VITVMode>(s.tv_mode);
+        mode.fbWidth = s.fb_width;
+        mode.efbHeight = s.efb_height;
+        mode.xfbHeight = s.xfb_height;
+        mode.viWidth = s.vi_width;
+        mode.viHeight = s.vi_height;
+        aurora::vi::configure(&mode);
+    } else {
+        aurora::vi::configure(nullptr);
+    }
+    // VIFlush promotes the next buffer to current; replay that to set both.
+    VISetNextFrameBuffer(reinterpret_cast<void*>(
+        static_cast<uintptr_t>(s.current_xfb)));
+    VIFlush();
+    VISetNextFrameBuffer(reinterpret_cast<void*>(
+        static_cast<uintptr_t>(s.next_xfb)));
+    aurora::vi::set_xfb_black(s.xfb_black != 0u);
+}
+
+size_t dol_aurora_gx_state_save(void* out, size_t capacity) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (gxq::on_game_thread()) {
+        size_t size = 0;
+        gxq::call_sync([&] { size = dol_aurora_gx_state_save(out, capacity); });
+        return size;
+    }
+    if (!g_initialized || !g_shadow_frontend_enabled || g_shadow_frontend_failed)
+        return 0;
+    const std::vector<std::uint8_t> preamble = g_shadow_frontend.state_preamble();
+    if (out != nullptr && capacity >= preamble.size())
+        std::memcpy(out, preamble.data(), preamble.size());
+    return preamble.size();
+#else
+    (void)out;
+    (void)capacity;
+    return 0;
+#endif
+}
+
+bool dol_aurora_gx_state_load(const void* in, size_t size) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (gxq::on_game_thread()) {
+        bool ok = false;
+        gxq::call_sync([&] { ok = dol_aurora_gx_state_load(in, size); });
+        return ok;
+    }
+    // Textures in the replay resolve through the guest resolver; without it
+    // the replay would fail and leave the decoder off.
+    if (!g_initialized || !g_shadow_frontend_enabled || in == nullptr ||
+        size == 0u || g_guest_address_resolver == nullptr)
+        return false;
+    // Start the decoder over (this also clears a failed frontend): its
+    // registers and any half-planned draw belong to the abandoned timeline.
+    // The sink must restart with it, since packet numbering does.
+    aurora_backend_set_guest_address_resolver(g_guest_address_resolver,
+                                              g_guest_address_resolver_user);
+    if (g_gx_core_enabled)
+        g_core_sink.reset();
+    gxq::g_plan_attrs = {};
+    gxq::g_plan_zslope = {};
+    const std::span<const std::uint8_t> bytes(
+        static_cast<const std::uint8_t*>(in), size);
+    const bool ok =
+        g_gx_core_enabled
+            ? g_shadow_frontend.replay_fifo(bytes, &g_core_sink)
+            : g_shadow_frontend.replay_fifo(bytes, &g_shadow_packet_sink);
+    // A load inside a recording window: the replay above already recorded
+    // the memory it resolved; the trace restarts its decoder here too.
+    if (ok && trace_should_record())
+        g_trace_writer.gx_state(bytes.data(),
+                                static_cast<std::uint32_t>(bytes.size()));
+    if (!ok) {
+        g_shadow_frontend_failed = true;
+        std::fprintf(stderr,
+                     "[gx-core] saved GX state rejected: %s (opcode=0x%02X)\n",
+                     g_shadow_frontend.last_error() != nullptr
+                         ? g_shadow_frontend.last_error()
+                         : "none",
+                     static_cast<unsigned>(g_shadow_frontend.last_error_opcode()));
+    }
+    return ok;
+#else
+    (void)in;
+    (void)size;
+    return false;
+#endif
+}
+
+void dol_aurora_state_loaded(void) {
+    if (!g_initialized)
+        return;
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (gxq::on_game_thread()) {
+        gxq::call_sync([] { dol_aurora_state_loaded(); });
+        return;
+    }
+#endif
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    // EFB-copy and RAM-XFB textures are keyed by guest address alone; after a
+    // load those addresses hold other things.
+    if (g_gx_core_enabled)
+        aurora::gfx::gxcore::reset_texture_cache();
+#endif
+    if (g_audio_stream != nullptr)
+        SDL_ClearAudioStream(g_audio_stream);
+    // The guest initialised its pads long before any save point, and a state
+    // loaded straight after launch never calls PADInit again: without this
+    // the keyboard mapping is never installed and port 0 reports no
+    // controller, so the game ignores every key. Idempotent once initialised.
+    (void)aurora_backend_pad_init();
+    // Rumble started in the abandoned timeline would never be stopped.
+    std::lock_guard<std::mutex> input_lock(g_input_mutex);
+    for (u32 channel = 0; channel < PAD_CHANMAX; ++channel)
+        PADControlMotor(channel, PAD_MOTOR_STOP);
+}
+
+int dol_aurora_run_game(int (*game)(void*), void* arg) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (!gxq::wanted())
+        return game(arg);
+    gxq::GameRun run{game, arg, 0};
+    // The recompiled code nests host calls as deep as the guest's call
+    // chains; a secondary thread's default stack (512 KB on macOS) is far
+    // too small.
+    const SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetPointerProperty(props, SDL_PROP_THREAD_CREATE_ENTRY_FUNCTION_POINTER,
+                           reinterpret_cast<void*>(&gxq::game_thread_main));
+    SDL_SetStringProperty(props, SDL_PROP_THREAD_CREATE_NAME_STRING, "game");
+    SDL_SetPointerProperty(props, SDL_PROP_THREAD_CREATE_USERDATA_POINTER, &run);
+    SDL_SetNumberProperty(props, SDL_PROP_THREAD_CREATE_STACKSIZE_NUMBER,
+                          64ll * 1024 * 1024);
+    gxq::kRingSlots = gxq::ring_slots_for_cache();
+    if (const char* env = std::getenv("DOL_GX_RING_SLOTS"))
+        gxq::kRingSlots = std::clamp<std::uint64_t>(std::strtoull(env, nullptr, 10), 8u, 4096u);
+    std::fprintf(stderr, "[gx-thread] ring of %llu slots\n",
+                 static_cast<unsigned long long>(gxq::kRingSlots));
+    gxq::g_ring.reset(new gxq::RenderItem[gxq::kRingSlots]);
+    gxq::g_ring_head = 0;
+    gxq::g_ring_tail = 0;
+    gxq::g_plan_next = 0;
+    g_core_sink.set_defer_observer(gxq::defer_draw, nullptr);
+    g_core_sink.set_storage(gxq::reserve_draw, gxq::reserved_state, nullptr);
+    g_core_sink.set_copy_observer(gxq::defer_copy, nullptr);
+    // Join back-to-back draws of unchanged state at decode, up to this many
+    // vertices a ring slot (DOL_GX_JOIN_VERTS; 0 off): the nightmare's 15,000
+    // draws a frame change register state ~200 times.
+    {
+        std::uint32_t join = 2048u;
+        if (const char* env = std::getenv("DOL_GX_JOIN_VERTS"))
+            join = static_cast<std::uint32_t>(
+                std::min<unsigned long long>(std::strtoull(env, nullptr, 10), 0xFFFFu));
+        g_core_sink.set_draw_merge(join);
+    }
+    gxq::g_active = true;
+    // Plan workers: about half the hardware threads, less one (SMT siblings
+    // of busy threads plan slowly and slow those threads down): 3 on a
+    // 4-core/8-thread Steam Deck (60.0 fps against 59.0 with 2), 4 on the Mac
+    // and the Windows PC, where more gained nothing.
+    int workers = std::clamp(SDL_GetNumLogicalCPUCores() / 2 - 1, 1, 4);
+    if (const char* env = std::getenv("DOL_GX_PLAN_WORKERS"))
+        workers = std::clamp(std::atoi(env), 0, gxq::kMaxPlanWorkers);
+    gxq::g_workers_stop = false;
+    std::vector<SDL_Thread*> worker_threads;
+    for (int i = 0; i < workers; ++i) {
+        const SDL_PropertiesID wp = SDL_CreateProperties();
+        SDL_SetPointerProperty(wp, SDL_PROP_THREAD_CREATE_ENTRY_FUNCTION_POINTER,
+                               reinterpret_cast<void*>(&gxq::plan_worker_main));
+        SDL_SetStringProperty(wp, SDL_PROP_THREAD_CREATE_NAME_STRING, "gx-plan");
+        SDL_SetPointerProperty(wp, SDL_PROP_THREAD_CREATE_USERDATA_POINTER,
+                               &gxq::g_worker_counters[i]);
+        SDL_SetNumberProperty(wp, SDL_PROP_THREAD_CREATE_STACKSIZE_NUMBER,
+                              8ll * 1024 * 1024);
+        if (SDL_Thread* t = SDL_CreateThreadWithProperties(wp))
+            worker_threads.push_back(t);
+        SDL_DestroyProperties(wp);
+    }
+    gxq::g_worker_count = static_cast<int>(worker_threads.size());
+    const SDL_PropertiesID decode_props = SDL_CreateProperties();
+    SDL_SetPointerProperty(decode_props, SDL_PROP_THREAD_CREATE_ENTRY_FUNCTION_POINTER,
+                           reinterpret_cast<void*>(&gxq::decode_thread_main));
+    SDL_SetStringProperty(decode_props, SDL_PROP_THREAD_CREATE_NAME_STRING, "gx-decode");
+    SDL_SetNumberProperty(decode_props, SDL_PROP_THREAD_CREATE_STACKSIZE_NUMBER,
+                          16ll * 1024 * 1024);
+    SDL_Thread* decode = SDL_CreateThreadWithProperties(decode_props);
+    SDL_DestroyProperties(decode_props);
+    SDL_Thread* thread = decode != nullptr ? SDL_CreateThreadWithProperties(props) : nullptr;
+    SDL_DestroyProperties(props);
+    if (thread == nullptr) {
+        std::fprintf(stderr, "[gx-thread] could not start the game threads (%s)\n",
+                     SDL_GetError());
+        std::abort();
+    }
+    std::fprintf(stderr, "[gx-thread] game, GX decode, %d plan worker(s) and main "
+                         "(submit, present) on their own threads\n",
+                 gxq::g_worker_count);
+    gxq::run_main();
+    SDL_WaitThread(thread, nullptr);
+    SDL_WaitThread(decode, nullptr);
+    gxq::g_workers_stop = true;
+    {
+        std::lock_guard<std::mutex> lock(gxq::g_work_mutex);
+        gxq::g_cv_work.notify_all();
+    }
+    for (SDL_Thread* t : worker_threads)
+        SDL_WaitThread(t, nullptr);
+    gxq::g_active = false;
+    g_core_sink.set_defer_observer(nullptr, nullptr);
+    g_core_sink.set_storage(nullptr, nullptr, nullptr);
+    g_core_sink.set_draw_merge(0u);
+    g_core_sink.set_copy_observer(core_copy_observer, nullptr);
+    gxq::g_ring.reset();
+    return run.result;
+#else
+    return game(arg);
+#endif
+}
+
+void dol_aurora_note_retrace(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    // The game thread notices each retrace at its next block boundary, a
+    // little late by a varying amount; keep an even beat instead (the measured
+    // period, phase-locked to the retraces, re-synced after a gap).
+    static std::uint64_t last = 0;
+    static double period = 16'666'667.0;
+    static double beat = 0.0;
+    const std::uint64_t now = SDL_GetTicksNS();
+    if (last != 0u) {
+        const double d = static_cast<double>(now - last);
+        if (d > 12e6 && d < 22e6)
+            period += (d - period) * 0.02;
+    }
+    last = now;
+    const double since = static_cast<double>(now) - beat;
+    if (beat != 0.0 && since > period * 0.5 && since < period * 1.5) {
+        beat += period;
+        // Notices are only ever late: follow the earliest of them (snap back
+        // when one is early, drift slowly later otherwise).
+        const double late = static_cast<double>(now) - beat;
+        beat += late < 0.0 ? late : late * 0.02;
+    } else {
+        beat = static_cast<double>(now);
+    }
+    gxq::g_last_retrace_ns.store(static_cast<std::uint64_t>(beat),
+                                 std::memory_order_relaxed);
+#endif
+}
+
+unsigned dol_aurora_gx_decode_errors(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    return g_core_decode_errors.load();
+#else
+    return 0u;
+#endif
+}
+
+bool dol_aurora_gx_threaded(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    return gxq::g_active;
+#else
+    return false;
+#endif
+}

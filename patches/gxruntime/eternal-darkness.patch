+    scratch->reset(&resolver);
+    scratch->set_packet_drain_enabled(true);
+    sink->set_guest_resolver(&scratch->state().resolver);
+    (void)scratch->replay_fifo(commands, sink.get());
+    g_trace_writer.gx_state(commands.data(),

@@ -16,5 +16,51 @@ const TextureHandle* lookup_xfb_texture(std::uint32_t physical_address) noexcept
 unsigned long long xfb_display_copy_count() noexcept;
 // Times present fell through to YUYV→RGBA RAM decode (no GPU copy hit).
 unsigned long long xfb_ram_present_count() noexcept;
+// The EFB as it was at the latest display copy, at render resolution. Null
+// before the first display copy. The EFB-direct present shows this, not the
+// live EFB, so passes after the copy cannot change what reaches the screen.
+const TextureHandle* last_display_copy() noexcept;
+// The latest display copy to the XFB at xfb (physical or cached address), else
+// last_display_copy(): what the VI shows when it points there.
+const TextureHandle* display_copy_for(uint32_t xfb) noexcept;
+// The game converts the display copy at xfb into a whole-frame RGB565 texture
+// at texture on the CPU: until that texture's memory changes, draws of it bind
+// the copy itself, at render resolution (main thread).
+void alias_xfb_texture(uint32_t xfb, uint32_t texture) noexcept;
+
+// The XFB in guest RAM (GXRuntime recomp patch). A GameCube display copy
+// writes the frame to RAM as YUYV, and some games read it back (Eternal
+// Darkness fades from it into the prologue's book; left unwritten, the zeros
+// read as green). Each display copy queues its own texture (the EFB
+// rectangle it copied) for the render worker to read back at the copy's size;
+// encoded, it waits for the next display copy to the same destination, which
+// writes it there. A game that copies to a buffer it does not show and reads
+// that back (Eternal Darkness's photo of Alex in the prologue's book) gets
+// what it copied there, not the frame on screen.
+struct XfbRamTarget {
+  uint32_t srcX = 0, srcY = 0, width = 0, height = 0;  // EFB rectangle
+  uint32_t xfbHeight = 0, stride = 0;                   // in RAM
+  unsigned long long copy = 0;  // which display copy noted it (age, DOL_XFB_LOG)
+  uint32_t dest = 0;            // the copy's destination (physical)
+  bool operator==(const XfbRamTarget& o) const {
+    return srcX == o.srcX && srcY == o.srcY && width == o.width && height == o.height &&
+           xfbHeight == o.xfbHeight && stride == o.stride;
+  }
+};
+struct XfbRamRequest {
+  TextureHandle texture;  // the copy's own texture, at render resolution
+  XfbRamTarget target;
+};
+// The display copies made since the last call (the render worker's frame).
+std::vector<XfbRamRequest> take_xfb_ram_requests() noexcept;
+// Before the game reads a display copy back on the CPU: the newest copy to
+// dest the stream has reached (main thread, in stream order), then waiting up
+// to timeout_ms for that copy's readback and writing it to RAM. The wait
+// returns the milliseconds it took, or -1 when the readback did not come.
+unsigned long long xfb_ram_latest_copy(uint32_t dest) noexcept;
+int xfb_ram_wait_write(uint32_t dest, unsigned long long copy, unsigned timeout_ms) noexcept;
+// rgba: the copy's rectangle scaled to width x height, rows bytesPerRow
+// apart, BGRA when bgra.
+void xfb_ram_store(const uint8_t* rgba, uint32_t bytesPerRow, bool bgra, const XfbRamTarget& target) noexcept;
 
 } // namespace aurora::gfx::gxcore

+  if (row < 0.004 || column < 0.004) {
+    return vec4f(0.0, 0.0, 0.0, 1.0);
+  }
+  let a = textureSampleLevel(finished, samp, in.uv, 0.0).rgb;
+  let b = textureSampleLevel(scene, samp, in.uv, 0.0).rgb;
+  let d = max(abs(a.r - b.r), max(abs(a.g - b.g), abs(a.b - b.b)));
+  let la = dot(a, vec3f(0.299, 0.587, 0.114));
+  let lb = dot(b, vec3f(0.299, 0.587, 0.114));
+  let shows = select(clamp(la / max(lb, 1e-3), 0.0, 1.0), 0.0, la > lb + 0.01);
+  let m = mix(1.0, shows, smoothstep(0.02, 0.08, d));
+  return vec4f(m, m, m, 1.0);
+}
+)";

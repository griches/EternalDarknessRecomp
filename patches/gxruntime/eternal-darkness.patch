+// C2: route nonzero gxcore GapCounters into the structured report. Mirrors
+// dolgx_replay_core.cpp print_gap_counters (full residual taxonomy, including
+// U1/U2 counters the replay table historically omitted). Counter value IS the
+// fire-count — gap_report_add adds that many occurrences in one call.
+static void flush_gxcore_gap_counters() {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (!g_gx_core_enabled)
+        return;
+    // The sink's counts, plus the planning done by the GX threads.
+    gxruntime::gxcore::GapCounters c = g_core_sink.counters();
+    c += gxq::g_plan_counters;
+    for (const auto& worker : gxq::g_worker_counters)
+        c += worker;
+    struct {
+        const char* name;
+        unsigned long long value;
+    } gaps[] = {
+        {"missing_vcd", c.missing_vcd},
+        {"vertex_decode_failures", c.vertex_decode_failures},
+        {"unsupported_texgen", c.unsupported_texgen},
+        {"per_vertex_tex_mtx", c.per_vertex_tex_mtx},
+        {"unresolved_tex_matrix", c.unresolved_tex_matrix},
+        {"normals_ignored", c.normals_ignored},
+        {"lighting_ignored", c.lighting_ignored},
+        {"tlut_texture", c.tlut_texture},
+        {"alpha_compare_ignored", c.alpha_compare_ignored},
+        {"tev_stages_over", c.tev_stages_over},
+        {"tev_multi_texmap", c.tev_multi_texmap},
+        {"efb_copy_ignored", c.efb_copy_ignored},
+        {"fog_ignored", c.fog_ignored},
+        {"indirect_ignored", c.indirect_ignored},
+        {"logic_op_ignored", c.logic_op_ignored},
+        {"postmtx_ignored", c.postmtx_ignored},
+        {"sampler_defaulted", c.sampler_defaulted},
+        {"scissor_defaulted", c.scissor_defaulted},
+        {"scissor_multi_rect", c.scissor_multi_rect},
+    };
+    for (const auto& gap : gaps) {
+        if (gap.value != 0)
+            gap_report_add("gxcore", gap.name, "", 0, "gxcore GapCounter",
+                           gap.value);
+    }
+    if (c.draws_skipped != 0)
+        gap_report_add("gxcore", "draws_skipped", "", 0, "plan.ok == false",
+                       c.draws_skipped);
+    if (g_core_rejected != 0)
+        gap_report_add("gxcore", "submit_rejected", "", 0,
+                       "draw rejected by the gxcore consumer", g_core_rejected);
+#else
+    (void)0;
+#endif
+}

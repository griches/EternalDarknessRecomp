+// Replace a texture's decoded texels (the game's button icons, say): claims
+// is asked by GX format and size, generation changes force a re-decode, and
+// apply returns malloc'd RGBA8 of any size (freed by the backend).
+typedef struct DolAuroraTextureOverride {
+    bool (*claims)(uint32_t format, uint32_t width, uint32_t height);
+    bool (*apply)(const uint8_t* rgba, uint32_t width, uint32_t height,
+                  uint8_t** out_rgba, uint32_t* out_width, uint32_t* out_height);
+    uint64_t (*generation)(void);
+} DolAuroraTextureOverride;
+void dol_aurora_set_texture_override(const DolAuroraTextureOverride* ops);
+
+// Controller vibration (the game's rumble) on or off.
+void dol_aurora_set_vibration(bool on);
+// Display aspect: 0 follows the game (4:3, or 16:9 when its 3D projects at
+// 16:9), 1 = 4:3, 2 = 16:9, 3 = stretch to the window.
+void dol_aurora_set_aspect_mode(int mode);
+// Render resolution: 0 = the window's pixels, N = N x the GameCube EFB.
+void dol_aurora_set_render_scale(int scale);
+void dol_aurora_set_fullscreen(bool fullscreen);
+// The window's (and on macOS the Dock's) icon, from RGBA8 pixels.
+void dol_aurora_set_window_icon(const uint8_t* rgba, uint32_t width, uint32_t height);
+// Widescreen HUD: move a squeezed 4:3 HUD's corner elements to the edges.
+void dol_aurora_set_widescreen_hud(bool edges);
+// Audio queued ahead of the output before playback starts (latency vs. gaps).
+void dol_aurora_set_audio_buffer_ms(int ms);
+// The display aspect in use (4:3, 16:9, or the window's for stretch) and the
+// window's size in pixels, for showing what a resolution choice means.
+void dol_aurora_get_display_info(float* aspect, uint32_t* window_width,
+                                 uint32_t* window_height);

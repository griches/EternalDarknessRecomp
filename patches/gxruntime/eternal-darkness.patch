+#if GXRUNTIME_HAS_AURORA_RECOMP
+// --- GX thread ------------------------------------------------------------------
+// Three threads (dol_aurora_run_game): the game; a decode thread that runs
+// the GX frontend over the game's recorded GX calls; and the main thread,
+// which keeps the window and Aurora and builds and submits each draw. The
+// game's calls are queued here in chunks, the decode thread's output in the
+// render ring below. The game may run at most one frame ahead, as with the
+// GameCube's own GPU (which this game keeps a frame behind anyway).
+// DOL_GX_THREAD=0 keeps one thread.
+namespace gxq {
+
+enum class Op : std::uint8_t {
+    GxBytes,          // a run of FIFO writes, big-endian as written
+    CallDisplayList,  // a copy of the list's bytes
+    SetArray,
+    CopyDest,
+    ConfigureVi,
+    SetNextXfb,
+    FlushXfb,
+    SetXfbBlack,
+    Present,
+    Call,             // run a function on the main thread (quick states)
+};
+
+struct Header {
+    Op op;
+    std::uint8_t pad[3];
+    std::uint32_t size;  // payload bytes after the header
+};
+struct SetArrayArgs {
+    const void* data;
+    u32 attr;
+    u32 guest;
+    u32 size;
+    u8 stride;
+};
+struct CopyDestArgs {
+    const void* data;
+    u32 guest;
+};
+struct ViArgs {
+    u32 tv_mode;
+    u16 fb_width, efb_height, xfb_height, vi_width, vi_height;
+};
+
+// Chunks are handed over when they pass this size (so the main thread starts
+// on a frame early) and at every present; a backlog past the limit holds the
+// game until the main thread catches up.
+constexpr std::size_t kChunkBytes = 64u * 1024u;
+constexpr std::size_t kMaxChunks = 256u;
+constexpr std::size_t kNoRecord = ~std::size_t{0};
+
+thread_local bool t_game_thread = false;
+bool g_active = false;  // the game thread is running
+
+std::mutex g_mutex;
+std::condition_variable g_cv_main;  // chunks ready, game finished
+std::condition_variable g_cv_game;  // present or call done, chunk room
+std::deque<std::vector<std::uint8_t>> g_ready;
+std::vector<std::vector<std::uint8_t>> g_free;
+bool g_game_done = false;
+std::uint64_t g_presents_done = 0;
+std::uint64_t g_calls_done = 0;
+
+// Game thread only.
+std::vector<std::uint8_t> g_open;
+std::size_t g_open_gx = kNoRecord;  // offset of the open GxBytes record
+std::uint64_t g_presents_queued = 0;
+std::uint64_t g_calls_queued = 0;
+
+void (*g_frame_hook)(void) = nullptr;
+std::atomic<std::uint64_t> g_wait_ns{0};  // game thread waiting at presents
+std::uint64_t g_idle_ns = 0;               // main thread waiting for the game
+
+bool on_game_thread() { return t_game_thread; }
+
+// The GX threads are the frame's critical path: ask for full-speed cores.
+// macOS and Windows 11 otherwise treat a new thread as background work, run
+// it on efficiency cores and throttle it (EcoQoS), which on the Windows PC
+// made every stage two to three times slower. DOL_GX_THREAD_PRIORITY=0 skips it.
+void use_performance_cores() {
+    static const bool skip = [] {
+        const char* env = std::getenv("DOL_GX_THREAD_PRIORITY");
+        return env != nullptr && std::strcmp(env, "0") == 0;
+    }();
+    if (skip)
+        return;
+#ifdef __APPLE__
+    // Raises the QoS class, which keeps it off the efficiency cores.
+    SDL_SetCurrentThreadPriority(SDL_THREAD_PRIORITY_HIGH);
+#endif
+#ifdef _WIN32
+    // A higher priority made the PC slower (spinning workers then crowd out
+    // the decode and render threads); only opt out of power throttling.
+    THREAD_POWER_THROTTLING_STATE state{};
+    state.Version = THREAD_POWER_THROTTLING_CURRENT_VERSION;
+    state.ControlMask = THREAD_POWER_THROTTLING_EXECUTION_SPEED;
+    state.StateMask = 0;  // opted out: never throttled
+    SetThreadInformation(GetCurrentThread(), ThreadPowerThrottling, &state,
+                         sizeof state);
+#endif
+}
+
+void close_gx() {
+    if (g_open_gx == kNoRecord)
+        return;
+    const auto size =
+        static_cast<std::uint32_t>(g_open.size() - g_open_gx - sizeof(Header));
+    std::memcpy(g_open.data() + g_open_gx + offsetof(Header, size), &size,
+                sizeof size);
+    g_open_gx = kNoRecord;
+}
+
+void publish() {
+    close_gx();
+    if (g_open.empty())
+        return;
+    std::vector<std::uint8_t> next;
+    {
+        std::unique_lock<std::mutex> lock(g_mutex);
+        g_cv_game.wait(lock, [] {
+            return g_ready.size() < kMaxChunks || g_should_quit.load();
+        });
+        g_ready.push_back(std::move(g_open));
+        if (!g_free.empty()) {
+            next = std::move(g_free.back());
+            g_free.pop_back();
+        }
+    }
+    g_cv_main.notify_one();
+    g_open = std::move(next);
+    g_open.clear();
+    if (g_open.capacity() < kChunkBytes + 1024u)
+        g_open.reserve(kChunkBytes + 1024u);
+}
+
+void append(Op op, const void* payload, std::uint32_t size) {
+    close_gx();
+    const Header header{op, {}, size};
+    const auto* h = reinterpret_cast<const std::uint8_t*>(&header);
+    g_open.insert(g_open.end(), h, h + sizeof header);
+    if (size != 0u) {
+        const auto* p = static_cast<const std::uint8_t*>(payload);
+        g_open.insert(g_open.end(), p, p + size);
+    }
+    if (g_open.size() >= kChunkBytes)
+        publish();
+}
+
+void append_gx(u64 value, u8 size) {
+    if (g_open_gx == kNoRecord) {
+        g_open_gx = g_open.size();
+        const Header header{Op::GxBytes, {}, 0u};
+        const auto* h = reinterpret_cast<const std::uint8_t*>(&header);
+        g_open.insert(g_open.end(), h, h + sizeof header);
+    }
+    for (unsigned i = 0; i < size; ++i)
+        g_open.push_back(static_cast<std::uint8_t>(value >> ((size - 1u - i) * 8u)));
+    if (g_open.size() >= kChunkBytes)
+        publish();
+}
+
+// Run fn on the main thread once everything queued before it has been
+// replayed, and wait for it: the main thread is idle until the game queues
+// more, so the caller may also read GX state afterwards.
+void call_sync(const std::function<void()>& fn) {
+    const std::function<void()>* p = &fn;
+    append(Op::Call, &p, sizeof p);
+    const std::uint64_t id = ++g_calls_queued;
+    publish();
+    std::unique_lock<std::mutex> lock(g_mutex);
+    g_cv_game.wait(lock, [id] { return g_calls_done >= id; });
+}
+
+void present() {
+    const std::uint64_t n = ++g_presents_queued;
+    append(Op::Present, &n, sizeof n);
+    publish();
+    const std::uint64_t t0 = SDL_GetTicksNS();
+    {
+        std::unique_lock<std::mutex> lock(g_mutex);
+        g_cv_game.wait(lock, [n] {
+            return g_presents_done + 1u >= n || g_should_quit.load();
+        });
+    }
+    g_wait_ns += SDL_GetTicksNS() - t0;
+}
+
+template <typename T>
+T read_args(const std::uint8_t* p) {
+    T value;
+    std::memcpy(&value, p, sizeof value);
+    return value;
+}
+
+// --- Decode -> main: the render ring --------------------------------------------
+// The decode thread turns the queued GX stream into draws (each with the
+// register state it needs) and the Aurora calls between them, in order, into
+// reusable slots; the main thread builds each draw's plan, submits it and
+// makes the calls. A full ring holds the decode thread back.
+enum class Item : std::uint8_t {
+    Draw,
+    EfbCopy,
+    SetArray,
+    CopyDest,
+    ConfigureVi,
+    SetNextXfb,
+    FlushXfb,
+    SetXfbBlack,
+    Present,
+    Call,
+    Done,
+};
+
+struct RenderItem {
+    Item kind = Item::Done;
+    gxruntime::gxcore::GxCoreState state;
+    gxruntime::aurora_recomp::ConsumedDraw draw;
+    gxruntime::gxcore::EfbCopyCommand copy{};
+    SetArrayArgs set_array{};
+    CopyDestArgs copy_dest{};
+    ViArgs vi{};
+    u32 value = 0;
+    bool flag = false;
+    std::uint64_t n = 0;
+    const std::function<void()>* fn = nullptr;
+    // Draws are planned by whichever thread claims the slot first (a plan
+    // worker, or the main thread when it gets there first); 2 = done.
+    gxruntime::gxcore::DrawPlan plan;
+    std::atomic<int> plan_state{0};
+};
+
+// Each slot is ~14 KB and the decode thread writes every slot it fills, so a
+// ring that outgrows the cache turns those writes into misses
+// (DOL_GX_RING_SLOTS to experiment).
+std::uint64_t kRingSlots = 64u;
+std::unique_ptr<RenderItem[]> g_ring;
+// Each on its own cache line: the decode thread writes the tail per draw
+// while the others poll, and sharing a line would stall those writes.
+alignas(64) std::atomic<std::uint64_t> g_ring_head{0};  // next slot main reads
+alignas(64) std::atomic<std::uint64_t> g_ring_tail{0};  // next slot decode fills
+alignas(64) std::atomic<bool> g_main_waiting{false};
+alignas(64) std::atomic<bool> g_decode_waiting{false};
+std::mutex g_ring_mutex;
+std::condition_variable g_cv_ring_main;
+std::condition_variable g_cv_ring_decode;
+
+// The main thread's plan stage, in stream order.
+gxruntime::gxcore::GapCounters g_plan_counters{};
+gxruntime::gxcore::CachedVertexAttrs g_plan_attrs{};
+gxruntime::gxcore::CachedZSlope g_plan_zslope{};
+std::uint64_t g_calls_forwarded = 0;  // decode thread
+std::atomic<std::uint64_t> g_decode_full_ns{0};  // decode waiting on a full ring
+
+// Plan workers: build draw plans ahead of the main thread, in parallel, each
+// leaving what the cross-draw caches need for the main thread to finish in
+// stream order. DOL_GX_PLAN_WORKERS sets how many (0: the main thread plans).
+constexpr int kMaxPlanWorkers = 8;
+alignas(64) std::atomic<std::uint64_t> g_plan_next{0};  // next slot unclaimed
+alignas(64) std::atomic<bool> g_workers_stop{false};
+alignas(64) std::atomic<int> g_workers_sleeping{0};
+std::mutex g_work_mutex;
+std::condition_variable g_cv_work;
+int g_worker_count = 0;
+gxruntime::gxcore::GapCounters g_worker_counters[kMaxPlanWorkers];
+std::atomic<std::uint64_t> g_worker_plan_ns{0};
+std::uint64_t g_plan_wait_ns = 0;  // main waiting for a worker's plan
+std::uint64_t g_present_ns = 0;    // main in present (Aurora frame end/begin)
+
+// Spin briefly for `ready` before a thread falls back to sleeping: handing
+// over thousands of draws a frame, a sleep and wake-up per draw costs more
+// than the work.
+inline void cpu_relax() {
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__)
+    __builtin_ia32_pause();
+#elif defined(__aarch64__)
+    __asm__ __volatile__("yield");
+#endif
+}
+
+// How long a waiting GX thread spins before sleeping (DOL_GX_SPIN_US, in
+// microseconds; the spin is scaled per waiter below).
+std::uint64_t spin_ns(std::uint64_t scale) {
+    static const std::uint64_t base = [] {
+        const char* env = std::getenv("DOL_GX_SPIN_US");
+        return env != nullptr ? std::strtoull(env, nullptr, 10) * 1000u : 10'000u;
+    }();
+    return base * scale;
+}
+
+template <typename Ready>
+bool spin_for(Ready ready, std::uint64_t ns) {
+    const std::uint64_t until = SDL_GetTicksNS() + ns;
+    for (unsigned i = 0;; ++i) {
+        if (ready())
+            return true;
+        cpu_relax();
+        if ((i & 63u) == 63u) {
+            if (SDL_GetTicksNS() >= until)
+                return false;
+            std::this_thread::yield();
+        }
+    }
+}
+
+// Decode thread: the next free slot (waits while the ring is full).
+RenderItem& ring_begin() {
+    const std::uint64_t tail = g_ring_tail.load(std::memory_order_relaxed);
+    if (tail - g_ring_head.load() >= kRingSlots) {
+        const std::uint64_t t0 = SDL_GetTicksNS();
+        if (spin_for([tail] { return tail - g_ring_head.load() < kRingSlots; }, spin_ns(2))) {
+            g_decode_full_ns += SDL_GetTicksNS() - t0;
+            return g_ring[tail % kRingSlots];
+        }
+        std::unique_lock<std::mutex> lock(g_ring_mutex);
+        g_decode_waiting.store(true);
+        while (tail - g_ring_head.load() >= kRingSlots)
+            g_cv_ring_decode.wait_for(lock, std::chrono::milliseconds(2));
+        g_decode_waiting.store(false);
+        g_decode_full_ns += SDL_GetTicksNS() - t0;
+    }
+    return g_ring[tail % kRingSlots];
+}
+
+void ring_commit() {
+    g_ring_tail.store(g_ring_tail.load(std::memory_order_relaxed) + 1u);
+    if (g_main_waiting.load()) {
+        std::lock_guard<std::mutex> lock(g_ring_mutex);
+        g_cv_ring_main.notify_one();
+    }
+    // An awake worker picks the slot up (and wakes another for a backlog);
+    // only when all sleep does one need waking.
+    if (g_worker_count > 0 && g_workers_sleeping.load() == g_worker_count) {
+        std::lock_guard<std::mutex> lock(g_work_mutex);
+        g_cv_work.notify_one();
+    }
+}
+
+// Claim slot `seq` for planning; false when another thread already has it.
+bool claim(std::uint64_t seq) {
+    std::uint64_t expected = seq;
+    return g_plan_next.load() == seq &&
+           g_plan_next.compare_exchange_strong(expected, seq + 1u);
+}
+
+void plan_draw(RenderItem& item, gxruntime::gxcore::GapCounters& counters) {
+    item.state.build_draw_plan_into(item.plan, item.draw, counters, nullptr,
+                                    nullptr, /*record_cross=*/true);
+    gxruntime::gxcore::DrawPlan& plan = item.plan;
+    if (plan.ok) {
+        // The cached N/B/T are still zero here; finish_plan mixes them in.
+        plan.constants_hash = gxruntime::gxcore::hash_bytes(&plan.constants,
+                                                            sizeof plan.constants);
+        plan.pixel_constants_hash = gxruntime::gxcore::hash_bytes(
+            &plan.pixel_constants, sizeof plan.pixel_constants);
+        plan.pipeline_hash =
+            gxruntime::gxcore::hash_bytes(&plan.pipeline, sizeof plan.pipeline);
+    }
+}
+
+// The fingerprint below hashes the three cached-attribute rows as one block.
+static_assert(offsetof(gxruntime::gxcore::VertexShaderConstants, cached_tangent) ==
+                  offsetof(gxruntime::gxcore::VertexShaderConstants, cached_normal) + 16 &&
+              offsetof(gxruntime::gxcore::VertexShaderConstants, cached_binormal) ==
+                  offsetof(gxruntime::gxcore::VertexShaderConstants, cached_normal) + 32);
+
+// Main thread, in stream order: the cross-draw caches, then the fingerprints
+// of whatever they changed.
+void finish_plan(gxruntime::gxcore::DrawPlan& plan) {
+    gxruntime::gxcore::finish_cross_draw(plan, g_plan_attrs, g_plan_zslope,
+                                         g_plan_counters);
+    if (!plan.ok || plan.constants_hash == 0u)
+        return;
+    if (plan.cross.recorded)
+        plan.constants_hash = gxruntime::gxcore::hash_bytes(
+            plan.constants.cached_normal,
+            sizeof plan.constants.cached_normal + sizeof plan.constants.cached_tangent +
+                sizeof plan.constants.cached_binormal,
+            plan.constants_hash);
+    if (plan.cross.zslope_needed) {
+        plan.pixel_constants_hash = gxruntime::gxcore::hash_bytes(
+            &plan.pixel_constants, sizeof plan.pixel_constants);
+        plan.pipeline_hash =
+            gxruntime::gxcore::hash_bytes(&plan.pipeline, sizeof plan.pipeline);
+    }
+}
+
+// Plan worker: claim the next unplanned slot and plan it if it is a draw.
+int SDLCALL plan_worker_main(void* user) {
+    use_performance_cores();
+    auto& counters = *static_cast<gxruntime::gxcore::GapCounters*>(user);
+    while (!g_workers_stop.load()) {
+        const std::uint64_t seq = g_plan_next.load();
+        if (seq < g_ring_tail.load()) {
+            if (!claim(seq))
+                continue;
+            if (g_ring_tail.load() - seq > 1u && g_workers_sleeping.load() > 0) {
+                std::lock_guard<std::mutex> lock(g_work_mutex);
+                g_cv_work.notify_one();
+            }
+            RenderItem& item = g_ring[seq % kRingSlots];
+            if (item.kind == Item::Draw && !g_should_quit.load()) {
+                const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                plan_draw(item, counters);
+                if (g_gx_time_log)
+                    g_worker_plan_ns += SDL_GetTicksNS() - t0;
+            }
+            item.plan_state.store(2, std::memory_order_release);
+            continue;
+        }
+        if (spin_for([] { return g_plan_next.load() < g_ring_tail.load() ||
+                                g_workers_stop.load(); },
+                     spin_ns(1)))
+            continue;
+        std::unique_lock<std::mutex> lock(g_work_mutex);
+        ++g_workers_sleeping;
+        if (g_plan_next.load() >= g_ring_tail.load() && !g_workers_stop.load())
+            g_cv_work.wait_for(lock, std::chrono::milliseconds(2));
+        --g_workers_sleeping;
+    }
+    return 0;
+}
+
+// Decode thread: the slot the sink is building the current draw in, until
+// the draw is complete and committed (defer_draw).
+RenderItem* g_reserved = nullptr;
+
+RenderItem& ring_item(Item kind) {
+    // Anything queued after a draw follows it: complete and commit the draw
+    // first (its spans are all in by the time the game makes another call).
+    if (g_reserved != nullptr)
+        g_core_sink.flush_frame();
+    RenderItem& item = ring_begin();
+    item.kind = kind;
+    item.plan_state.store(0, std::memory_order_relaxed);
+    return item;
+}
+
+// Main thread: the next filled slot, pumping window events while it waits.
+RenderItem& ring_next() {
+    const std::uint64_t head = g_ring_head.load(std::memory_order_relaxed);
+    if (g_ring_tail.load() == head) {
+        const std::uint64_t t0 = SDL_GetTicksNS();
+        if (spin_for([head] { return g_ring_tail.load() != head; }, spin_ns(2))) {
+            g_idle_ns += SDL_GetTicksNS() - t0;
+            return g_ring[head % kRingSlots];
+        }
+        std::unique_lock<std::mutex> lock(g_ring_mutex);
+        g_main_waiting.store(true);
+        while (g_ring_tail.load() == head) {
+            g_cv_ring_main.wait_for(lock, std::chrono::milliseconds(4));
+            if (g_ring_tail.load() == head) {
+                // Loading or waiting on the disc: keep the window alive.
+                lock.unlock();
+                dol_aurora_pump_events_if_idle();
+                lock.lock();
+            }
+        }
+        g_main_waiting.store(false);
+        g_idle_ns += SDL_GetTicksNS() - t0;
+    }
+    return g_ring[head % kRingSlots];
+}
+
+void ring_release() {
+    g_ring_head.store(g_ring_head.load(std::memory_order_relaxed) + 1u);
+    if (g_decode_waiting.load()) {
+        std::lock_guard<std::mutex> lock(g_ring_mutex);
+        g_cv_ring_decode.notify_one();
+    }
+}
+
+// GxCoreSink storage and observers on the decode thread: each draw and its
+// register state are built straight into a ring slot, committed once the
+// draw is complete; EFB copies follow in order.
+gxruntime::aurora_recomp::ConsumedDraw* reserve_draw(void*) {
+    RenderItem& item = ring_begin();
+    item.kind = Item::Draw;
+    item.plan_state.store(0, std::memory_order_relaxed);
+    g_reserved = &item;
+    return &item.draw;
+}
+
+gxruntime::gxcore::GxCoreState* reserved_state(void*) {
+    return &g_reserved->state;
+}
+
+void defer_draw(const gxruntime::gxcore::GxCoreState&,
+                const gxruntime::aurora_recomp::ConsumedDraw&, void*) {
+    g_reserved = nullptr;
+    ring_commit();
+}
+
+void defer_copy(const gxruntime::gxcore::EfbCopyCommand& cmd, void*) {
+    ring_item(Item::EfbCopy).copy = cmd;
+    ring_commit();
+}
+
+// Decode thread: one chunk of the game's GX calls.
+void replay(const std::vector<std::uint8_t>& chunk) {
+    std::size_t at = 0;
+    while (at + sizeof(Header) <= chunk.size()) {
+        const Header h = read_args<Header>(chunk.data() + at);
+        const std::uint8_t* p = chunk.data() + at + sizeof(Header);
+        at += sizeof(Header) + h.size;
+        // Once quitting, only what the game thread waits on still runs.
+        const bool live = !g_should_quit.load();
+        switch (h.op) {
+        case Op::GxBytes:
+            if (live) {
+                g_fifo_bytes += h.size;
+                if (g_shadow_frontend_enabled && !g_shadow_frontend_failed) {
+                    const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                    shadow_frontend_core_write(std::span<const std::uint8_t>(p, h.size));
+                    if (g_gx_time_log)
+                        g_gx_time_ns += SDL_GetTicksNS() - t0;
+                }
+            }
+            break;
+        case Op::CallDisplayList:
+            if (live) {
+                const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                aurora_backend_call_display_list(p, h.size);
+                if (g_gx_time_log)
+                    g_gx_time_ns += SDL_GetTicksNS() - t0;
+            }
+            break;
+        case Op::SetArray: {
+            const auto a = read_args<SetArrayArgs>(p);
+            if (live && g_initialized && a.data != nullptr) {
+                // The frontend's copy here; Aurora's own GX state on main.
+                if (a.guest != 0u)
+                    shadow_frontend_set_array(a.attr, a.guest, a.stride);
+                ring_item(Item::SetArray).set_array = a;
+                ring_commit();
+            }
+            break;
+        }
+        case Op::CopyDest:
+            if (live) {
+                ring_item(Item::CopyDest).copy_dest = read_args<CopyDestArgs>(p);
+                ring_commit();
+            }
+            break;
+        case Op::ConfigureVi:
+            ring_item(Item::ConfigureVi).vi = read_args<ViArgs>(p);
+            ring_commit();
+            break;
+        case Op::SetNextXfb:
+            ring_item(Item::SetNextXfb).value = read_args<u32>(p);
+            ring_commit();
+            break;
+        case Op::FlushXfb:
+            ring_item(Item::FlushXfb);
+            ring_commit();
+            break;
+        case Op::SetXfbBlack:
+            ring_item(Item::SetXfbBlack).flag = read_args<bool>(p);
+            ring_commit();
+            break;
+        case Op::Present:
+            // The frame's last draw is planned at the frame boundary.
+            if (live && !g_shadow_frontend_failed)
+                g_core_sink.flush_frame();
+            ring_item(Item::Present).n = read_args<std::uint64_t>(p);
+            ring_commit();
+            break;
+        case Op::Call: {
+            // Runs on the main thread while this thread waits, so it may
+            // touch the frontend as well as Aurora.
+            ring_item(Item::Call).fn = read_args<const std::function<void()>*>(p);
+            ring_commit();
+            const std::uint64_t id = ++g_calls_forwarded;
+            std::unique_lock<std::mutex> lock(g_mutex);
+            g_cv_game.wait(lock, [id] { return g_calls_done >= id; });
+            break;
+        }
+        }
+    }
+}
+
+// Decode thread: replay the game's chunks until it has finished.
+int SDLCALL decode_thread_main(void*) {
+    use_performance_cores();
+    for (;;) {
+        std::vector<std::uint8_t> chunk;
+        {
+            std::unique_lock<std::mutex> lock(g_mutex);
+            g_cv_main.wait(lock, [] { return !g_ready.empty() || g_game_done; });
+            if (g_ready.empty())
+                break;
+            chunk = std::move(g_ready.front());
+            g_ready.pop_front();
+        }
+        g_cv_game.notify_all();
+        replay(chunk);
+        chunk.clear();
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_free.push_back(std::move(chunk));
+    }
+    ring_item(Item::Done);
+    ring_commit();
+    return 0;
+}
+
+// Main thread: plan, submit and present until the decode thread is done.
+void run_main() {
+    for (;;) {
+        RenderItem& item = ring_next();
+        const bool live = !g_should_quit.load();
+        // Plan the draw here unless a worker got to it first; then wait for
+        // the worker before the slot is reused.
+        const std::uint64_t seq = g_ring_head.load(std::memory_order_relaxed);
+        const bool mine = claim(seq);
+        if (mine) {
+            if (item.kind == Item::Draw && live) {
+                const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                plan_draw(item, g_plan_counters);
+                if (g_gx_time_log)
+                    gxruntime::gxcore::g_plan_time_ns += SDL_GetTicksNS() - t0;
+            }
+        } else if (item.plan_state.load(std::memory_order_acquire) != 2) {
+            const std::uint64_t t0 = SDL_GetTicksNS();
+            while (item.plan_state.load(std::memory_order_acquire) != 2)
+                std::this_thread::yield();
+            g_plan_wait_ns += SDL_GetTicksNS() - t0;
+        }
+        switch (item.kind) {
+        case Item::Draw:
+            if (live) {
+                finish_plan(item.plan);
+                core_plan_observer(item.plan, nullptr);
+            }
+            break;
+        case Item::EfbCopy:
+            if (live)
+                aurora::gfx::gxcore::copy_efb_to_texture(item.copy);
+            break;
+        case Item::SetArray:
+            if (live)
+                GXSetArray(static_cast<GXAttr>(item.set_array.attr), item.set_array.data,
+                           item.set_array.size, item.set_array.stride, false);
+            break;
+        case Item::CopyDest:
+            if (live)
+                aurora_backend_set_copy_destination_guest(item.copy_dest.guest,
+                                                          item.copy_dest.data);
+            break;
+        case Item::ConfigureVi:
+            aurora_backend_configure_vi(item.vi.tv_mode, item.vi.fb_width,
+                                        item.vi.efb_height, item.vi.xfb_height,
+                                        item.vi.vi_width, item.vi.vi_height);
+            break;
+        case Item::SetNextXfb:
+            aurora_backend_set_next_xfb(item.value);
+            break;
+        case Item::FlushXfb:
+            aurora_backend_flush_xfb();
+            break;
+        case Item::SetXfbBlack:
+            aurora_backend_set_xfb_black(item.flag);
+            break;
+        case Item::Present:
+            if (live) {
+                const std::uint64_t t0 = SDL_GetTicksNS();
+                aurora_backend_present();
+                g_present_ns = SDL_GetTicksNS() - t0;
+                if (g_frame_hook != nullptr)
+                    g_frame_hook();
+            }
+            {
+                std::lock_guard<std::mutex> lock(g_mutex);
+                g_presents_done = item.n;
+            }
+            g_cv_game.notify_all();
+            break;
+        case Item::Call:
+            (*item.fn)();
+            {
+                std::lock_guard<std::mutex> lock(g_mutex);
+                ++g_calls_done;
+            }
+            g_cv_game.notify_all();
+            break;
+        case Item::Done:
+            ring_release();
+            return;
+        }
+        ring_release();
+    }
+}
+
+struct GameRun {
+    int (*fn)(void*);
+    void* arg;
+    int result;
+};
+
+int SDLCALL game_thread_main(void* user) {
+    auto* run = static_cast<GameRun*>(user);
+    t_game_thread = true;
+    use_performance_cores();
+    run->result = run->fn(run->arg);
+    publish();
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_game_done = true;
+    }
+    g_cv_main.notify_all();
+    t_game_thread = false;
+    return 0;
+}
+
+bool wanted() {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    const char* env = std::getenv("DOL_GX_THREAD");
+    if (env != nullptr && std::strcmp(env, "0") == 0)
+        return false;
+    // Trace recording interleaves FIFO records with the memory the decode
+    // resolves, which needs the decode inside the write.
+    return g_initialized && g_gx_core_enabled && g_shadow_frontend_enabled &&
+           !g_trace_armed;
+#else
+    return false;
+#endif
+}
+
+// Platform ops: the game thread queues; anything else runs as before.
+bool should_quit_op() { return g_should_quit.load(); }
+
+void present_op() {
+    if (t_game_thread)
+        present();
+    else
+        aurora_backend_present();
+}
+
+void gx_write_op(u64 value, u8 size) {
+    if (!t_game_thread) {
+        aurora_backend_gx_write(value, size);
+        return;
+    }
+    if (size == 1u || size == 2u || size == 4u || size == 8u)
+        append_gx(value, size);
+}
+
+void call_display_list_op(const void* data, u32 size) {
+    if (t_game_thread)
+        append(Op::CallDisplayList, data, size);
+    else
+        aurora_backend_call_display_list(data, size);
+}
+
+void set_array_guest_op(u32 attr, u32 guest_address, const void* data, u32 size,
+                        u8 stride) {
+    if (!t_game_thread) {
+        aurora_backend_set_array_guest(attr, guest_address, data, size, stride);
+        return;
+    }
+    const SetArrayArgs a{data, attr, guest_address, size, stride};
+    append(Op::SetArray, &a, sizeof a);
+}
+
+void set_array_op(u32 attr, const void* data, u32 size, u8 stride) {
+    set_array_guest_op(attr, 0u, data, size, stride);
+}
+

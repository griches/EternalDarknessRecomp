+  const wgpu::BlendState blend{
+      .color = {.operation = wgpu::BlendOperation::Add,
+                .srcFactor = screen ? wgpu::BlendFactor::OneMinusDst : wgpu::BlendFactor::One,
+                .dstFactor = wgpu::BlendFactor::One},
+      .alpha = {.operation = wgpu::BlendOperation::Add,
+                .srcFactor = wgpu::BlendFactor::Zero,
+                .dstFactor = wgpu::BlendFactor::One},
+  };
+  const wgpu::ColorTargetState target{
+      .format = format,
+      .blend = add ? &blend : nullptr,
+      .writeMask = rgbOnly ? wgpu::ColorWriteMask::Red | wgpu::ColorWriteMask::Green | wgpu::ColorWriteMask::Blue
+                           : wgpu::ColorWriteMask::All,
+  };
+  const wgpu::FragmentState fragment{
+      .module = g_module,
+      .entryPoint = entry,
+      .targetCount = 1,
+      .targets = &target,
+  };
+  const wgpu::RenderPipelineDescriptor desc{
+      .label = "Glow",
+      .layout = g_pipelineLayout,
+      .vertex = {.module = g_module, .entryPoint = "vs"},
+      .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
+      .fragment = &fragment,

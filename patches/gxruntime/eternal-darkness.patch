+  out.push_back(DOL_GX_CMD_LOAD_BP_REG);
+  put_be32(out, (static_cast<std::uint32_t>(reg) << 24u) | (value & 0x00FFFFFFu));
+}
+
+struct XfWord {
+  std::uint16_t address;
+  std::uint32_t value;
+};
+
+std::uint32_t f32_bits(float value) {
+  std::uint32_t bits = 0;
+  std::memcpy(&bits, &value, sizeof bits);
+  return bits;
+}
+
+// Contiguous words become one XF load each, at most 16 words long (the parser
+// keeps the count in a byte).
+void emit_xf(std::vector<std::uint8_t>& out, const std::vector<XfWord>& words) {
+  std::size_t i = 0;
+  while (i < words.size()) {
+    std::size_t n = 1;
+    while (i + n < words.size() && n < 16u &&
+           words[i + n].address == words[i].address + n)
+      ++n;
+    out.push_back(DOL_GX_CMD_LOAD_XF_REG);
+    put_be32(out, (static_cast<std::uint32_t>(n - 1u) << 16u) |
+                      words[i].address);
+    for (std::size_t k = 0; k < n; ++k)
+      put_be32(out, words[i + k].value);
+    i += n;
+  }
+}
+
+// BP writes that do work rather than set state (Dolphin's FifoPlayer skips
+// the same): draw done, tokens, EFB copy, bbox and perf clears, TMEM preload,
+// TLUT load (repeated separately), texture invalidate, and the BP mask.
+bool bp_is_trigger(std::uint32_t reg) {
+  switch (reg) {
+  case 0x45u: case 0x47u: case 0x48u: case 0x52u: case 0x55u: case 0x56u:
+  case 0x57u: case 0x63u: case 0x65u: case 0x66u: case 0x67u: case 0xFEu:
+    return true;
+  default:
+    return false;
+  }
+}
+
+} // namespace
+
+std::vector<std::uint8_t> RetailGxFrontend::state_preamble() const {
+  const DolGxRecompState& s = state_;
+  std::vector<std::uint8_t> out;
+  out.reserve(16384u);
+
+  // CP: arrays, vertex formats and descriptor (each rederives the layouts).
+  for (std::uint32_t a = 0; a < DOL_GX_RECOMP_CP_ARRAY_COUNT; ++a) {
+    if (s.arrays[a].base_valid)
+      emit_cp(out, static_cast<std::uint8_t>(DOL_GX_CP_REG_ARRAYBASE + a),
+              s.arrays[a].physical_base);
+    if (s.arrays[a].stride_valid)
+      emit_cp(out, static_cast<std::uint8_t>(DOL_GX_CP_REG_ARRAYSTRIDE + a),
+              s.arrays[a].stride);
+  }
+  for (std::uint32_t f = 0; f < DOL_GX_RECOMP_VERTEX_FORMATS; ++f) {
+    if (s.vat_group0_valid[f])
+      emit_cp(out, static_cast<std::uint8_t>(DOL_GX_CP_REG_VAT_GRP0 + f),
+              s.vat_group0[f]);
+    if (s.vat_group1_valid[f])
+      emit_cp(out, static_cast<std::uint8_t>(DOL_GX_CP_REG_VAT_GRP1 + f),
+              s.vat_group1[f]);
+    if (s.vat_group2_valid[f])
+      emit_cp(out, static_cast<std::uint8_t>(DOL_GX_CP_REG_VAT_GRP2 + f),
+              s.vat_group2[f]);
+  }
+  if (s.vcd_lo_valid)
+    emit_cp(out, DOL_GX_CP_REG_VCD_LO, s.vcd_lo);
+  if (s.vcd_hi_valid)
+    emit_cp(out, DOL_GX_CP_REG_VCD_HI, s.vcd_hi);
+  emit_cp(out, DOL_GX_CP_REG_MATRIX_INDEX_A, s.matrix_index_a);
+
+  // XF: every word the frontend captured, in address order.
+  std::vector<XfWord> xf;
+  for (std::uint32_t m = 0; m < DOL_GX_RECOMP_POSITION_MATRIX_COUNT; ++m)
+    for (std::uint32_t w = 0; w < DOL_GX_RECOMP_POSITION_MATRIX_WORDS; ++w)
+      if (s.position_matrix_word_mask[m] & (1u << w))
+        xf.push_back({static_cast<std::uint16_t>(
+                          m * DOL_GX_RECOMP_POSITION_MATRIX_WORDS + w),
+                      f32_bits(s.position_matrices[m][w])});
+  for (std::uint32_t m = 0; m < DOL_GX_RECOMP_TEX_MATRIX_COUNT; ++m)
+    for (std::uint32_t w = 0; w < DOL_GX_RECOMP_TEX_MATRIX_WORDS; ++w)
+      if (s.tex_matrix_word_mask[m] & (1u << w))
+        xf.push_back({static_cast<std::uint16_t>(
+                          DOL_GX_XF_TEX_MATRIX_BASE +
+                          m * DOL_GX_RECOMP_TEX_MATRIX_WORDS + w),
+                      f32_bits(s.tex_matrices[m][w])});
+  for (std::uint32_t m = 0; m < DOL_GX_RECOMP_NORMAL_MATRIX_COUNT; ++m)
+    for (std::uint32_t w = 0; w < DOL_GX_RECOMP_NORMAL_MATRIX_WORDS; ++w) {
+      const std::uint32_t address = DOL_GX_XF_NORMAL_MATRIX_BASE +
+                                    m * DOL_GX_RECOMP_NORMAL_MATRIX_WORDS + w;
+      if ((s.normal_matrix_word_mask[m] & (1u << w)) &&
+          address < DOL_GX_XF_NORMAL_MATRIX_END)
+        xf.push_back({static_cast<std::uint16_t>(address),
+                      f32_bits(s.normal_matrices[m][w])});
+    }
+  for (std::uint32_t r = 0; r < DOL_GX_RECOMP_POST_MATRIX_ROWS; ++r)
+    for (std::uint32_t w = 0; w < DOL_GX_RECOMP_POST_MATRIX_WORDS; ++w)
+      if (s.post_matrix_word_mask[r] & (1u << w))
+        xf.push_back({static_cast<std::uint16_t>(
+                          DOL_GX_XF_POST_MATRIX_BASE +
+                          r * DOL_GX_RECOMP_POST_MATRIX_WORDS + w),
+                      f32_bits(s.post_matrices[r][w])});
+  for (std::uint32_t l = 0; l < DOL_GX_RECOMP_LIGHT_COUNT; ++l)
+    for (std::uint32_t w = 0; w < DOL_GX_RECOMP_LIGHT_WORDS; ++w)
+      if (s.light_word_mask[l] & (1u << w))
+        xf.push_back({static_cast<std::uint16_t>(
+                          DOL_GX_XF_LIGHT_BASE + l * DOL_GX_RECOMP_LIGHT_WORDS + w),
+                      s.light_words[l][w]});
+  for (std::uint32_t i = 0; i < DOL_GX_RECOMP_CHAN_REG_COUNT; ++i)
+    if (s.chan_reg_mask & (1u << i))
+      xf.push_back({static_cast<std::uint16_t>(DOL_GX_XF_CHAN_REG_BASE + i),
+                    s.chan_regs[i]});
+  if (s.dualtex_valid)
+    xf.push_back({DOL_GX_XF_DUALTEX, s.dualtex_info});
+  for (std::uint32_t i = 0; i < DOL_GX_RECOMP_XF_REG_COUNT; ++i)
+    if (s.xf_reg_mask & (1ull << i))
+      xf.push_back({static_cast<std::uint16_t>(DOL_GX_XF_REG_WINDOW_BASE + i),
+                    s.xf_regs[i]});
+  emit_xf(out, xf);
+
+  // BP, in register order, except that each texmap's TLUT register goes
+  // before the texture registers: a texture picks up its palette when its
+  // image registers are written, from the TLUT loads (0x64) and TLUT register.
+  auto is_texmap_tlut = [](std::uint32_t reg) {
+    return (reg >= DOL_GX_BP_REG_TX_SETTLUT && reg < DOL_GX_BP_REG_TX_SETTLUT + 4u) ||
+           (reg >= DOL_GX_BP_REG_TX_SETTLUT_4 &&
+            reg < DOL_GX_BP_REG_TX_SETTLUT_4 + 4u);
+  };
+  for (std::uint32_t reg = 0; reg < 256u; ++reg) {
+    if (reg == 0x80u) {
+      for (std::uint32_t t = 0x80u; t < 0xC0u; ++t)
+        if (is_texmap_tlut(t) && s.bp_valid[t])
+          emit_bp(out, static_cast<std::uint8_t>(t), s.bp_regs[t]);
+    }
+    if (is_texmap_tlut(reg))
+      continue;
+    if (reg == DOL_GX_BP_REG_LOAD_TLUT0) {
+      for (std::uint32_t off = 0; off < DOL_GX_RECOMP_TMEM_TLUT_SLOTS; ++off) {
+        const DolGxRecompTlut& t = s.tmem_tluts[off];
+        if (!t.valid || t.entries < 16u)
+          continue;
+        emit_bp(out, DOL_GX_BP_REG_LOAD_TLUT0, t.physical_base >> 5u);
+        emit_bp(out, DOL_GX_BP_REG_LOAD_TLUT1,
+                off | ((static_cast<std::uint32_t>(t.entries) / 16u) << 10u));
+      }
+      if (s.bp_valid[reg])
+        emit_bp(out, static_cast<std::uint8_t>(reg), s.bp_regs[reg]);
+      continue;
+    }
+    if (!s.bp_valid[reg] || bp_is_trigger(reg))
+      continue;
+    if (reg >= 0xE0u && reg <= 0xE7u) {
+      // The pair's other half first, so the last write wins as it did.
+      const std::uint32_t last = (s.bp_regs[reg] >> 23u) & 1u;
+      if (tev_reg_seen_[last ^ 1u][reg - 0xE0u])
+        emit_bp(out, static_cast<std::uint8_t>(reg),
+                tev_reg_words_[last ^ 1u][reg - 0xE0u]);
+    }
+    emit_bp(out, static_cast<std::uint8_t>(reg), s.bp_regs[reg]);
+  }
+  return out;
+}

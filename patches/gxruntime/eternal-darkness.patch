+
+// --- Frame rate: frames in between ---------------------------------------------
+// GXRuntime recomp patch. The game steps its world once per VI retrace (60
+// times a second). A faster screen (120 Hz, 144, the Steam Deck OLED's 90)
+// gets frames in between: Aurora draws the newest game frame again with each
+// draw's matrices blended from the frame before (aurora/lib/gfx/interp.hpp).
+// Each screen refresh shows the moment it stands for, so motion is even at
+// any rate; the cost is up to one more game frame between the game and the
+// screen. dol_aurora_set_frame_rate: 60 = off (the game's own rate, as
+// before), anything else = the screen's rate. DOL_INTERP_LOG=1: once a second,
+// the rates and how the frames matched.
+namespace frame_rate {
+std::atomic<int> g_setting{60};
+bool g_vsync = true;            // presents wait for the screen (else nothing to measure)
+std::atomic<bool> g_probe{true}; // measure the screen at the next game frame
+SDL_DisplayID g_display = 0;
+std::uint64_t g_last_t_game = 0;
+double g_game_period = 1e9 / 60.0;  // ns between game frames, smoothed
+double g_phase = 0.0;  // the next screen refresh, in game frames after the previous one
+std::atomic<bool> g_active{false};
+
+// The screen's refresh period in ns: Aurora's measurement once it has one
+// (snapped to the nearest common rate within 4%: presents are timed by the
+// compositor, a little off the screen's own refresh), else SDL's. On a Mac,
+// SDL's: a ProMotion screen follows the app's presents (90 to 120 Hz measured
+// from one run to the next), and shows any rate up to its own evenly.
+double screen_period() {
+    SDL_Window* window = aurora::window::get_sdl_window();
+    const SDL_DisplayID display = window != nullptr ? SDL_GetDisplayForWindow(window) : 0;
+    const SDL_DisplayMode* mode = display != 0 ? SDL_GetCurrentDisplayMode(display) : nullptr;
+    const double reported = mode != nullptr && mode->refresh_rate > 1.f ? 1e9 / mode->refresh_rate : 0.0;
+#ifdef __APPLE__
+    if (reported > 0.0)
+        return reported;
+#endif
+    if (const std::int64_t measured = aurora_get_refresh_period_ns(); measured > 0) {
+        static constexpr double kRates[] = {50.0,  59.94, 60.0,  72.0,  75.0,   90.0,  100.0, 119.88,
+                                            120.0, 143.86, 144.0, 165.0, 175.0, 240.0};
+        double best = static_cast<double>(measured);
+        double best_error = 0.04;
+        for (const double hz : kRates) {
+            const double error = std::fabs(1e9 / hz - measured) / measured;
+            if (error < best_error) {
+                best_error = error;
+                best = 1e9 / hz;
+            }
+        }
+        return best;
+    }
+    return reported > 0.0 ? reported : 1e9 / 60.0;
+}
+
+// SteamOS's compositor (the Steam Deck's Gaming Mode) sets the refresh rate
+// itself (Steam's Performance menu); the game only follows it.
+bool under_gamescope() {
+    return std::getenv("GAMESCOPE_WAYLAND_DISPLAY") != nullptr || std::getenv("SteamDeck") != nullptr;
+}
+
+// The refresh rates (Hz) the window's display offers at its desktop
+// resolution, from 75 up, while the window is fullscreen: a PC's choices,
+// switched to as an exclusive mode. None on a Mac (a ProMotion screen follows
+// the presents), on the PS5 or where SDL lists none.
+std::vector<int> display_rates() {
+    std::vector<int> rates;
+#if !defined(__APPLE__) && !defined(__PROSPERO__)
+    SDL_Window* window = aurora::window::get_sdl_window();
+    if (window == nullptr || (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) == 0 || under_gamescope())
+        return rates;
+    const SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+    const SDL_DisplayMode* desktop = display != 0 ? SDL_GetDesktopDisplayMode(display) : nullptr;
+    int count = 0;
+    SDL_DisplayMode** modes = display != 0 ? SDL_GetFullscreenDisplayModes(display, &count) : nullptr;
+    for (int i = 0; desktop != nullptr && modes != nullptr && i < count; ++i) {
+        const int hz = static_cast<int>(std::lround(modes[i]->refresh_rate));
+        if (modes[i]->w == desktop->w && modes[i]->h == desktop->h && hz >= 75 &&
+            std::find(rates.begin(), rates.end(), hz) == rates.end())
+            rates.push_back(hz);
+    }
+    SDL_free(modes);
+#endif
+    return rates;
+}
+
+// Main thread, when the setting or fullscreen changes: a fullscreen window
+// runs the display at the rate chosen when the display has it at the desktop's
+// resolution (an exclusive mode), else at the desktop's own mode as before.
+// The screen is measured again after either.
+void apply_mode(int setting) {
+#if !defined(__APPLE__) && !defined(__PROSPERO__)
+    SDL_Window* window = aurora::window::get_sdl_window();
+    if (window == nullptr || under_gamescope()) {
+        g_probe = true;
+        return;
+    }
+    const SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+    const SDL_DisplayMode* desktop = display != 0 ? SDL_GetDesktopDisplayMode(display) : nullptr;
+    const SDL_DisplayMode* current = SDL_GetWindowFullscreenMode(window);
+    SDL_DisplayMode wanted{};
+    const bool exclusive =
+        (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) != 0 && setting != 60 && desktop != nullptr &&
+        std::lround(desktop->refresh_rate) != setting &&
+        SDL_GetClosestFullscreenDisplayMode(display, desktop->w, desktop->h, static_cast<float>(setting), true,
+                                            &wanted) &&
+        std::lround(wanted.refresh_rate) == setting;
+    if (exclusive) {
+        if (current == nullptr || current->refresh_rate != wanted.refresh_rate) {
+            std::fprintf(stderr, "[display] fullscreen at %dx%d %.2f Hz\n", wanted.w, wanted.h, wanted.refresh_rate);
+            SDL_SetWindowFullscreenMode(window, &wanted);
+        }
+    } else if (current != nullptr) {
+        std::fprintf(stderr, "[display] fullscreen at the desktop's mode\n");
+        SDL_SetWindowFullscreenMode(window, nullptr);
+    }
+#else
+    (void)setting;
+#endif
+    g_probe = true;
+}
+
+// Main thread, before a game frame ends (t_game: the retrace that began it;
+// 0 for the launcher's frames, which are left alone): which screen refreshes
+// it covers, as phases between the previous game frame (0) and it (1).
+void before_end_frame(std::uint64_t t_game) {
+    const int setting = g_setting.load();
+    static int applied = -1;
+    static bool applied_fullscreen = false;
+    if (SDL_Window* window = aurora::window::get_sdl_window(); window != nullptr) {
+        const bool fullscreen = (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) != 0;
+        if (setting != applied || fullscreen != applied_fullscreen) {
+            applied = setting;
+            applied_fullscreen = fullscreen;
+            apply_mode(setting);
+        }
+    }
+    // Measure the screen at the start, and again when the window moves to
+    // another display (each measurement holds one frame for a dozen refreshes).
+    if (SDL_Window* window = aurora::window::get_sdl_window(); window != nullptr) {
+        const SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+        if (display != g_display) {
+            g_display = display;
+            g_probe = true;
+        }
+    }
+    if (g_vsync && g_probe.exchange(false))
+        aurora_request_refresh_probe();
+    if (t_game == 0u) {
+        aurora_set_present_spacing_ns(0);
+        return;
+    }
+    // The game's frame period, smoothed; loads and pauses are left out.
+    if (g_last_t_game != 0u && t_game > g_last_t_game) {
+        const double gap = static_cast<double>(t_game - g_last_t_game);
+        if (gap > 8e6 && gap < 40e6)
+            g_game_period += (gap - g_game_period) / 32.0;
+    }
+    g_last_t_game = t_game;
+
+    // Game frames per screen refresh, at the game's own 60 (its VI retrace):
+    // never the measured rate, which a slowed game would lower and so add
+    // frames in between that slow it further.
+    const double period = screen_period();
+    const double step = period / (1e9 / 60.0);
+    const bool want = setting != 60 && g_vsync && step > 0.1 && step < 0.8 &&
+                      !gxq::g_fast_forward.load(std::memory_order_relaxed);
+    aurora_interp_set_wanted(want);
+    aurora_set_present_spacing_ns(want ? static_cast<std::int64_t>(period) : 0);
+    static const bool log = std::getenv("DOL_INTERP_LOG") != nullptr;
+    static std::uint64_t log_start = 0;
+    static unsigned frames = 0, outputs = 0, results[4] = {}, catch_ups = 0;
+    static AuroraInterpStats last{};
+    if (!want) {
+        g_active = false;
+        return;
+    }
+    if (!g_active) {
+        g_active = true;
+        g_phase = step;
+    }
+    float phases[16];
+    std::uint32_t count = 0;
+    // The game waits at its present for this frame: the screen fell a frame
+    // behind (after the in-game menu, a stall), and showing every frame in
+    // between takes as long as the game's own frame, so it would never catch
+    // up and the game would sit at its presents for good (its audio thread
+    // starved: the last 5 ms of sound looped). This frame alone, then.
+    if (gxq::g_game_held.load(std::memory_order_relaxed)) {
+        phases[count++] = 1.f;
+        g_phase = step;
+        catch_ups++;
+    } else {
+        while (g_phase <= 1.0 + 1e-6 && count < 16u) {
+            phases[count++] = static_cast<float>(std::min(g_phase, 1.0));
+            g_phase += step;
+        }
+        g_phase = std::max(g_phase - 1.0, 0.0);
+    }
+    aurora_interp_set_phases(phases, count);
+    if (log) {
+        // The previous frame's match (this one's is built at its end).
+        aurora_get_interp_stats(&last);
+        ++frames;
+        outputs += count;
+        ++results[std::clamp(last.result, 0, 3)];
+        const std::uint64_t now = SDL_GetTicksNS();
+        if (log_start == 0u)
+            log_start = now;
+        if (now - log_start >= 1'000'000'000u) {
+            std::fprintf(stderr,
+                         "[interp] screen=%.2fHz game=%.2fHz shown=%u/%u frames blended=%u still=%u cut=%u "
+                         "none=%u caught_up=%u | last: draws=%u matched=%u loose=%u moved=%u jumped=%u\n",
+                         1e9 / period, 1e9 / g_game_period, outputs, frames, results[0], results[1], results[2],
+                         results[3], catch_ups, last.draws, last.matched, last.loose, last.moved, last.jumped);
+            log_start = now;
+            frames = outputs = catch_ups = 0;
+            std::fill(std::begin(results), std::end(results), 0u);
+        }
+    }
+}
+} // namespace frame_rate
+
+extern "C" {
+
+void aurora_backend_set_array_guest(u32 attr, u32 guest_address,

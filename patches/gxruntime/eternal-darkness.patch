+#pragma once
+
+// GXRuntime recomp patch: ambient occlusion from the depth buffer (SSAO).
+// Where the frame's 3D scene is finished (the same point as the glow's scene,
+// before the HUD), each pixel's view-space position is rebuilt from depth
+// with the scene's projection, a hemisphere of samples round it finds what
+// hides the sky, and the result, blurred within surfaces, darkens the EFB:
+// corners, under furniture, round feet. Half resolution. Strength 0 = off.
+
+#include "../webgpu/gpu.hpp"
+
+namespace aurora::gfx::ssao {
+
+// The scene's projection, as the last 3D draw had it: x = -vz * (ndc.x +
+// p02) / p00, y likewise with p11/p12, view z = b / (ndc.z - a) (ndc.z the
+// depth range's 0..1 after GX's remap), and its viewport (EFB pixels) and
+// depth range.
+struct Scene {
+  float p00 = 1, p02 = 0, p11 = 1, p12 = 0, a = 0, b = 0;
+  float left = 0, top = 0, width = 0, height = 0, minDepth = 0, maxDepth = 1;
+  bool valid = false;
+};
+
+float strength() noexcept;
+void set_strength(float strength) noexcept;
+
+// Darken the EFB (its MSAA view and resolve target as the pass had them) by
+// the occlusion its depth shows.
+// resolved: the EFB as a texture (its resolve target, or itself without MSAA),
+// read to spare bright pixels.
+void apply(const wgpu::CommandEncoder& cmd, const Scene& scene, const wgpu::TextureView& color,
+           const wgpu::TextureView& resolve, const wgpu::TextureView& depth, const wgpu::TextureView& resolved,
+           const wgpu::Extent3D& size, uint32_t msaaSamples);
+
+} // namespace aurora::gfx::ssao

+      .label = "Glow", .entryCount = entries.size(), .entries = entries.data()};
+  g_layout = g_device.CreateBindGroupLayout(&layoutDesc);
+  const wgpu::PipelineLayoutDescriptor pipelineLayoutDesc{
+      .label = "Glow", .bindGroupLayoutCount = 1, .bindGroupLayouts = &g_layout};
+  g_pipelineLayout = g_device.CreatePipelineLayout(&pipelineLayoutDesc);
+  const wgpu::SamplerDescriptor samplerDesc{
+      .label = "Glow",
+      .addressModeU = wgpu::AddressMode::ClampToEdge,
+      .addressModeV = wgpu::AddressMode::ClampToEdge,
+      .magFilter = wgpu::FilterMode::Linear,
+      .minFilter = wgpu::FilterMode::Linear,
+  };
+  g_sampler = g_device.CreateSampler(&samplerDesc);
+  const wgpu::BufferDescriptor bufferDesc{
+      .label = "Glow", .usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst, .size = 64};
+  g_uniform = g_device.CreateBuffer(&bufferDesc);
+  g_down = make_pipeline("down", kFormat, false, false);
+  g_up = make_pipeline("up", kFormat, true, false);
+  g_downAdd = make_pipeline("down", kFormat, true, false);
+  g_bright = make_pipeline("bright", kFormat, false, false);
+  g_copy = make_pipeline("show", kFormat, false, false);
+  g_cover = make_cover_pipeline();
+}
+
+wgpu::BindGroup source_group(const wgpu::TextureView& view, const char* label) {
+  const std::array entries{
+      wgpu::BindGroupEntry{.binding = 0, .textureView = view},
+      wgpu::BindGroupEntry{.binding = 1, .sampler = g_sampler},
+      wgpu::BindGroupEntry{.binding = 2, .buffer = g_uniform, .size = 64},
+  };
+  const wgpu::BindGroupDescriptor groupDesc{
+      .label = label, .layout = g_layout, .entryCount = entries.size(), .entries = entries.data()};
+  return g_device.CreateBindGroup(&groupDesc);
+}
+
+Level make_level(uint32_t width, uint32_t height, const char* label) {
+  const wgpu::TextureDescriptor desc{
+      .label = label,
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding,
+      .size = {width, height, 1},
+      .format = kFormat,
+  };
+  Level level;
+  level.texture = g_device.CreateTexture(&desc);
+  level.view = level.texture.CreateView();
+  level.source = source_group(level.view, label);
+  return level;
+}
+
+void make_targets(const wgpu::Extent3D& size, uint32_t samples) {
+  init_shared();
+  g_size = size;
+  g_samples = samples;
+  g_base = make_level(size.width, size.height, "Glow buffer");
+  g_ms = {};
+  g_msView = {};
+  if (samples > 1) {
+    const wgpu::TextureDescriptor desc{
+        .label = "Glow buffer (MSAA)",
+        .usage = wgpu::TextureUsage::RenderAttachment,
+        .size = {size.width, size.height, 1},
+        .format = kFormat,
+        .sampleCount = samples,
+    };
+    g_ms = g_device.CreateTexture(&desc);
+    g_msView = g_ms.CreateView();
+  }
+  g_levels.clear();
+  g_sharp = make_level((size.width + 1) / 2, (size.height + 1) / 2, "Glow highlights");
+  g_split = make_level((size.width + 1) / 2, (size.height + 1) / 2, "Glow scene copy");
+  g_splitTaken = false;
+  uint32_t w = size.width, h = size.height;
+  while (g_levels.size() < kMaxLevels && w >= 16 && h >= 16) {
+    w = (w + 1) / 2;
+    h = (h + 1) / 2;
+    g_levels.push_back(make_level(w, h, "Glow level"));
+  }
+  g_sceneTaken = false;
+  g_needClear = true;
+  g_drawn = false;
+}
+
+void ensure_emit_targets(const wgpu::Extent3D& size, uint32_t samples) {
+  if (g_eBase.texture && g_eSize.width == size.width && g_eSize.height == size.height && g_eSamples == samples)
+    return;
+  init_shared();
+  g_eSize = size;
+  g_eSamples = samples;
+  g_eBase = make_level(size.width, size.height, "Emit buffer");
+  g_eMs = {};
+  g_eMsView = {};
+  if (samples > 1) {
+    const wgpu::TextureDescriptor desc{
+        .label = "Emit buffer (MSAA)",
+        .usage = wgpu::TextureUsage::RenderAttachment,
+        .size = {size.width, size.height, 1},
+        .format = kFormat,
+        .sampleCount = samples,
+    };
+    g_eMs = g_device.CreateTexture(&desc);
+    g_eMsView = g_eMs.CreateView();
+  }
+  g_eLevels.clear();
+  uint32_t w = size.width, h = size.height;
+  while (g_eLevels.size() < kMaxLevels && w >= 16 && h >= 16) {
+    w = (w + 1) / 2;
+    h = (h + 1) / 2;
+    g_eLevels.push_back(make_level(w, h, "Emit level"));
+  }
+  g_eNeedClear = true;
+  g_eDrawn = false;
+}
+
+void ensure_targets(const wgpu::Extent3D& size, uint32_t samples) {
+  if (!g_base.texture || g_size.width != size.width || g_size.height != size.height || g_samples != samples)
+    make_targets(size, samples);
+}
+
+void draw(const wgpu::CommandEncoder& cmd, const wgpu::RenderPipeline& pipeline, const wgpu::BindGroup& source,
+          const wgpu::TextureView& target, bool load, const char* label) {
+  const wgpu::RenderPassColorAttachment attachment{
+      .view = target,
+      .loadOp = load ? wgpu::LoadOp::Load : wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+      .clearValue = {0.0, 0.0, 0.0, 0.0},
+  };
+  const wgpu::RenderPassDescriptor desc{
+      .label = label,
+      .colorAttachmentCount = 1,
+      .colorAttachments = &attachment,
+  };
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, source);
+  pass.Draw(3);
+  pass.End();
+}
+void write_params() {
+  // The emit chain is shown (HDR) only with the glow setting off: its strength.
+  const float glow = g_strength.load(std::memory_order_relaxed);
+  const float s = glow > 0.f ? glow : g_ePresent ? g_emitStrength.load(std::memory_order_relaxed) : 0.f;
+  // Video's white: the system's SDR white on EDR (1.0), BT.2408's 203 nits
+  // where the surface's light is absolute (HDR10, Windows' scRGB).
+  const float paper = g_paperNits.load(std::memory_order_relaxed);
+  const float videoWhite = webgpu::hdr_absolute() ? 203.f : 100.f;
+  const float value[16]{s, g_threshold, g_knee, g_scene,
+                        g_saturation, g_spread, g_cap, 0.f,
+                        g_uiPage ? 1.f : 0.f, g_hdrGain, std::min(paper, videoWhite),
+                        g_highlight.load(std::memory_order_relaxed),
+                        g_movie.load(std::memory_order_relaxed) ? std::min(paper, videoWhite) : paper,
+                        g_peakNits.load(std::memory_order_relaxed),
+                        g_blackLevel.load(std::memory_order_relaxed),
+                        static_cast<float>(g_pattern.load(std::memory_order_relaxed))};
+  static float s_written[16];
+  if (g_uniformWritten && std::memcmp(value, s_written, sizeof value) == 0)
+    return;
+  std::memcpy(s_written, value, sizeof value);
+  g_uniformWritten = true;
+  g_queue.WriteBuffer(g_uniform, 0, value, sizeof value);
+  g_uniformValue = s;
+}
+} // namespace
+
+float strength() noexcept { return g_strength.load(std::memory_order_relaxed); }
+
+bool active() noexcept { return strength() > 0.f || webgpu::g_hdrActive; }
+
+void set_hdr_levels(float paperNits, float peakNits, float black) noexcept {
+  if (!g_paperFromEnv)
+    g_paperNits.store(paperNits, std::memory_order_relaxed);
+  if (!g_peakFromEnv)
+    g_peakNits.store(std::max(peakNits, paperNits * 1.5f), std::memory_order_relaxed);
+  g_blackLevel.store(black, std::memory_order_relaxed);
+}
+
+void set_hdr_pattern(int pattern) noexcept { g_pattern.store(pattern, std::memory_order_relaxed); }
+
+void set_hdr_highlight(float gain) noexcept {
+  if (!g_highlightFromEnv)
+    g_highlight.store(gain, std::memory_order_relaxed);
+}
+
+void set_strength(float strength) noexcept {
+  if (!g_strengthFromEnv)
+    g_strength.store(strength, std::memory_order_relaxed);
+}
+
+Target begin_pass(const wgpu::Extent3D& size, uint32_t msaaSamples) {
+  ensure_targets(size, msaaSamples);
+  Target target{
+      .view = g_samples > 1 ? g_msView : g_base.view,
+      .resolveView = g_samples > 1 ? g_base.view : nullptr,
+      .clear = g_needClear,
+  };
+  g_needClear = false;
+  g_drawn = true;
+  return target;
+}
+
+Target begin_emit_pass(const wgpu::Extent3D& size, uint32_t msaaSamples) {
+  ensure_emit_targets(size, msaaSamples);
+  Target target{
+      .view = g_eSamples > 1 ? g_eMsView : g_eBase.view,
+      .resolveView = g_eSamples > 1 ? g_eBase.view : nullptr,
+      .clear = g_eNeedClear,
+  };
+  g_eNeedClear = false;
+  g_eDrawn = true;
+  return target;
+}
+
+void set_emit_strength(float strength) noexcept { g_emitStrength.store(strength, std::memory_order_relaxed); }
+
+void set_movie(bool playing) noexcept { g_movie.store(playing, std::memory_order_relaxed); }
+
+void take_scene(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& efb, const wgpu::Extent3D& size,
+                uint32_t msaaSamples) {
+  if (!active())
+    return;
+  ensure_targets(size, msaaSamples);
+  if (g_levels.empty())
+    return;
+  if (g_sceneView.Get() != efb.Get()) {
+    g_sceneView = efb;
+    g_sceneSource = source_group(efb, "Glow scene");
+  }
+  write_params();
+  // A later keep (3D drawn after a flat draw) replaces an earlier one.
+  draw(cmd, g_copy, g_sceneSource, g_split.view, false, "Glow scene copy");
+  g_splitTaken = true;
+  if (g_scene <= 0.f)
+    return;
+  draw(cmd, g_bright, g_sceneSource, g_levels[0].view, false, "Glow scene");
+  g_sceneTaken = true;
+}
+
+namespace {
+// Glow and highlights only where the scene still shows (kCoverShader).
+void cover(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& target, const char* label) {
+  const wgpu::RenderPassColorAttachment attachment{
+      .view = target, .loadOp = wgpu::LoadOp::Load, .storeOp = wgpu::StoreOp::Store};
+  const wgpu::RenderPassDescriptor desc{.label = label, .colorAttachmentCount = 1, .colorAttachments = &attachment};
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.SetPipeline(g_cover);
+  pass.SetBindGroup(0, g_finishedSource);
+  pass.SetBindGroup(1, g_split.source);
+  pass.Draw(3);
+  pass.End();
+}
+} // namespace
+
+void compose(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& dst, wgpu::TextureFormat format,
+             const wgpu::TextureView& efb) {
+  // What covered the scene since it was taken (a scene from this frame, the
+  // same size as the levels): no glow or highlights there.
+  const bool covered = g_splitTaken && efb && !g_levels.empty() &&
+                       g_split.texture.GetWidth() == g_levels[0].texture.GetWidth();
+  g_splitTaken = false;
+  if (covered && g_finishedView.Get() != efb.Get()) {
+    g_finishedView = efb;
+    g_finishedSource = source_group(efb, "Glow finished frame");
+  }
+  // The emit chain: blurred down and up as the glow is, for the HDR present.
+  g_ePresent = g_eDrawn && !g_eLevels.empty();
+  g_eDrawn = false;
+  g_eNeedClear = true;
+  if (g_ePresent) {
+    write_params();
+    const webgpu::gpu_prof::Zone zone{cmd, "Emit"};
+    // As the glow at Soft takes these surfaces: the scene's bright pass, here
+    // over their own pixels only.
+    draw(cmd, g_scene > 0.f ? g_bright : g_down, g_eBase.source, g_eLevels[0].view, false, "Emit bright");
+    for (size_t i = 1; i < g_eLevels.size(); ++i)
+      draw(cmd, g_down, g_eLevels[i - 1].source, g_eLevels[i].view, false, "Emit down");
+    for (size_t i = g_eLevels.size() - 1; i-- > 0;)
+      draw(cmd, g_up, g_eLevels[i + 1].source, g_eLevels[i].view, true, "Emit up");
+    if (covered && g_eLevels[0].texture.GetWidth() == g_split.texture.GetWidth())
+      cover(cmd, g_eLevels[0].view, "Emit cover");
+  }
+  // Nothing glows this frame (a menu, the quote screen): the present adds no
+  // glow, not the last 3D frame's left in level 0.
+  g_presentGlow = false;
+  if ((!g_drawn && !g_sceneTaken) || g_levels.empty())
+    return;
+  const bool drawn = g_drawn, scene = g_sceneTaken;
+  g_drawn = false;
+  g_sceneTaken = false;
+  g_needClear = true;
+  if (!active())
+    return;
+  write_params();
+  wgpu::RenderPipeline compose;
+  for (const auto& [f, p] : g_compose)
+    if (f == format)
+      compose = p;
+  if (!compose) {
+    compose = g_show ? make_pipeline("show", format, false, false) : make_pipeline("compose", format, true, true, /*screen=*/true);
+    g_compose.emplace_back(format, compose);
+  }
+  const webgpu::gpu_prof::Zone zone{cmd, "Glow"};
+  // The additive draws' glow joins the scene's in level 0.
+  if (drawn)
+    draw(cmd, scene ? g_downAdd : g_down, g_base.source, g_levels[0].view, scene, "Glow down");
+  // The highlights alone, before the wider levels are added in (HDR).
+  {
+    const wgpu::TexelCopyTextureInfo src{.texture = g_levels[0].texture};
+    const wgpu::TexelCopyTextureInfo dst{.texture = g_sharp.texture};
+    const wgpu::Extent3D extent{g_levels[0].texture.GetWidth(), g_levels[0].texture.GetHeight(), 1};
+    cmd.CopyTextureToTexture(&src, &dst, &extent);
+  }
+  for (size_t i = 1; i < g_levels.size(); ++i)
+    draw(cmd, g_down, g_levels[i - 1].source, g_levels[i].view, false, "Glow down");
+  for (size_t i = g_levels.size() - 1; i-- > 0;)
+    draw(cmd, g_up, g_levels[i + 1].source, g_levels[i].view, true, "Glow up");
+  if (covered) {
+    cover(cmd, g_levels[0].view, "Glow cover");
+    cover(cmd, g_sharp.view, "Highlights cover");
+  }
+  g_presentGlow = true;
+  // HDR: the present adds it, past white. Glow off: only HDR's highlights.
+  if ((webgpu::g_hdrActive && !g_show) || strength() <= 0.f)
+    return;
+  draw(cmd, compose, g_levels[0].source, dst, true, "Glow compose");
+}
+
+namespace {
+wgpu::RenderPipeline g_presentPipeline, g_overlayPipeline;
+wgpu::TextureFormat g_presentPipelineFormat = wgpu::TextureFormat::Undefined;
+Level g_black; // no glow (1x1, zeroed)
+
+wgpu::RenderPipeline make_present_pipeline(const wgpu::ShaderModule& module, const char* entry, bool overlay) {
+  const std::array layouts{webgpu::g_CopyBindGroupLayout, g_layout, g_layout};
+  const wgpu::PipelineLayoutDescriptor layoutDesc{
+      .label = "HDR present", .bindGroupLayoutCount = layouts.size(), .bindGroupLayouts = layouts.data()};
+  const auto layout = g_device.CreatePipelineLayout(&layoutDesc);
+  const wgpu::BlendState premultiplied{
+      .color = {.operation = wgpu::BlendOperation::Add,
+                .srcFactor = wgpu::BlendFactor::One,
+                .dstFactor = wgpu::BlendFactor::OneMinusSrcAlpha},
+      .alpha = {.operation = wgpu::BlendOperation::Add,
+                .srcFactor = wgpu::BlendFactor::One,
+                .dstFactor = wgpu::BlendFactor::OneMinusSrcAlpha},
+  };
+  const wgpu::ColorTargetState target{
+      .format = webgpu::g_presentFormat,
+      .blend = overlay ? &premultiplied : nullptr,
+  };
+  const wgpu::FragmentState fragment{.module = module, .entryPoint = entry, .targetCount = 1, .targets = &target};
+  const wgpu::RenderPipelineDescriptor desc{
+      .label = "HDR present",
+      .layout = layout,
+      .vertex = {.module = module, .entryPoint = "vs"},
+      .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
+      .fragment = &fragment,
+  };
+  return g_device.CreateRenderPipeline(&desc);
+}
+
+bool ready_present() {
+  init_shared();
+  if (!g_black.texture)
+    g_black = make_level(1, 1, "No glow");
+  if (g_presentPipelineFormat != webgpu::g_presentFormat) {
+    std::string code = kPresentShader;
+    if (webgpu::g_presentFormat == wgpu::TextureFormat::RGB10A2Unorm)
+      code.replace(code.find("const PQ_OUT: bool = false;"), 27, "const PQ_OUT: bool = true; ");
+    const std::string nits = "const LINEAR_NITS: f32 = " + std::to_string(webgpu::hdr_linear_nits()) + ";";
+    code.replace(code.find("const LINEAR_NITS: f32 = 100.0;"), 31, nits);
+    if (std::getenv("AURORA_HDR_SRGB_CURVE") != nullptr)
+      code.replace(code.find("const SRGB_CURVE: bool = false;"), 31, "const SRGB_CURVE: bool = true; ");
+    wgpu::ShaderSourceWGSL source{};
+    source.code = code.c_str();
+    const wgpu::ShaderModuleDescriptor moduleDesc{.nextInChain = &source, .label = "HDR present"};
+    const auto module = g_device.CreateShaderModule(&moduleDesc);
+    g_presentPipeline = make_present_pipeline(module, "present", false);
+    g_overlayPipeline = make_present_pipeline(module, "overlay", true);
+    g_presentPipelineFormat = webgpu::g_presentFormat;
+  }
+  write_params();
+  return g_presentPipeline != nullptr;
+}
+} // namespace
+
+bool present_hdr(const wgpu::RenderPassEncoder& pass, const wgpu::BindGroup& source, bool withGlow) {
+  // Before ready_present writes the parameters.
+  g_uiPage = !withGlow;
+  if (!ready_present())
+    return false;
+  withGlow = withGlow && !g_movie.load(std::memory_order_relaxed);
+  const bool scene = withGlow && g_presentGlow && !g_levels.empty();
+  const bool glow = scene && strength() > 0.f;
+  // With the glow setting off, the emit chain's glow in its place.
+  const bool emit = withGlow && !glow && g_ePresent && !g_eLevels.empty();
+  pass.SetPipeline(g_presentPipeline);
+  pass.SetBindGroup(0, source, 0, nullptr);
+  pass.SetBindGroup(1, glow ? g_levels[0].source : emit ? g_eLevels[0].source : g_black.source, 0, nullptr);
+  pass.SetBindGroup(2, scene ? g_sharp.source : g_black.source, 0, nullptr);
+  pass.Draw(3);
+  return true;
+}
+
+bool present_hdr_overlay(const wgpu::RenderPassEncoder& pass, const wgpu::BindGroup& source) {
+  if (!ready_present())
+    return false;
+  pass.SetPipeline(g_overlayPipeline);
+  pass.SetBindGroup(0, source, 0, nullptr);
+  pass.SetBindGroup(1, g_black.source, 0, nullptr);
+  pass.SetBindGroup(2, g_black.source, 0, nullptr);
+  pass.Draw(3);
+  return true;
+}
+
+} // namespace aurora::gfx::glow

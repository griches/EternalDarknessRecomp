+// Windows: the DXGI output showing the window (its monitor) is in HDR mode
+// (Settings > Display > Use HDR): its colour space is HDR10's. Asked again
+// only when the displays change (the factory is no longer current) or the
+// window moves to another monitor.
+static bool WindowsDisplayShowsHDR(SDL_Window* window) {
+  const HWND hwnd = static_cast<HWND>(
+      SDL_GetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr));
+  if (hwnd == nullptr)
+    return false;
+  const HMONITOR monitor = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+  static std::mutex mutex;
+  static IDXGIFactory1* factory = nullptr;
+  static HMONITOR lastMonitor = nullptr;
+  static bool lastHdr = false;
+  std::lock_guard lock(mutex);
+  if (factory != nullptr && factory->IsCurrent() && monitor == lastMonitor)
+    return lastHdr;
+  if (factory != nullptr)
+    factory->Release();
+  factory = nullptr;
+  using CreateFactory = HRESULT(WINAPI*)(REFIID, void**);
+  static const HMODULE dxgi = LoadLibraryW(L"dxgi.dll");
+  static const auto create =
+      dxgi != nullptr ? reinterpret_cast<CreateFactory>(GetProcAddress(dxgi, "CreateDXGIFactory1")) : nullptr;
+  if (create == nullptr || FAILED(create(IID_PPV_ARGS(&factory)))) {
+    factory = nullptr;
+    return false;
+  }
+  bool found = false, hdr = false;
+  IDXGIAdapter1* adapter = nullptr;
+  for (UINT a = 0; !found && factory->EnumAdapters1(a, &adapter) != DXGI_ERROR_NOT_FOUND; ++a) {
+    IDXGIOutput* output = nullptr;
+    for (UINT o = 0; !found && adapter->EnumOutputs(o, &output) != DXGI_ERROR_NOT_FOUND; ++o) {
+      DXGI_OUTPUT_DESC desc;
+      IDXGIOutput6* output6 = nullptr;
+      if (SUCCEEDED(output->GetDesc(&desc)) && desc.Monitor == monitor) {
+        found = true;
+        DXGI_OUTPUT_DESC1 desc1;
+        hdr = SUCCEEDED(output->QueryInterface(IID_PPV_ARGS(&output6))) && SUCCEEDED(output6->GetDesc1(&desc1)) &&
+              desc1.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+        if (output6 != nullptr)
+          output6->Release();
+      }
+      output->Release();
+    }
+    adapter->Release();
+  }
+  lastMonitor = monitor;
+  lastHdr = hdr;
+  return hdr;
+}
+#endif
+
+bool DisplayShowsHDR(SDL_Window* window) {
+#if defined(__PROSPERO__)
+  (void)window;
+  return true;  // the title declares HDR (param.json); the console converts for SDR TVs
+#elif defined(SDL_PLATFORM_WIN32)

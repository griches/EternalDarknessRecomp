+// GXRuntime recomp patch: a package for one machine (the Steam Deck) can ship
+// res/dawn_cache_seed.db, a Dawn cache made on the same GPU and driver: merged
+// into the player's cache once, the pipelines the game compiles at start find
+// their shaders already built. Rows for another GPU or driver are never asked
+// for and go at the next prune.
+constexpr const char* DawnSeedName = "dawn_cache_seed.db";
+
+static std::filesystem::path dawn_seed_path() {
+  std::string base = g_config.resourcesPath != nullptr ? g_config.resourcesPath : "";
+  if (!base.empty() && base.back() != '/' && base.back() != '\\')
+    base += '/';
+  for (const std::string& dir : {base + "res/", base + "../res/", std::string{"res/"}}) {
+    std::error_code ec;
+    const std::filesystem::path path = std::filesystem::path{dir} / DawnSeedName;
+    if (std::filesystem::is_regular_file(path, ec))
+      return path;
+  }
+  return {};
+}
+
+static void merge_dawn_seed() {
+  const std::filesystem::path path = dawn_seed_path();
+  if (path.empty())
+    return;
+  std::error_code ec;
+  const auto size = std::filesystem::file_size(path, ec);
+  const auto time = std::filesystem::last_write_time(path, ec).time_since_epoch().count();
+  const std::string id = fmt::format("{}:{}", size, time);
+  if (sqlite::exec(db, "CREATE TABLE IF NOT EXISTS aurora_seed(id TEXT PRIMARY KEY);") != SQLITE_OK)
+    return;
+  bool merged = false;
+  const auto seen = fmt::format("SELECT 1 FROM aurora_seed WHERE id = '{}'", id);
+  sqlite::exec(db, seen.c_str(), [&merged](int, char**, char**) { merged = true; }, nullptr);
+  if (merged)
+    return;
+  const std::string file = fs_path_to_string(path);
+  char* attach = sqlite3_mprintf("ATTACH DATABASE %Q AS seed", file.c_str());
+  const int ret = sqlite::exec(db, attach);
+  sqlite3_free(attach);
+  if (ret != SQLITE_OK) {
+    Log.warn("Failed to open Dawn cache seed {}: {}", file, sqlite3_errmsg(db));
+    return;
+  }
+  bool schemaMatch = false;
+  const auto schema = fmt::format("SELECT 1 FROM seed.aurora_schema WHERE value = {}", CACHE_SCHEMA);
+  sqlite::exec(db, schema.c_str(), [&schemaMatch](int, char**, char**) { schemaMatch = true; }, nullptr);
+  if (schemaMatch &&
+      sqlite::exec(db, "INSERT OR IGNORE INTO cache SELECT key, value, size, compressed FROM seed.cache;") ==
+          SQLITE_OK) {
+    Log.info("Seeded Dawn cache from {} ({} rows)", file, sqlite3_changes(db));
+    const auto mark = fmt::format("INSERT OR IGNORE INTO aurora_seed VALUES ('{}');", id);
+    sqlite::exec(db, mark.c_str());
+  } else {
+    Log.warn("Dawn cache seed {} does not use schema {}", file, CACHE_SCHEMA);
+  }
+  sqlite::exec(db, "DETACH DATABASE seed;");
+}

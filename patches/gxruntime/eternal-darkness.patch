+
+bool g_wanted = false;
+bool g_photo = false;     // photo mode: frames kept to be held (set_photo)
+Frame g_photoFrame;       // the held frame's draws and uniforms
+bool g_recording = false;
+bool g_havePrev = false;
+Frame g_frames[2];
+int g_cur = 0;
+Stats g_stats;
+std::vector<std::shared_ptr<std::vector<uint8_t>>> g_pool;
+
+constexpr uint32_t kTexGens = gxc::kMaxTexGens;
+
+bool same(const float* a, const float* b, size_t n) { return std::memcmp(a, b, n * sizeof(float)) == 0; }
+
+void lerp(float* out, const float* a, const float* b, size_t n, float t) {
+  for (size_t i = 0; i < n; ++i)
+    out[i] = a[i] + (b[i] - a[i]) * t;
+}
+
+// A position matrix (three rows of four) that moved little enough in one game
+// frame to blend: its rotation and scale by under about 20 degrees, and its
+// translation by under half its distance from the camera. A draw matched by
+// state alone (strict) must be closer still, so two different objects that
+// share a model are never blended into each other. False on NaN.
+bool close_pos(const float (*a)[4], const float (*b)[4], bool strict) {
+  float scale = 0.f, rot = 0.f;
+  for (int r = 0; r < 3; ++r)
+    for (int c = 0; c < 3; ++c) {
+      scale = std::max({scale, std::fabs(a[r][c]), std::fabs(b[r][c])});
+      rot = std::max(rot, std::fabs(a[r][c] - b[r][c]));
+    }
+  if (!(rot <= (strict ? 0.15f : 0.35f) * scale))
+    return false;
+  float da = 0.f, db = 0.f, dd = 0.f;
+  for (int r = 0; r < 3; ++r) {
+    da += a[r][3] * a[r][3];
+    db += b[r][3] * b[r][3];
+    dd += (a[r][3] - b[r][3]) * (a[r][3] - b[r][3]);
+  }
+  return dd <= (strict ? 0.04f : 0.25f) * std::max(da, db) + 1e-6f;
+}
+
+// Texture, projection and post matrices: blend unless they jumped (a scroll
+// wrapping round, a new projection). False on NaN.
+bool close_rows(const float (*a)[4], const float (*b)[4], int rows) {
+  float scale = 1.f, diff = 0.f;
+  for (int r = 0; r < rows; ++r)
+    for (int c = 0; c < 4; ++c) {
+      scale = std::max({scale, std::fabs(a[r][c]), std::fabs(b[r][c])});
+      diff = std::max(diff, std::fabs(a[r][c] - b[r][c]));
+    }
+  return diff <= 0.25f * scale;
+}
+
+// A light's position or direction (xyz).
+bool close_vec(const float* a, const float* b) {
+  float da = 0.f, db = 0.f, dd = 0.f;
+  for (int i = 0; i < 3; ++i) {
+    da += a[i] * a[i];
+    db += b[i] * b[i];
+    dd += (a[i] - b[i]) * (a[i] - b[i]);
+  }
+  return dd <= 0.25f * std::max(da, db) + 1e-6f;
+}
+
+const Vs& vs_at(const std::vector<uint8_t>& u, uint32_t offset) {
+  return *reinterpret_cast<const Vs*>(u.data() + offset);
+}
+const Xf& xf_at(const std::vector<uint8_t>& u, uint32_t offset) {
+  return *reinterpret_cast<const Xf*>(u.data() + offset);
+}
+
+// The k-th of the previous frame's draws with this key, or -1.
+int32_t nth_with(const std::vector<std::pair<uint64_t, uint32_t>>& sorted, uint64_t key, uint32_t nth) {
+  const auto lo = std::lower_bound(sorted.begin(), sorted.end(), std::pair<uint64_t, uint32_t>{key, 0u});
+  if (static_cast<size_t>(sorted.end() - lo) <= nth)
+    return -1;
+  const auto it = lo + nth;
+  return it->first == key ? static_cast<int32_t>(it->second) : -1;
+}
+
+std::shared_ptr<std::vector<uint8_t>> pooled_buffer(size_t size) {
+  for (auto& buf : g_pool)
+    if (buf.use_count() == 1) {
+      buf->resize(size);
+      return buf;
+    }
+  auto buf = std::make_shared<std::vector<uint8_t>>(size);
+  if (g_pool.size() < 8)
+    g_pool.push_back(buf);
+  return buf;
+}
+} // namespace
+
+void set_wanted(bool on) noexcept { g_wanted = on; }
+bool recording() noexcept { return g_recording; }
+
+void begin_frame() noexcept {
+  // The frame just ended was kept: it is the one to blend from now.
+  g_havePrev = g_recording;
+  if (g_recording)
+    g_cur ^= 1;
+  g_recording = g_wanted || g_photo;
+  Frame& f = g_frames[g_cur];
+  f.uniforms.clear();
+  f.draws.clear();
+  if (!g_recording) {
+    g_havePrev = false;
+    for (Frame& frame : g_frames) {
+      frame.uniforms.shrink_to_fit();
+      frame.draws.shrink_to_fit();
+    }
+    g_pool.clear();
+  }
+}
+
+void note_uniform(uint32_t offset, const uint8_t* data, size_t length) noexcept {
+  if (!g_recording || length == 0)
+    return;
+  auto& u = g_frames[g_cur].uniforms;
+  const size_t end = static_cast<size_t>(offset) + length;
+  if (u.size() < end)
+    u.resize(end);
+  std::memcpy(u.data() + offset, data, length);
+}
+
+void note_draw(const gxc::DrawPlan& plan, uint32_t vsOffset, uint32_t xfOffset) noexcept {
+  if (!g_recording)
+    return;
+  auto& draws = g_frames[g_cur].draws;
+  // Photo mode: a draw that adds light (a lens flare, a glint) is the scene's,
+  // even in 2D: kept in a photo that leaves the HUD out.
+  const auto& k = plan.pipeline;
+  const bool addsLight = g_photo && k.blend_enable != 0 && k.blend_subtract == 0 && k.logic_op_enable == 0 &&
+                         static_cast<gxc::DstBlendFactor>(k.dst_factor) == gxc::DstBlendFactor::One;
+  // Draws that share the previous draw's uniforms change nothing to blend.
+  // (Photo mode keeps every one: the HUD and a lens flare can share theirs.)
+  if (!g_photo && !draws.empty() && draws.back().vs == vsOffset && draws.back().xf == xfOffset)
+    return;
+  uint32_t id[14]{};
+  std::memcpy(id, &plan.pipeline_hash, sizeof plan.pipeline_hash);
+  id[2] = plan.vertex_count;
+  id[3] = plan.texmap_mask;
+  id[4] = plan.has_texture ? plan.tex_address : 0u;
+  id[5] = plan.has_texture ? plan.tex_format : 0u;
+  for (uint32_t t = 0; t < 8u; ++t)
+    if ((plan.texmap_mask >> t) & 1u)
+      id[6 + t] = plan.textures[t].address;
+  const uint64_t loose = XXH3_64bits(id, sizeof id);
+  // The first vertices' positions and matrix indices, in object space: the
+  // same each frame for a model the GPU moves, new for geometry the game
+  // builds each frame (which only matches loosely).
+  float first[6][4]{};
+  const size_t n = std::min<size_t>({6u, plan.vertex_count, plan.vertices.size() / gxc::kVertexFloats});
+  for (size_t i = 0; i < n; ++i)
+    std::memcpy(first[i], &plan.vertices[i * gxc::kVertexFloats], sizeof first[i]);
+  const uint64_t key = XXH3_64bits_withSeed(first, n * sizeof first[0], loose);
+  // Photo mode: where an orthographic draw's first vertices land on screen.
+  // One over the whole screen (a fade, a blur, a copy of the frame drawn
+  // back) stays; smaller ones (text, the HUD) are left out of the photo,
+  // unless they add light (addsLight above).
+  bool screenWide = false;
+  const auto& vc = plan.constants;
+  if (g_photo && vc.projection[3][3] == 1.f && n > 0) {
+    float lo[2]{1e9f, 1e9f}, hi[2]{-1e9f, -1e9f};
+    for (size_t i = 0; i < n; ++i) {
+      const float(*m)[4] = vc.posnormalmatrix;
+      if (plan.pipeline.shader.has_pos_mtx_idx != 0 && plan.shared_constants != nullptr) {
+        uint32_t row = 0;
+        std::memcpy(&row, &first[i][3], sizeof row);
+        if (row <= 61u)
+          m = &plan.shared_constants->transformmatrices[row];
+      }
+      const float v[4]{first[i][0], first[i][1], first[i][2], 1.f};
+      float view[4]{0.f, 0.f, 0.f, 1.f};
+      for (int r = 0; r < 3; ++r)
+        view[r] = m[r][0] * v[0] + m[r][1] * v[1] + m[r][2] * v[2] + m[r][3];
+      for (int a = 0; a < 2; ++a) {
+        const float c = vc.projection[a][0] * view[0] + vc.projection[a][1] * view[1] +
+                        vc.projection[a][2] * view[2] + vc.projection[a][3];
+        lo[a] = std::min(lo[a], c);
+        hi[a] = std::max(hi[a], c);
+      }
+    }
+    screenWide = hi[0] - lo[0] >= 1.8f && hi[1] - lo[1] >= 1.8f;
+    Draw draw{key, loose, vsOffset, xfOffset, screenWide, addsLight};
+    draw.blend[0] = k.blend_enable;
+    draw.blend[1] = k.src_factor;
+    draw.blend[2] = k.dst_factor;
+    draw.tex = plan.has_texture ? plan.tex_address : 0u;
+    draw.verts = plan.vertex_count;
+    draw.box[0] = lo[0], draw.box[1] = lo[1], draw.box[2] = hi[0], draw.box[3] = hi[1];
+    draws.push_back(draw);
+    return;
+  }
+  draws.push_back(Draw{key, loose, vsOffset, xfOffset, screenWide, addsLight});
+}
+
+Result build(const float* phases, size_t count, size_t uniformSize, std::vector<Uniforms>& out) {
+  out.clear();
+  Stats stats;
+  Frame& cur = g_frames[g_cur];
+  const Frame& prev = g_frames[g_cur ^ 1];
+  const size_t size = (uniformSize + 3u) & ~size_t{3u};
+  if (!g_recording || !g_havePrev || count == 0) {
+    g_stats = stats;
+    return stats.result;
+  }
+  if (cur.uniforms.size() < size)
+    cur.uniforms.resize(size);
+  stats.draws = static_cast<uint32_t>(cur.draws.size());
+
+  // Match each draw to the previous frame's: the k-th draw with a key to the
+  // k-th one there (the game draws its scene in the same order each frame),
+  // first by geometry, then by state alone for what is left.
+  static std::vector<std::pair<uint64_t, uint32_t>> byKey, byLoose;
+  static absl::flat_hash_map<uint64_t, uint32_t> seenKey, seenLoose;
+  static std::vector<uint8_t> used;
+  static std::vector<int32_t> match;
+  static std::vector<uint32_t> looseNth;
+  byKey.clear();
+  byLoose.clear();
+  for (uint32_t i = 0; i < prev.draws.size(); ++i) {
+    byKey.emplace_back(prev.draws[i].key, i);
+    byLoose.emplace_back(prev.draws[i].loose, i);
+  }
+  std::sort(byKey.begin(), byKey.end());
+  std::sort(byLoose.begin(), byLoose.end());
+  seenKey.clear();
+  seenLoose.clear();
+  used.assign(prev.draws.size(), 0);
+  match.assign(cur.draws.size(), -1);
+  looseNth.resize(cur.draws.size());
+  for (size_t i = 0; i < cur.draws.size(); ++i) {
+    const Draw& c = cur.draws[i];
+    looseNth[i] = seenLoose[c.loose]++;
+    const int32_t p = nth_with(byKey, c.key, seenKey[c.key]++);
+    if (p >= 0 && used[p] == 0) {
+      match[i] = p;
+      used[p] = 1;
+      ++stats.matched;
+    }
+  }
+  static std::vector<uint8_t> strict;
+  strict.assign(cur.draws.size(), 0);
+  for (size_t i = 0; i < cur.draws.size(); ++i) {
+    if (match[i] >= 0)
+      continue;
+    const int32_t p = nth_with(byLoose, cur.draws[i].loose, looseNth[i]);
+    if (p >= 0 && used[p] == 0) {
+      match[i] = p;
+      used[p] = 1;
+      strict[i] = 1;
+      ++stats.loose;
+    }
+  }
+
+  // What to blend of each pair, and whether the camera cut.
+  static std::vector<VsPair> vsPairs;
+  static std::vector<XfPair> xfPairs;
+  static absl::flat_hash_map<uint32_t, uint32_t> vsSeen, xfSeen;
+  vsPairs.clear();
+  xfPairs.clear();
+  vsSeen.clear();
+  xfSeen.clear();
+  for (size_t i = 0; i < cur.draws.size(); ++i) {
+    if (match[i] < 0)
+      continue;
+    const Draw& c = cur.draws[i];
+    const Draw& p = prev.draws[match[i]];
+    const bool tight = strict[i] != 0;
+    if (c.vs + sizeof(Vs) <= cur.uniforms.size() && p.vs + sizeof(Vs) <= prev.uniforms.size() &&
+        vsSeen.emplace(c.vs, p.vs).second) {
+      const Vs& a = vs_at(prev.uniforms, p.vs);
+      const Vs& b = vs_at(cur.uniforms, c.vs);
+      uint32_t mask = 0;
+      if (!same(a.posnormalmatrix[0], b.posnormalmatrix[0], 12)) {
+        ++stats.moved;
+        if (close_pos(a.posnormalmatrix, b.posnormalmatrix, tight))
+          mask |= 1u;
+        else
+          ++stats.jumped;
+      }
+      if (!same(a.projection[0], b.projection[0], 16) && a.projection[3][2] == b.projection[3][2] &&
+          a.projection[3][3] == b.projection[3][3] && close_rows(a.projection, b.projection, 4))
+        mask |= 2u;
+      for (uint32_t g = 0; g < kTexGens; ++g)
+        if (!same(a.texmatrices[3 * g], b.texmatrices[3 * g], 12) &&
+            close_rows(&a.texmatrices[3 * g], &b.texmatrices[3 * g], 3))
+          mask |= 4u << g;
+      if (mask != 0)
+        vsPairs.push_back(VsPair{c.vs, p.vs, mask});
+    }
+    if (c.xf + sizeof(Xf) <= cur.uniforms.size() && p.xf + sizeof(Xf) <= prev.uniforms.size() &&
+        xfSeen.emplace(c.xf, p.xf).second) {
+      const Xf& a = xf_at(prev.uniforms, p.xf);
+      const Xf& b = xf_at(cur.uniforms, c.xf);
+      if (std::memcmp(&a, &b, sizeof(Xf)) == 0)
+        continue;
+      XfPair pair{c.xf, p.xf};
+      for (uint32_t m = 0; m < 10u; ++m) {
+        const float(*ra)[4] = &a.transformmatrices[3 * m];
+        const float(*rb)[4] = &b.transformmatrices[3 * m];
+        if (same(ra[0], rb[0], 12))
+          continue;
+        ++stats.moved;
+        if (close_pos(ra, rb, tight))
+          pair.pos |= 1u << m;
+        else
+          ++stats.jumped;
+      }
+      for (uint32_t k = 0; k < 11u; ++k) {
+        const uint32_t row = 30u + 3u * k;
+        if (!same(a.transformmatrices[row], b.transformmatrices[row], 12) &&
+            close_rows(&a.transformmatrices[row], &b.transformmatrices[row], 3))
+          pair.tex |= 1u << k;
+      }
+      for (uint32_t k = 0; k < 22u; ++k) {
+        const uint32_t row = 3u * k;
+        const int rows = std::min(3, 64 - static_cast<int>(row));
+        if (!same(a.posttransformmatrices[row], b.posttransformmatrices[row], rows * 4u) &&
+            close_rows(&a.posttransformmatrices[row], &b.posttransformmatrices[row], rows))
+          pair.post |= 1u << k;
+      }
+      for (uint32_t l = 0; l < 8u; ++l) {
+        const auto& la = a.lights[l];
+        const auto& lb = b.lights[l];
+        if ((!same(la.pos, lb.pos, 3) || !same(la.dir, lb.dir, 3)) && close_vec(la.pos, lb.pos) &&
+            close_vec(la.dir, lb.dir))
+          pair.lights |= 1u << l;
+      }
+      if ((pair.pos | pair.tex | pair.post | pair.lights) != 0)
+        xfPairs.push_back(pair);
+    }
+  }
+
+  if (stats.matched + stats.loose == 0 && !cur.draws.empty())
+    stats.result = Result::Cut;
+  else if (stats.jumped >= 4 && stats.jumped * 2 >= stats.moved)
+    stats.result = Result::Cut;
+  else if (vsPairs.empty() && xfPairs.empty())
+    stats.result = Result::Still;
+  else
+    stats.result = Result::Blend;
+  g_stats = stats;
+  if (stats.result != Result::Blend)
+    return stats.result;
+
+  for (size_t n = 0; n < count; ++n) {
+    const float t = std::clamp(phases[n], 0.f, 1.f);
+    auto buf = pooled_buffer(size);
+    std::memcpy(buf->data(), cur.uniforms.data(), size);
+    for (const VsPair& pair : vsPairs) {
+      Vs& o = *reinterpret_cast<Vs*>(buf->data() + pair.cur);
+      const Vs& a = vs_at(prev.uniforms, pair.prev);
+      const Vs& b = vs_at(cur.uniforms, pair.cur);
+      if (pair.mask & 1u)
+        lerp(o.posnormalmatrix[0], a.posnormalmatrix[0], b.posnormalmatrix[0], 24, t);
+      if (pair.mask & 2u)
+        lerp(o.projection[0], a.projection[0], b.projection[0], 16, t);
+      for (uint32_t g = 0; g < kTexGens; ++g)
+        if (pair.mask & (4u << g))
+          lerp(o.texmatrices[3 * g], a.texmatrices[3 * g], b.texmatrices[3 * g], 12, t);
+    }
+    for (const XfPair& pair : xfPairs) {
+      Xf& o = *reinterpret_cast<Xf*>(buf->data() + pair.cur);
+      const Xf& a = xf_at(prev.uniforms, pair.prev);
+      const Xf& b = xf_at(cur.uniforms, pair.cur);
+      for (uint32_t m = 0; m < 10u; ++m)
+        if (pair.pos & (1u << m))
+          lerp(o.transformmatrices[3 * m], a.transformmatrices[3 * m], b.transformmatrices[3 * m], 12, t);
+      for (uint32_t k = 0; k < 11u; ++k)
+        if (pair.tex & (1u << k)) {
+          const uint32_t row = 30u + 3u * k;
+          lerp(o.transformmatrices[row], a.transformmatrices[row], b.transformmatrices[row], 12, t);
+        }
+      for (uint32_t k = 0; k < 22u; ++k)
+        if (pair.post & (1u << k)) {
+          const uint32_t row = 3u * k;
+          const size_t rows = std::min<size_t>(3u, 64u - row);
+          lerp(o.posttransformmatrices[row], a.posttransformmatrices[row], b.posttransformmatrices[row], rows * 4u,
+               t);
+        }
+      for (uint32_t l = 0; l < 8u; ++l)
+        if (pair.lights & (1u << l)) {
+          lerp(o.lights[l].pos, a.lights[l].pos, b.lights[l].pos, 3, t);
+          lerp(o.lights[l].dir, a.lights[l].dir, b.lights[l].dir, 3, t);
+        }
+    }
+    out.push_back(std::move(buf));
+  }
+  return Result::Blend;
+}
+
+Stats last_stats() noexcept { return g_stats; }
+// ---- Photo mode ------------------------------------------------------------
+
+void set_photo(bool on) noexcept {
+  g_photo = on;
+  if (!on) {
+    g_photoFrame.uniforms.clear();
+    g_photoFrame.uniforms.shrink_to_fit();
+    g_photoFrame.draws.clear();
+    g_photoFrame.draws.shrink_to_fit();
+  }
+}
+
+bool photo_capture() noexcept {
+  if (!g_photo || !g_recording)
+    return false;
+  g_photoFrame = g_frames[g_cur];
+  static const bool log = std::getenv("ED_PHOTO_LOG") != nullptr;
+  if (log) {
+    int n = 0;
+    for (const Draw& d : g_photoFrame.draws) {
+      if (d.vs + sizeof(Vs) > g_photoFrame.uniforms.size())
+        continue;
+      const Vs& v = vs_at(g_photoFrame.uniforms, d.vs);
+      if (v.projection[3][3] != 1.f)
+        continue;
+      std::fprintf(stderr,
+                   "[photo] 2D draw %d: vs %u blend %u src %u dst %u tex %08x verts %u at %.2f,%.2f..%.2f,%.2f%s%s\n",
+                   n++, d.vs, d.blend[0], d.blend[1], d.blend[2], d.tex, d.verts, d.box[0], d.box[1], d.box[2],
+                   d.box[3], d.screenWide ? " (whole screen)" : "", d.addsLight ? " (adds light)" : "");
+    }
+  }
+  return !g_photoFrame.draws.empty();
+}
+
+Uniforms photo_build(size_t uniformSize, PhotoProjection fn, const void* user, bool hideHud, PhotoFlare flare) {
+  const Frame& f = g_photoFrame;
+  const size_t size = (uniformSize + 3u) & ~size_t{3u};
+  auto buf = pooled_buffer(size);
+  std::memset(buf->data(), 0, size);
+  std::memcpy(buf->data(), f.uniforms.data(), std::min(size, f.uniforms.size()));
+  // A uniform block several draws share (identical constants are stored
+  // once) is the HUD's only when every draw using it is.
+  absl::flat_hash_map<uint32_t, bool> hud;
+  absl::flat_hash_map<uint32_t, std::vector<std::pair<float, float>>> sprites;  // their middles on screen
+  for (const Draw& d : f.draws) {
+    if (d.vs + sizeof(Vs) > f.uniforms.size() || d.vs + sizeof(Vs) > size)
+      continue;
+    const Vs& src = vs_at(f.uniforms, d.vs);
+    const bool isHud = src.projection[3][3] == 1.f && !d.screenWide && !d.addsLight;
+    const auto [it, added] = hud.try_emplace(d.vs, isHud);
+    if (!added)
+      it->second = it->second && isHud;
+    if (isHud)
+      sprites[d.vs].emplace_back((d.box[0] + d.box[2]) * 0.5f, (d.box[1] + d.box[3]) * 0.5f);
+  }
+  // The scene's projection: the first perspective draw's.
+  const float(*scene)[4] = nullptr;
+  for (const Draw& d : f.draws) {
+    if (d.vs + sizeof(Vs) > f.uniforms.size())
+      continue;
+    const Vs& v = vs_at(f.uniforms, d.vs);
+    if (v.projection[3][2] == -1.f && v.projection[3][3] == 0.f) {
+      scene = v.projection;
+      break;
+    }
+  }
+  // A lens flare: three or more sprites in a line through the middle of the
+  // screen, at multiples of where the light is. The scene's: kept, and moved
+  // with the camera: one turn and stretch of the screen about its middle
+  // takes the light to where the photo's camera sees it, and every sprite on
+  // the line with it (the light: where most sprites sit on each other).
+  absl::flat_hash_map<uint32_t, std::array<float, 4>> flares;  // the 2x2 map, or hidden (all 0)
+  for (auto& [offset, middles] : sprites) {
+    if (middles.size() < 3)
+      continue;
+    std::pair<float, float> far{0.f, 0.f};
+    for (const auto& m : middles)
+      if (m.first * m.first + m.second * m.second > far.first * far.first + far.second * far.second)
+        far = m;
+    const float len = std::sqrt(far.first * far.first + far.second * far.second);
+    if (len < 0.2f)
+      continue;
+    bool line = true;
+    for (const auto& m : middles)
+      line = line && std::fabs(m.first * far.second - m.second * far.first) / len < 0.08f;
+    if (!line)
+      continue;
+    hud[offset] = false;
+    if (flare == nullptr || scene == nullptr)
+      continue;
+    std::pair<float, float> light = far;
+    int most = 0;
+    for (const auto& a : middles) {
+      int n = 0;
+      for (const auto& b : middles)
+        n += std::fabs(a.first - b.first) < 0.03f && std::fabs(a.second - b.second) < 0.03f ? 1 : 0;
+      if (n > most) {
+        most = n;
+        light = a;
+      }
+    }
+    const float at[2]{light.first, light.second};
+    float m[2][2];
+    flares[offset] = flare(at, scene, m, user) ? std::array<float, 4>{m[0][0], m[0][1], m[1][0], m[1][1]}
+                                               : std::array<float, 4>{0.f, 0.f, 0.f, 0.f};
+  }
+  for (const auto& [offset, isHud] : hud) {
+    const Vs& src = vs_at(f.uniforms, offset);
+    Vs& dst = *reinterpret_cast<Vs*>(buf->data() + offset);
+    if (src.projection[3][2] == -1.f && src.projection[3][3] == 0.f) {
+      float out[4][4];
+      fn(src.projection, out, user);
+      std::memcpy(dst.projection, out, sizeof out);
+    } else if (const auto fl = flares.find(offset); fl != flares.end()) {
+      const auto& m = fl->second;
+      float out[4][4];
+      std::memcpy(out, src.projection, sizeof out);
+      if (m[0] == 0.f && m[1] == 0.f && m[2] == 0.f && m[3] == 0.f) {
+        std::memset(out, 0, sizeof out);
+        out[0][3] = 2.f;
+        out[3][3] = 1.f;
+      } else {
+        for (int j = 0; j < 4; ++j) {
+          out[0][j] = m[0] * src.projection[0][j] + m[1] * src.projection[1][j];
+          out[1][j] = m[2] * src.projection[0][j] + m[3] * src.projection[1][j];
+        }
+      }
+      std::memcpy(dst.projection, out, sizeof out);
+    } else if (hideHud && isHud) {
+      // Off the screen: every vertex at x = 2.
+      float out[4][4]{};
+      out[0][3] = 2.f;
+      out[3][3] = 1.f;
+      std::memcpy(dst.projection, out, sizeof out);
+    }
+  }
+  return buf;
+}
+} // namespace aurora::gfx::interp

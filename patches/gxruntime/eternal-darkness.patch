+// DOL_GXCORE_UV2_LOG=1: print each texture a draw samples through texture
+// coordinates from the second UV set (TEX1) once, with Dolphin's name hash.
+// In Eternal Darkness those are the rooms' baked light maps, for making HD
+// light maps.
+namespace {
+bool samples_uv2(const gxc::ShaderKey& key, uint32_t texmap) {
+  for (uint32_t n = 0; n < key.num_tev_stages; ++n) {
+    const gxc::TevStageKey& s = key.tev_stages[n];
+    if (s.tevorders_enable == 0u || (s.tevorders_texmap & 7u) != texmap)
+      continue;
+    const uint32_t tc = s.tevorders_texcoord & 7u;
+    if (tc < key.num_tex_gens &&
+        static_cast<gxc::TexGenType>(key.tex_gens[tc].texgentype) == gxc::TexGenType::Regular &&
+        key.tex_gens[tc].sourcerow == static_cast<uint8_t>(gxc::TexSourceRow::Tex0) + 1u)
+      return true;
+  }
+  return false;
+}
+
+void log_uv2(const gxc::DrawPlan& plan, uint32_t texmap) {
+  static const bool on = std::getenv("DOL_GXCORE_UV2_LOG") != nullptr;
+  if (!on || !samples_uv2(plan.pipeline.shader, texmap))
+    return;
+  const gxc::PlanTexture& pt = plan.textures[texmap];
+  const uint32_t base = gxc::texture_base_level_size(pt.format, pt.width, pt.height);
+  if (pt.data == nullptr || base == 0u || base > std::min(pt.size, pt.available))
+    return;
+  const uint64_t hash = XXH64(pt.data, base, 0);
+  static absl::flat_hash_set<uint64_t> seen;
+  if (seen.insert(hash).second)
+    std::fprintf(stderr, "[uv2] tex1_%ux%u_%016llx_%u address=%08X\n", pt.width, pt.height,
+                 static_cast<unsigned long long>(hash), pt.format, pt.address);
+}

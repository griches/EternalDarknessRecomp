@@ -0,0 +1,62 @@
+#pragma once
+
+// GXRuntime recomp patch: glow (bloom). A draw that adds light to the screen
+// (additive blending: candles, magick, rune glow) is drawn a second time into
+// a float glow buffer after its EFB pass; at the display copy the buffer is
+// blurred down a chain of half-size targets and added to the shown frame,
+// then cleared for the next frame. Everything is encoded on the render
+// worker. The strength is 0 (off) until aurora_set_glow sets it.
+
+#include "../webgpu/gpu.hpp"
+
+namespace aurora::gfx::glow {
+
+float strength() noexcept;
+// The glow's scene work runs: glow on, or HDR on (its highlights come from it).
+bool active() noexcept;
+// HDR: how far past their SDR level the scene's highlights go (1 + gain).
+void set_hdr_highlight(float gain) noexcept;
+// HDR calibration: SDR white and the display's peak in nits, the black level
+// (lifted above 0, sunk below), and a test pattern in place of the picture
+// (0 none, 1 peak, 3 black; 2 = the picture, for brightness).
+void set_hdr_levels(float paperNits, float peakNits, float black) noexcept;
+void set_hdr_pattern(int pattern) noexcept;
+void set_strength(float strength) noexcept;
+
+// The glow buffer to draw into after an EFB pass (size and samples of the
+// EFB), made or remade as needed. Clear on the first pass after a display.
+struct Target {
+  wgpu::TextureView view;
+  wgpu::TextureView resolveView; // null without MSAA
+  bool clear = false;
+};
+Target begin_pass(const wgpu::Extent3D& size, uint32_t msaaSamples);
+// The emit buffer, the same for draws that glow on their own (HDR on, the
+// glow setting off; gxcore add_emit_texture): blurred at the display copy
+// like the glow and added by the HDR present at the emit strength.
+Target begin_emit_pass(const wgpu::Extent3D& size, uint32_t msaaSamples);
+void set_emit_strength(float strength) noexcept;
+// A movie is playing: the HDR present shows it at video's white, no glow.
+void set_movie(bool playing) noexcept;
+
+// Keep the frame's 3D scene (the EFB before the HUD is drawn over it): its
+// highlights are added to the glow at the next compose, and a copy of it
+// shows the compose what was drawn over the scene since.
+void take_scene(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& efb, const wgpu::Extent3D& size,
+                uint32_t msaaSamples);
+
+// Blur this frame's glow and add it to dst (a render texture of the frame:
+// rect of the EFB's size), then clear the glow for the next frame. Nothing
+// when no glow was drawn since the last display. efb: the finished frame;
+// where it differs from the scene taken (the black bars, the HUD, a fade
+// drawn over it) no glow or highlight is added.
+void compose(const wgpu::CommandEncoder& cmd, const wgpu::TextureView& dst, wgpu::TextureFormat format,
+             const wgpu::TextureView& efb);
+
+// HDR (webgpu::g_hdrActive): draw the picture (a copy bind group) onto the
+// window's float surface, with the shown frame's glow added past white when
+// withGlow; and a premultiplied page over it. False if it can't.
+bool present_hdr(const wgpu::RenderPassEncoder& pass, const wgpu::BindGroup& source, bool withGlow);
+bool present_hdr_overlay(const wgpu::RenderPassEncoder& pass, const wgpu::BindGroup& source);
+
+} // namespace aurora::gfx::glow

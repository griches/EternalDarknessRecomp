+bool SetSurfaceExtendedRange(bool on) {
+  CAMetalLayer* layer = g_layer;
+  if (layer == nil)
+    return false;
+  void (^apply)(void) = ^{
+    layer.wantsExtendedDynamicRangeContent = on;
+    CGColorSpaceRef space = CGColorSpaceCreateWithName(on ? kCGColorSpaceExtendedLinearSRGB : kCGColorSpaceSRGB);
+    layer.colorspace = space;
+    CGColorSpaceRelease(space);
+  };
+  if ([NSThread isMainThread])
+    apply();
+  else
+    dispatch_sync(dispatch_get_main_queue(), apply);
+  return true;
+}

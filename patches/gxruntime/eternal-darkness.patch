+// --- Decode -> main: the render ring --------------------------------------------
+// The decode thread turns the queued GX stream into draws (each with the
+// register state it needs) and the Aurora calls between them, in order, into
+// reusable slots; the main thread builds each draw's plan, submits it and
+// makes the calls. A full ring holds the decode thread back.
+enum class Item : std::uint8_t {
+    Draw,
+    EfbCopy,
+    SetArray,
+    CopyDest,
+    ConfigureVi,
+    SetNextXfb,
+    FlushXfb,
+    SetXfbBlack,
+    Present,
+    Call,
+    Done,
+};
+
+struct RenderItem {
+    Item kind = Item::Done;
+    std::shared_ptr<const gxruntime::gxcore::GxCoreState> state;
+    gxruntime::aurora_recomp::ConsumedDraw draw;
+    gxruntime::gxcore::EfbCopyCommand copy{};
+    SetArrayArgs set_array{};
+    CopyDestArgs copy_dest{};
+    ViArgs vi{};
+    u32 value = 0;
+    bool flag = false;
+    std::uint64_t n = 0;
+    std::uint64_t t_game = 0;
+    const std::function<void()>* fn = nullptr;
+    // Draws are planned by whichever thread claims the slot first (a plan
+    // worker, or the main thread when it gets there first); 2 = done.
+    gxruntime::gxcore::DrawPlan plan;
+    std::atomic<int> plan_state{0};
+};

+// GXRuntime recomp patch (testing): AURORA_FRAME_DUMP=<folder> writes every
+// shown frame, shrunk to about AURORA_FRAME_DUMP_WIDTH (320) pixels wide, as <folder>/frame-<n>.ppm,
+// from frame AURORA_FRAME_DUMP_FIRST (0) for AURORA_FRAME_DUMP_COUNT (600),
+// to catch a one-frame glitch on a machine without screen capture. Frames
+// whose copy finds every readback buffer busy are skipped (and logged).
+namespace frame_dump {
+const char* dir() {
+  static const char* d = [] {
+    const char* e = std::getenv("AURORA_FRAME_DUMP");
+    return e != nullptr && e[0] != '\0' ? e : nullptr;
+  }();
+  return d;
+}
+struct Slot {
+  wgpu::Buffer buffer;
+  uint64_t size = 0;
+  uint32_t width = 0, height = 0, bytesPerRow = 0, frame = 0;
+  bool bgra = false;
+  std::atomic<bool> busy{false};
+};
+Slot g_slots[8];
+uint32_t g_frame = 0;
+
+void write_ppm(std::string path, std::vector<uint8_t> rgb, uint32_t w, uint32_t h) {
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+    std::fwrite(rgb.data(), 1, rgb.size(), f);
+    std::fclose(f);
+  }
+}

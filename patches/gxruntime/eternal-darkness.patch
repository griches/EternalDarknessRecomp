+static void store_watch(CPUState* cpu, u32 addr, u32 size, u64 value) {
+    if (g_store_watch < 0) {
+        const char* env = getenv("ED_STORE_WATCH");
+        g_store_watch = env != NULL && env[0] != '\0';
+        char* end = NULL;

+bool dol_aurora_xfb_ram_sync(uint32_t address) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (!g_initialized || !g_gx_core_enabled)
+        return false;
+    // The newest display copy there in stream order (after everything the
+    // game has sent), then its readback: the game then reads the copy it just
+    // made, as it would on the GameCube, not one a frame or two old.
+    const uint32_t dest = address & 0x01FFFFFFu;
+    unsigned long long copy = 0;
+    if (gxq::on_game_thread())
+        gxq::call_sync([&] { copy = aurora::gfx::gxcore::xfb_ram_latest_copy(dest); });
+    else
+        copy = aurora::gfx::gxcore::xfb_ram_latest_copy(dest);
+    const int ms = aurora::gfx::gxcore::xfb_ram_wait_write(dest, copy, 200);
+    std::fprintf(stderr, "[xfb] the game reads 0x%08X: copy %llu %s%d ms\n", dest, copy,
+                 ms < 0 ? "not read back in " : "read back after ", ms < 0 ? 200 : ms);
+    return ms >= 0;
+#else
+    (void)address;
+    return false;
+#endif
+}
+
+void dol_aurora_xfb_texture(uint32_t xfb, uint32_t texture) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (!g_initialized || !g_gx_core_enabled)
+        return;
+    // In stream order, as the sync above: the copy the game converts is the
+    // newest one to xfb the main thread has made.
+    const auto alias = [&] { aurora::gfx::gxcore::alias_xfb_texture(xfb, texture); };
+    if (gxq::on_game_thread())
+        gxq::call_sync(alias);
+    else
+        alias();
+#else
+    (void)xfb;
+    (void)texture;
+#endif
+}
+
+bool dol_aurora_gx_idle(void) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (gxq::on_game_thread()) {
+        bool idle = false;
+        gxq::call_sync([&] { idle = dol_aurora_gx_idle(); });
+        return idle;
+    }
+    // A frontend that has failed ignores the FIFO, so its leftover bytes would
+    // never drain; it no longer cares where the guest is.
+    return !g_shadow_frontend_enabled || g_shadow_frontend_failed ||
+           g_shadow_frontend.pending_fifo_size() == 0u;
+#else
+    return true;
+#endif
+}

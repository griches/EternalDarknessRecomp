+@group(0) @binding(0) var src: texture_2d<f32>;
+@group(0) @binding(1) var samp: sampler;
+struct Params { a: vec4f, b: vec4f, c: vec4f, d: vec4f };
+@group(0) @binding(2) var<uniform> params: Params;
+fn tap(uv: vec2f, t: vec2f, x: f32, y: f32) -> vec3f {
+  return textureSampleLevel(src, samp, uv + t * vec2f(x, y), 0.0).rgb;
+}
+fn tent(uv: vec2f) -> vec3f {
+  let t = 1.0 / vec2f(textureDimensions(src));
+  return (tap(uv, t, -1.0, -1.0) + tap(uv, t, 1.0, -1.0) + tap(uv, t, -1.0, 1.0) + tap(uv, t, 1.0, 1.0)
+        + 2.0 * (tap(uv, t, 0.0, -1.0) + tap(uv, t, -1.0, 0.0) + tap(uv, t, 1.0, 0.0) + tap(uv, t, 0.0, 1.0))
+        + 4.0 * tap(uv, t, 0.0, 0.0)) / 16.0;
+}
+@fragment fn down(in: VOut) -> @location(0) vec4f {
+  let t = 1.0 / vec2f(textureDimensions(src));
+  let uv = in.uv;
+  let outer = tap(uv, t, -2.0, -2.0) + tap(uv, t, 2.0, -2.0) + tap(uv, t, -2.0, 2.0) + tap(uv, t, 2.0, 2.0);
+  let cross = tap(uv, t, 0.0, -2.0) + tap(uv, t, -2.0, 0.0) + tap(uv, t, 2.0, 0.0) + tap(uv, t, 0.0, 2.0);
+  let inner = tap(uv, t, -1.0, -1.0) + tap(uv, t, 1.0, -1.0) + tap(uv, t, -1.0, 1.0) + tap(uv, t, 1.0, 1.0);
+  let c = tap(uv, t, 0.0, 0.0) * 0.125 + outer * 0.03125 + cross * 0.0625 + inner * 0.125;
+  return vec4f(max(c, vec3f(0.0)), 1.0);
+}
+// a = (strength, threshold, knee, scene weight), b = (saturation boost,
+// spread: each wider level's share, cap, 0).
+@fragment fn up(in: VOut) -> @location(0) vec4f {
+  return vec4f(tent(in.uv) * params.b.y, 1.0);
+}
+@fragment fn show(in: VOut) -> @location(0) vec4f {
+  return vec4f(textureSampleLevel(src, samp, in.uv, 0.0).rgb, 1.0);
+}
+@fragment fn compose(in: VOut) -> @location(0) vec4f {
+  return vec4f(tent(in.uv) * params.a.x, 0.0);
+}
+// The scene's lights: what scores over the threshold, with a soft knee, times
+// the scene weight. The score is the brightest channel raised by saturation:
+// Eternal Darkness is dark, and what glows in it (a portal, flames, magick,
+// runes) is vivid colour rather than bright; lit stone and skin are not.
+fn bright_of(c: vec3f) -> vec3f {
+  let hi = max(c.r, max(c.g, c.b));
+  let lo = min(c.r, min(c.g, c.b));
+  let sat = (hi - lo) / max(hi, 1e-4);
+  let score = hi * (1.0 + params.b.x * sat * sat);
+  let t = params.a.y;
+  let k = params.a.z;
+  var soft = clamp(score - t + k, 0.0, 2.0 * k);
+  soft = soft * soft / (4.0 * k + 1e-4);
+  // Over the threshold by at most the cap (b.z): a sunlit floor feeds the
+  // glow about as much as a portal does, not four times as much.
+  let w = min(max(soft, score - t), params.b.z) / max(score, 1e-4);
+  return c * w * params.a.w;
+}
+// Straight from the full-size frame into the half-size first level: four
+// taps between texels, each the average of 2x2, judged separately.
+@fragment fn bright(in: VOut) -> @location(0) vec4f {
+  let t = 1.0 / vec2f(textureDimensions(src));
+  let c = bright_of(tap(in.uv, t, -1.0, -1.0)) + bright_of(tap(in.uv, t, 1.0, -1.0))
+        + bright_of(tap(in.uv, t, -1.0, 1.0)) + bright_of(tap(in.uv, t, 1.0, 1.0));
+  return vec4f(c * 0.25, 1.0);
+}
+)";
+
+// HDR present (the window's 16-bit extended linear sRGB surface): the frame
+// and its glow added in the game's own (sRGB) values, then made linear with
+// the curve carried on past 1.0, so all that reached white in SDR now goes
+// brighter. c = (paper white, glow gain, peak, 0).
+constexpr const char* kPresentShader = R"(
+@group(0) @binding(0) var efb_sampler: sampler;
+@group(0) @binding(1) var efb_texture: texture_2d<f32>;
+struct Params { a: vec4f, b: vec4f, c: vec4f, d: vec4f };
+@group(1) @binding(0) var src: texture_2d<f32>;
+@group(1) @binding(1) var samp: sampler;
+@group(1) @binding(2) var<uniform> params: Params;
+@group(2) @binding(0) var highlights: texture_2d<f32>;
+struct VOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f };
+@vertex fn vs(@builtin(vertex_index) i: u32) -> VOut {
+  let p = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
+  var o: VOut;
+  o.pos = vec4f(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);
+  o.uv = p;
+  return o;
+}
+// The game's values as light: as an SDR screen (or the TV the game was made
+// for) shows them, a plain 2.2 power curve. The sRGB curve's straight foot
+// lifts the darkest shades (7/255 four times as bright) and a dark game
+// looked washed out next to SDR. AURORA_HDR_SRGB_CURVE=1: the sRGB curve.
+const SRGB_CURVE: bool = false;
+fn to_linear(c: vec3f) -> vec3f {
+  let v = max(c, vec3f(0.0));
+  if (SRGB_CURVE) {
+    return select(pow((v + 0.055) / 1.055, vec3f(2.4)), v / 12.92, v <= vec3f(0.04045));
+  }
+  return pow(v, vec3f(2.2));
+}
+// d = (SDR white in nits, the display's peak in nits, black level, test
+// pattern). The surface's encoding of light in nits: extended linear sRGB
+// with 1.0 = LINEAR_NITS (macOS's EDR, 1.0 being the system's SDR white,
+// taken as 100; Windows' scRGB, 80); for HDR10, BT.709 to BT.2020 primaries
+// and the PQ curve (SMPTE ST 2084).
+const PQ_OUT: bool = false;
+const LINEAR_NITS: f32 = 100.0;
+fn encode_out(nits: vec3f) -> vec3f {
+  if (!PQ_OUT) {
+    return nits / LINEAR_NITS;
+  }
+  let m = mat3x3f(vec3f(0.6274040, 0.0690970, 0.0163916), vec3f(0.3292820, 0.9195400, 0.0880132),
+                  vec3f(0.0433136, 0.0113612, 0.8955950));
+  let y = clamp(m * nits / 10000.0, vec3f(0.0), vec3f(1.0));
+  let ym = pow(y, vec3f(0.1593017578125));
+  return pow((0.8359375 + 18.8515625 * ym) / (1.0 + 18.6875 * ym), vec3f(78.84375));
+}
+// Light past three quarters of the display's peak eases towards it rather
+// than clipping.
+fn shoulder(n: vec3f) -> vec3f {
+  let p = params.d.y;
+  let k = 0.75 * p;
+  return select(n, k + (p - k) * (1.0 - exp(-(n - k) / (p - k))), n > vec3f(k));
+}
+// Black level (calibration): lifts the darkest light (d.z > 0) or sinks it.
+fn black_level(lin: vec3f) -> vec3f {
+  let b = params.d.z;
+  if (b >= 0.0) {
+    return lin * (1.0 - b) + b;
+  }
+  return max(lin + b, vec3f(0.0)) / (1.0 + b);
+}
+// The calibration patterns: a ring in a box at the screen's centre.
+fn ring(uv: vec2f) -> bool {
+  let dims = vec2f(textureDimensions(efb_texture));
+  let p = (uv - 0.5) * vec2f(dims.x / max(dims.y, 1.0), 1.0);
+  return abs(length(p) - 0.07) < 0.018;
+}
+fn in_box(uv: vec2f) -> bool {
+  let dims = vec2f(textureDimensions(efb_texture));
+  let p = abs((uv - 0.5) * vec2f(dims.x / max(dims.y, 1.0), 1.0));
+  return p.x < 0.16 && p.y < 0.16;
+}
+fn tap(uv: vec2f, t: vec2f, x: f32, y: f32) -> vec3f {
+  return textureSampleLevel(src, samp, uv + t * vec2f(x, y), 0.0).rgb;
+}
+fn tent(uv: vec2f) -> vec3f {
+  let t = 1.0 / vec2f(textureDimensions(src));
+  return (tap(uv, t, -1.0, -1.0) + tap(uv, t, 1.0, -1.0) + tap(uv, t, -1.0, 1.0) + tap(uv, t, 1.0, 1.0)
+        + 2.0 * (tap(uv, t, 0.0, -1.0) + tap(uv, t, -1.0, 0.0) + tap(uv, t, 1.0, 0.0) + tap(uv, t, 0.0, 1.0))
+        + 4.0 * tap(uv, t, 0.0, 0.0)) / 16.0;
+}
+@fragment fn present(in: VOut) -> @location(0) vec4f {
+  let pattern = i32(params.d.w);
+  if (pattern == 1) {
+    // Peak: the box at the chosen peak, the ring at the most a signal can
+    // ask for; the ring disappears once the box reaches what the display shows.
+    var n = 0.0;
+    if (in_box(in.uv)) {
+      n = select(params.d.y, 10000.0, ring(in.uv));
+    }
+    return vec4f(encode_out(vec3f(n)), 1.0);
+  }
+  if (pattern == 4) {
+    // Brightness with no game picture yet (the launcher): eleven grey steps,
+    // black to SDR white, shown as the game's picture is.
+    let dims = vec2f(textureDimensions(efb_texture));
+    let p = (in.uv - 0.5) * vec2f(dims.x / max(dims.y, 1.0), 1.0);
+    var v = 0.0;
+    if (abs(p.y) < 0.09 && abs(p.x) < 0.55) {
+      v = min(floor((p.x + 0.55) / 0.1), 10.0) / 10.0;
+    }
+    return vec4f(encode_out(black_level(to_linear(vec3f(v))) * params.d.x), 1.0);
+  }
+  if (pattern == 3) {
+    // Black level with no game picture yet: eleven dark grey steps, black to
+    // 20/255, shown as the game's picture is.
+    let dims = vec2f(textureDimensions(efb_texture));
+    let p = (in.uv - 0.5) * vec2f(dims.x / max(dims.y, 1.0), 1.0);
+    var v = 0.0;
+    if (abs(p.y) < 0.09 && abs(p.x) < 0.55) {
+      v = min(floor((p.x + 0.55) / 0.1), 10.0) * 2.0 / 255.0;
+    }
+    return vec4f(encode_out(black_level(to_linear(vec3f(v))) * params.d.x), 1.0);
+  }
+  let c = textureSample(efb_texture, efb_sampler, in.uv).rgb;
+  let g = tent(in.uv) * params.a.x * params.c.y;
+  // The scene's highlights (never the HUD: they are taken before it) shine
+  // up to c.w past their SDR level.
+  let h = textureSampleLevel(highlights, samp, in.uv, 0.0).rgb;
+  let k = clamp(max(h.r, max(h.g, h.b)) / max(params.b.z * 0.5, 1e-3), 0.0, 1.0);
+  let lin = black_level(to_linear(c + g)) * (1.0 + params.c.w * k);
+  // A menu page (c.x): its white at video's white (c.z), not the paper white.
+  let white = select(params.d.x, params.c.z, params.c.x > 0.5);
+  return vec4f(encode_out(shoulder(lin * white)), 1.0);
+}
+// A page drawn over the picture (premultiplied alpha).
+@fragment fn overlay(in: VOut) -> @location(0) vec4f {
+  let c = textureSample(efb_texture, efb_sampler, in.uv);
+  let rgb = select(vec3f(0.0), encode_out(to_linear(c.rgb / c.a) * params.c.z) * c.a, c.a > 0.0);
+  return vec4f(rgb, c.a);
+}
+)";

+#elif defined(SDL_PLATFORM_LINUX)
+  // gamescope (Steam Deck Game Mode) offers the HDR10 surface only while its
+  // output is HDR (its Vulkan layer, ENABLE_GAMESCOPE_WSI=1). A desktop
+  // compositor offers it on SDR panels too and tone maps it (KDE on the
+  // Deck's own screen): HDR there only with AURORA_HDR_DESKTOP=1.
+  (void)window;
+  return SDL_getenv("GAMESCOPE_WAYLAND_DISPLAY") != nullptr || SDL_getenv("AURORA_HDR_DESKTOP") != nullptr;
+#else
+  (void)window;
+  return false;
+#endif
+}

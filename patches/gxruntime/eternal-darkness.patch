+void copy_draw_transform(ConsumedDraw& draw, const DrawTransformSnapshot& src) {
+  draw.transform_flags = src.transform_flags;
+  draw.current_pn_matrix = src.current_pn_matrix;
+  draw.payload_pn_matrix_mask = src.payload_pn_matrix_mask;
+  draw.position_matrix_valid_mask = src.position_matrix_valid_mask;
+  std::memcpy(draw.viewport, src.viewport, sizeof(draw.viewport));
+  std::memcpy(draw.projection, src.projection, sizeof(draw.projection));
+  draw.projection_type = src.projection_type;
+  draw.xf_block = src.xf;
+}

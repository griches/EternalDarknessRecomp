+// host's per-frame work that needs the window: menus, title). Single-threaded
+// runs leave the call to the host.
+void dol_aurora_set_frame_hook(void (*hook)(void));
+
+// Front-end support (launcher and in-game menu).
+// Present one frame with no guest work (the last display copy plus the UI
+// overlay) and pump events. Returns false once the window was closed.
+bool dol_aurora_ui_frame(void);
+// Ask the run loop to stop as if the window were closed (a clean shutdown
+// that waits for the render thread; exit() mid-frame races it).

+// The guest's VI choices, in plain fields so a state file does not depend on
+// GXRenderModeObj's layout. The host's configure_vi passes only these mode
+// fields, so they are the whole render mode.
+struct AuroraQuickState {
+    std::uint32_t has_render_mode;
+    std::uint32_t tv_mode;
+    std::uint16_t fb_width;
+    std::uint16_t efb_height;
+    std::uint16_t xfb_height;
+    std::uint16_t vi_width;
+    std::uint16_t vi_height;
+    std::uint16_t xfb_black;
+    std::uint32_t current_xfb;
+    std::uint32_t next_xfb;
+};
+
+size_t dol_aurora_state_size(void) {
+    return sizeof(AuroraQuickState);
+}
+
+void dol_aurora_state_save(void* out) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (gxq::on_game_thread()) {
+        gxq::call_sync([&] { dol_aurora_state_save(out); });
+        return;
+    }
+#endif
+    AuroraQuickState s{};
+    if (aurora::vi::g_renderMode) {
+        const GXRenderModeObj& mode = *aurora::vi::g_renderMode;
+        s.has_render_mode = 1u;
+        s.tv_mode = static_cast<std::uint32_t>(mode.viTVmode);
+        s.fb_width = mode.fbWidth;
+        s.efb_height = mode.efbHeight;
+        s.xfb_height = mode.xfbHeight;
+        s.vi_width = mode.viWidth;
+        s.vi_height = mode.viHeight;
+    }
+    s.xfb_black = aurora::vi::xfb_black() ? 1u : 0u;
+    s.current_xfb = static_cast<std::uint32_t>(
+        reinterpret_cast<uintptr_t>(VIGetCurrentFrameBuffer()));
+    s.next_xfb = static_cast<std::uint32_t>(
+        reinterpret_cast<uintptr_t>(VIGetNextFrameBuffer()));
+    std::memcpy(out, &s, sizeof s);
+}
+
+void dol_aurora_state_load(const void* in) {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    if (gxq::on_game_thread()) {
+        gxq::call_sync([&] { dol_aurora_state_load(in); });
+        return;
+    }
+#endif
+    if (!g_initialized || in == nullptr)
+        return;
+    AuroraQuickState s;
+    std::memcpy(&s, in, sizeof s);
+    if (s.has_render_mode != 0u) {
+        GXRenderModeObj mode{};
+        mode.viTVmode = static_cast<VITVMode>(s.tv_mode);
+        mode.fbWidth = s.fb_width;
+        mode.efbHeight = s.efb_height;
+        mode.xfbHeight = s.xfb_height;
+        mode.viWidth = s.vi_width;
+        mode.viHeight = s.vi_height;
+        aurora::vi::configure(&mode);
+    } else {
+        aurora::vi::configure(nullptr);
+    }
+    // VIFlush promotes the next buffer to current; replay that to set both.
+    VISetNextFrameBuffer(reinterpret_cast<void*>(
+        static_cast<uintptr_t>(s.current_xfb)));
+    VIFlush();
+    VISetNextFrameBuffer(reinterpret_cast<void*>(
+        static_cast<uintptr_t>(s.next_xfb)));
+    aurora::vi::set_xfb_black(s.xfb_black != 0u);
+}

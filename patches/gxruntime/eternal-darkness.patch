+// The VI retrace the game last saw (dol_aurora_note_retrace): its frames
+// start there, on an even beat, however long their work then takes.
+std::atomic<std::uint64_t> g_last_retrace_ns{0};
+
+void present() {
+    const std::uint64_t n = ++g_presents_queued;
+    const std::uint64_t now = SDL_GetTicksNS();
+    const std::uint64_t retrace = g_last_retrace_ns.load(std::memory_order_relaxed);
+    // No retrace seen yet, or a stale one (a long load): time from now.
+    const std::uint64_t t_frame =
+        retrace != 0u && retrace <= now && now - retrace < 50'000'000u ? retrace : now;
+    const PresentArgs args{n, t_frame};
+    append(Op::Present, &args, sizeof args);
+    publish();
+    const std::uint64_t t0 = SDL_GetTicksNS();
+    {
+        std::unique_lock<std::mutex> lock(g_mutex);
+        g_cv_game.wait(lock, [n] {
+            return g_presents_done + 1u >= n || g_should_quit.load();
+        });
+    }
+    g_wait_ns += SDL_GetTicksNS() - t0;
+}

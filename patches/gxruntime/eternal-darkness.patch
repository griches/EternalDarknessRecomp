+                                             plan.tlut_entries, plan.tlut_available);
+  const auto& tex = plan.textures[std::countr_zero(plan.texmap_mask)];
+  return tex.valid && emits_texture(tex.address, tex.format, tex.width, tex.height, tex.data, tex.available,
+                                    tex.has_tlut ? tex.tlut_data : nullptr, tex.tlut_entries, tex.tlut_available);

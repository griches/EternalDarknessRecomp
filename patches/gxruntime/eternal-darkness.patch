+  if (!sized || data == nullptr)
+    return false;
+  EmitSeen& seen = g_emitSeen[address & 0x01FFFFFFu];
+  const uint32_t frame = current_frame();
+  if (seen.frame != frame) {
+    seen.frame = frame;
+    const uint32_t base = gxc::texture_base_level_size(format, width, height);
+    seen.hash = base != 0u && base <= available ? XXH64(data, base, 0) : 0u;
+    const uint64_t palette =
+        tlut != nullptr ? XXH3_64bits(tlut, std::min(tlutEntries * 2u, tlutAvailable)) : 0u;
+    if (palette != seen.palette)

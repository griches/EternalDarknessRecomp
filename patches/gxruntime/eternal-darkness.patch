+// Decode thread: the next free slot (waits while the ring is full).
+RenderItem& ring_begin() {
+    const std::uint64_t tail = g_ring_tail.load(std::memory_order_relaxed);
+    if (tail - g_ring_head.load() >= kRingSlots) {
+        const std::uint64_t t0 = SDL_GetTicksNS();
+        if (spin_for([tail] { return tail - g_ring_head.load() < kRingSlots; }, spin_ns(2))) {
+            g_decode_full_ns += SDL_GetTicksNS() - t0;
+            return g_ring[tail % kRingSlots];
+        }
+        // Asleep, wait for a quarter of the ring rather than one slot: woken
+        // for every slot freed, the decoder refilled one and slept again, a
+        // wake-up per draw (5 ms a frame of the main thread on Windows in a
+        // scene of 15,000 draws).
+        const std::uint64_t room = std::max<std::uint64_t>(1u, kRingSlots / 4u);
+        std::unique_lock<std::mutex> lock(g_ring_mutex);
+        while (tail - g_ring_head.load() > kRingSlots - room) {
+            g_decode_waiting.store(true);
+            g_cv_ring_decode.wait_for(lock, std::chrono::milliseconds(2));
+        }
+        g_decode_waiting.store(false);
+        g_decode_full_ns += SDL_GetTicksNS() - t0;
+    }
+    return g_ring[tail % kRingSlots];
+}
+
+void ring_commit() {
+    g_ring_tail.store(g_ring_tail.load(std::memory_order_relaxed) + 1u);
+    if (g_main_waiting.load()) {
+        std::lock_guard<std::mutex> lock(g_ring_mutex);
+        g_cv_ring_main.notify_one();
+    }
+    // An awake worker picks the slot up (and wakes another for a backlog);
+    // only when all sleep does one need waking.
+    if (g_worker_count > 0 && g_workers_sleeping.load() == g_worker_count) {
+        std::lock_guard<std::mutex> lock(g_work_mutex);
+        g_cv_work.notify_one();
+    }
+}
+
+// Claim slot `seq` for planning; false when another thread already has it.
+bool claim(std::uint64_t seq) {
+    std::uint64_t expected = seq;
+    return g_plan_next.load() == seq &&
+           g_plan_next.compare_exchange_strong(expected, seq + 1u);
+}
+
+void plan_draw(RenderItem& item, gxruntime::gxcore::GapCounters& counters) {
+    item.state->build_draw_plan_into(item.plan, item.draw, counters, nullptr,
+                                    nullptr, /*record_cross=*/true);
+    gxruntime::gxcore::DrawPlan& plan = item.plan;
+    if (plan.ok) {
+        // The cached N/B/T are still zero here; finish_plan mixes them in.
+        // The XF block's shared part carries its own fingerprint.
+        plan.constants_hash =
+            gxruntime::gxcore::hash_bytes(&plan.constants, sizeof plan.constants);
+        plan.pixel_constants_hash = gxruntime::gxcore::hash_bytes(
+            &plan.pixel_constants, sizeof plan.pixel_constants);
+        plan.pipeline_hash =
+            gxruntime::gxcore::hash_bytes(&plan.pipeline, sizeof plan.pipeline);
+    }
+}
+
+// The fingerprint below hashes the three cached-attribute rows as one block.
+static_assert(offsetof(gxruntime::gxcore::VertexShaderConstants, cached_tangent) ==
+                  offsetof(gxruntime::gxcore::VertexShaderConstants, cached_normal) + 16 &&
+              offsetof(gxruntime::gxcore::VertexShaderConstants, cached_binormal) ==
+                  offsetof(gxruntime::gxcore::VertexShaderConstants, cached_normal) + 32);
+
+// Main thread, in stream order: the cross-draw caches, then the fingerprints
+// of whatever they changed.
+void finish_plan(gxruntime::gxcore::DrawPlan& plan) {
+    gxruntime::gxcore::finish_cross_draw(plan, g_plan_attrs, g_plan_zslope,
+                                         g_plan_counters);
+    if (!plan.ok || plan.constants_hash == 0u)
+        return;
+    if (plan.cross.recorded)
+        plan.constants_hash = gxruntime::gxcore::hash_bytes(
+            plan.constants.cached_normal,
+            sizeof plan.constants.cached_normal + sizeof plan.constants.cached_tangent +
+                sizeof plan.constants.cached_binormal,
+            plan.constants_hash);
+    if (plan.cross.zslope_needed) {
+        plan.pixel_constants_hash = gxruntime::gxcore::hash_bytes(
+            &plan.pixel_constants, sizeof plan.pixel_constants);
+        plan.pipeline_hash =
+            gxruntime::gxcore::hash_bytes(&plan.pipeline, sizeof plan.pipeline);
+    }
+}
+
+// Plan worker: claim the next unplanned slot and plan it if it is a draw.
+int SDLCALL plan_worker_main(void* user) {
+    use_performance_cores();
+    auto& counters = *static_cast<gxruntime::gxcore::GapCounters*>(user);
+    while (!g_workers_stop.load()) {
+        const std::uint64_t seq = g_plan_next.load();
+        if (seq < g_ring_tail.load()) {
+            if (!claim(seq))
+                continue;
+            if (g_ring_tail.load() - seq > 1u && g_workers_sleeping.load() > 0) {
+                std::lock_guard<std::mutex> lock(g_work_mutex);
+                g_cv_work.notify_one();
+            }
+            RenderItem& item = g_ring[seq % kRingSlots];
+            if (item.kind == Item::Draw && !g_should_quit.load()) {
+                const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                plan_draw(item, counters);
+                if (g_gx_time_log)
+                    g_worker_plan_ns += SDL_GetTicksNS() - t0;
+            }
+            item.plan_state.store(2, std::memory_order_release);
+            continue;
+        }
+        if (spin_for([] { return g_plan_next.load() < g_ring_tail.load() ||
+                                g_workers_stop.load(); },
+                     spin_ns(1)))
+            continue;
+        std::unique_lock<std::mutex> lock(g_work_mutex);
+        ++g_workers_sleeping;
+        if (g_plan_next.load() >= g_ring_tail.load() && !g_workers_stop.load())
+            g_cv_work.wait_for(lock, std::chrono::milliseconds(2));
+        --g_workers_sleeping;
+    }
+    return 0;
+}
+
+// Decode thread: the slot the sink is building the current draw in, until
+// the draw is complete and committed (defer_draw).
+RenderItem* g_reserved = nullptr;
+
+RenderItem& ring_item(Item kind) {
+    // Anything queued after a draw follows it: complete and commit the draw
+    // first (its spans are all in by the time the game makes another call).
+    if (g_reserved != nullptr)
+        g_core_sink.flush_frame();
+    RenderItem& item = ring_begin();
+    item.kind = kind;
+    item.plan_state.store(0, std::memory_order_relaxed);
+    return item;
+}
+
+// Main thread: the next filled slot, pumping window events while it waits.
+RenderItem& ring_next() {
+    const std::uint64_t head = g_ring_head.load(std::memory_order_relaxed);
+    if (g_ring_tail.load() == head) {
+        const std::uint64_t t0 = SDL_GetTicksNS();
+        if (spin_for([head] { return g_ring_tail.load() != head; }, spin_ns(2))) {
+            g_idle_ns += SDL_GetTicksNS() - t0;
+            return g_ring[head % kRingSlots];
+        }
+        std::unique_lock<std::mutex> lock(g_ring_mutex);
+        g_main_waiting.store(true);
+        while (g_ring_tail.load() == head) {
+            g_cv_ring_main.wait_for(lock, std::chrono::milliseconds(4));
+            if (g_ring_tail.load() == head) {
+                // Loading or waiting on the disc: keep the window alive.
+                lock.unlock();
+                dol_aurora_pump_events_if_idle();
+                lock.lock();
+            }
+        }
+        g_main_waiting.store(false);
+        g_idle_ns += SDL_GetTicksNS() - t0;
+    }
+    return g_ring[head % kRingSlots];
+}
+
+void ring_release() {
+    const std::uint64_t head = g_ring_head.load(std::memory_order_relaxed) + 1u;
+    g_ring_head.store(head);
+    // The decoder sleeps until a quarter of the ring is free (ring_begin):
+    // wake it once then, not for every slot.
+    if (g_decode_waiting.load() &&
+        g_ring_tail.load() - head <= kRingSlots - std::max<std::uint64_t>(1u, kRingSlots / 4u) &&
+        g_decode_waiting.exchange(false)) {
+        std::lock_guard<std::mutex> lock(g_ring_mutex);
+        g_cv_ring_decode.notify_one();
+    }
+}
+
+// GxCoreSink storage and observers on the decode thread: each draw and its
+// register state are built straight into a ring slot, committed once the
+// draw is complete; EFB copies follow in order.
+gxruntime::aurora_recomp::ConsumedDraw* reserve_draw(void*) {
+    RenderItem& item = ring_begin();
+    item.kind = Item::Draw;
+    item.plan_state.store(0, std::memory_order_relaxed);
+    g_reserved = &item;
+    return &item.draw;
+}
+
+std::shared_ptr<const gxruntime::gxcore::GxCoreState>* reserved_state(void*) {
+    return &g_reserved->state;
+}
+
+void defer_draw(const gxruntime::gxcore::GxCoreState&,
+                const gxruntime::aurora_recomp::ConsumedDraw&, void*) {
+    g_reserved = nullptr;
+    ring_commit();
+}
+
+void defer_copy(const gxruntime::gxcore::EfbCopyCommand& cmd, void*) {
+    ring_item(Item::EfbCopy).copy = cmd;
+    ring_commit();
+}
+
+// Decode thread: one chunk of the game's GX calls.
+void replay(const std::vector<std::uint8_t>& chunk) {
+    std::size_t at = 0;
+    while (at + sizeof(Header) <= chunk.size()) {
+        const Header h = read_args<Header>(chunk.data() + at);
+        const std::uint8_t* p = chunk.data() + at + sizeof(Header);
+        at += sizeof(Header) + h.size;
+        // Once quitting, only what the game thread waits on still runs.
+        const bool live = !g_should_quit.load();
+        switch (h.op) {
+        case Op::GxBytes:
+            if (live) {
+                g_fifo_bytes += h.size;
+                if (g_shadow_frontend_enabled && !g_shadow_frontend_failed) {
+                    const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                    shadow_frontend_core_write(std::span<const std::uint8_t>(p, h.size));
+                    if (g_gx_time_log)
+                        g_gx_time_ns += SDL_GetTicksNS() - t0;
+                }
+            }
+            break;
+        case Op::CallDisplayList:
+            if (live) {
+                const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                aurora_backend_call_display_list(p, h.size);
+                if (g_gx_time_log)
+                    g_gx_time_ns += SDL_GetTicksNS() - t0;
+            }
+            break;
+        case Op::SetArray: {
+            const auto a = read_args<SetArrayArgs>(p);
+            if (live && g_initialized && a.data != nullptr) {
+                // The frontend's copy here; Aurora's own GX state on main.
+                if (a.guest != 0u)
+                    shadow_frontend_set_array(a.attr, a.guest, a.stride);
+                ring_item(Item::SetArray).set_array = a;
+                ring_commit();
+            }
+            break;
+        }
+        case Op::CopyDest:
+            if (live) {
+                ring_item(Item::CopyDest).copy_dest = read_args<CopyDestArgs>(p);
+                ring_commit();
+            }
+            break;
+        case Op::ConfigureVi:
+            ring_item(Item::ConfigureVi).vi = read_args<ViArgs>(p);
+            ring_commit();
+            break;
+        case Op::SetNextXfb:
+            ring_item(Item::SetNextXfb).value = read_args<u32>(p);
+            ring_commit();
+            break;
+        case Op::FlushXfb:
+            ring_item(Item::FlushXfb);
+            ring_commit();
+            break;
+        case Op::SetXfbBlack:
+            ring_item(Item::SetXfbBlack).flag = read_args<bool>(p);
+            ring_commit();
+            break;
+        case Op::Present:
+            // The frame's last draw is planned at the frame boundary.
+            if (live && !g_shadow_frontend_failed)
+                g_core_sink.flush_frame();
+            {
+                const auto args = read_args<PresentArgs>(p);
+                RenderItem& item = ring_item(Item::Present);
+                item.n = args.n;
+                item.t_game = args.t_game;
+            }
+            ring_commit();
+            break;
+        case Op::Call: {
+            // Runs on the main thread while this thread waits, so it may
+            // touch the frontend as well as Aurora.
+            ring_item(Item::Call).fn = read_args<const std::function<void()>*>(p);
+            ring_commit();
+            const std::uint64_t id = ++g_calls_forwarded;
+            std::unique_lock<std::mutex> lock(g_mutex);
+            g_cv_game.wait(lock, [id] { return g_calls_done >= id; });
+            break;
+        }
+        }
+    }
+}
+
+// Decode thread: replay the game's chunks until it has finished.
+int SDLCALL decode_thread_main(void*) {
+    use_performance_cores();
+    for (;;) {
+        std::vector<std::uint8_t> chunk;
+        {
+            std::unique_lock<std::mutex> lock(g_mutex);
+            g_cv_main.wait(lock, [] { return !g_ready.empty() || g_game_done; });
+            if (g_ready.empty())
+                break;
+            chunk = std::move(g_ready.front());
+            g_ready.pop_front();
+        }
+        g_cv_game.notify_all();
+        replay(chunk);
+        chunk.clear();
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_free.push_back(std::move(chunk));
+    }
+    ring_item(Item::Done);
+    ring_commit();
+    return 0;
+}
+
+// Frame pacer (main thread). The game starts its frames on an even beat (its
+// VI retrace), but its own work and then the decode and plan stages take a
+// varying time, so presenting each frame as soon as it is ready lands frames
+// 15 and 19 ms apart, which a 120 Hz display shows as judder. Present instead
+// a steady delay after the retrace that began the frame: just over the
+// slowest of the last second's frames, and not so long that the game (one
+// frame ahead) would wait at its next present for this one. A frame later than
+// that is shown at once. DOL_GX_PACE=0: off.
+std::uint64_t g_pace_ns = 0;  // waited this frame, for DOL_GX_TIME
+std::uint64_t g_pace_lat_ns = 0;  // retrace to ready, this frame
+
+void pace_present(std::uint64_t t_game) {
+    static const bool off = [] {
+        const char* env = std::getenv("DOL_GX_PACE");
+        return env != nullptr && std::strcmp(env, "0") == 0;
+    }();
+    g_pace_ns = 0;
+    if (off || t_game == 0u)
+        return;
+    constexpr int kWindow = 60;
+    static std::uint64_t latency[kWindow];
+    static int count = 0;
+    static int next = 0;
+    const std::uint64_t now = SDL_GetTicksNS();
+    const std::uint64_t lat = now > t_game ? now - t_game : 0u;
+    g_pace_lat_ns = lat;
+    std::uint64_t worst = lat;
+    for (int i = 0; i < count; ++i)
+        worst = std::max(worst, latency[i]);
+    latency[next] = lat;
+    next = (next + 1) % kWindow;
+    count = std::min(count + 1, kWindow);
+    // The game waits at its next present (a frame plus its work after this
+    // retrace) until this one is shown, so up to ~two frames from the retrace
+    // never holds back its next frame (DOL_GX_PACE_MAX_US).
+    static const std::uint64_t cap = [] {
+        const char* env = std::getenv("DOL_GX_PACE_MAX_US");
+        return env != nullptr ? std::strtoull(env, nullptr, 10) * 1000u : 30'000'000u;
+    }();
+    const std::uint64_t delay = std::min<std::uint64_t>(worst + 500'000u, cap);
+    const std::uint64_t target = t_game + delay;
+    if (target > now) {
+        SDL_DelayPrecise(target - now);
+        g_pace_ns = target - now;
+    }
+}
+
+// Main thread: plan, submit and present until the decode thread is done.
+void run_main() {
+#ifdef _WIN32
+    prefer_performance_cores();
+#endif
+    for (;;) {
+        const std::uint64_t t_loop0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+        RenderItem& item = ring_next();
+        const std::uint64_t t_loop1 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+        const bool live = !g_should_quit.load();
+        // Plan the draw here unless a worker got to it first; then wait for
+        // the worker before the slot is reused.
+        const std::uint64_t seq = g_ring_head.load(std::memory_order_relaxed);
+        const bool mine = claim(seq);
+        if (mine) {
+            if (item.kind == Item::Draw && live) {
+                const std::uint64_t t0 = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+                plan_draw(item, g_plan_counters);
+                if (g_gx_time_log)
+                    gxruntime::gxcore::g_plan_time_ns += SDL_GetTicksNS() - t0;
+            }
+        } else if (item.plan_state.load(std::memory_order_acquire) != 2) {
+            // A worker is mid-plan: usually done within microseconds, so
+            // spin first (a yield per check is a system call each).
+            const std::uint64_t t0 = SDL_GetTicksNS();
+            auto planned = [&item] {
+                return item.plan_state.load(std::memory_order_acquire) == 2;
+            };
+            if (!spin_for(planned, 200'000u))
+                while (!planned())
+                    std::this_thread::yield();
+            g_plan_wait_ns += SDL_GetTicksNS() - t0;
+        }
+        // DOL_GX_TIME: the main thread's time by kind of item (draw, EFB copy,
+        // other), and how many of each, per frame.
+        const std::uint64_t t_item = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+        if (g_gx_time_log) {
+            g_main_next_ns += t_loop1 - t_loop0;
+            g_main_pre_ns += t_item - t_loop1;
+        }
+        const Item kind = item.kind;
+        switch (item.kind) {
+        case Item::Draw:
+            if (live) {
+                finish_plan(item.plan);
+                core_plan_observer(item.plan, nullptr);
+            }
+            break;
+        case Item::EfbCopy:
+            if (live)
+                aurora::gfx::gxcore::copy_efb_to_texture(item.copy);
+            break;
+        case Item::SetArray:
+            if (live)
+                GXSetArray(static_cast<GXAttr>(item.set_array.attr), item.set_array.data,
+                           item.set_array.size, item.set_array.stride, false);
+            break;
+        case Item::CopyDest:
+            if (live)
+                aurora_backend_set_copy_destination_guest(item.copy_dest.guest,
+                                                          item.copy_dest.data);
+            break;
+        case Item::ConfigureVi:
+            aurora_backend_configure_vi(item.vi.tv_mode, item.vi.fb_width,
+                                        item.vi.efb_height, item.vi.xfb_height,
+                                        item.vi.vi_width, item.vi.vi_height);
+            break;
+        case Item::SetNextXfb:
+            aurora_backend_set_next_xfb(item.value);
+            break;
+        case Item::FlushXfb:
+            aurora_backend_flush_xfb();
+            break;
+        case Item::SetXfbBlack:
+            aurora_backend_set_xfb_black(item.flag);
+            break;
+        case Item::Present:
+            if (live) {
+                pace_present(item.t_game);
+                const std::uint64_t t0 = SDL_GetTicksNS();
+                aurora_backend_present();
+                g_present_ns = SDL_GetTicksNS() - t0;
+                if (g_frame_hook != nullptr)
+                    g_frame_hook();
+            }
+            {
+                std::lock_guard<std::mutex> lock(g_mutex);
+                g_presents_done = item.n;
+            }
+            g_cv_game.notify_all();
+            break;
+        case Item::Call:
+            (*item.fn)();
+            {
+                std::lock_guard<std::mutex> lock(g_mutex);
+                ++g_calls_done;
+            }
+            g_cv_game.notify_all();
+            break;
+        case Item::Done:
+            ring_release();
+            return;
+        }
+        if (g_gx_time_log) {
+            const int k = kind == Item::Draw      ? 0
+                          : kind == Item::EfbCopy ? 1
+                          : kind == Item::Present ? 2
+                                                  : 3;
+            g_item_ns[k] += SDL_GetTicksNS() - t_item;
+            ++g_item_count[k];
+        }
+        const std::uint64_t t_rel = g_gx_time_log ? SDL_GetTicksNS() : 0u;
+        ring_release();
+        if (g_gx_time_log)
+            g_main_release_ns += SDL_GetTicksNS() - t_rel;
+    }
+}
+
+struct GameRun {
+    int (*fn)(void*);
+    void* arg;
+    int result;
+};
+
+int SDLCALL game_thread_main(void* user) {
+    auto* run = static_cast<GameRun*>(user);
+    t_game_thread = true;
+    use_performance_cores();
+    run->result = run->fn(run->arg);
+    publish();
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_game_done = true;
+    }
+    g_cv_main.notify_all();
+    t_game_thread = false;
+    return 0;
+}
+
+bool wanted() {
+#if GXRUNTIME_HAS_AURORA_RECOMP
+    const char* env = std::getenv("DOL_GX_THREAD");
+    if (env != nullptr && std::strcmp(env, "0") == 0)
+        return false;
+    // Trace recording interleaves FIFO records with the memory the decode
+    // resolves, which needs the decode inside the write.
+    return g_initialized && g_gx_core_enabled && g_shadow_frontend_enabled &&
+           !g_trace_armed;
+#else
+    return false;
+#endif
+}

+// The mark recorder (dol_aurora_mark): every frame's timing, audio queue and
+// pipeline waits, and the audio itself, kept for the last ~17 s; a mark
+// writes out the span from 5 s before it to 7 s after (the log, and
+// logs/mark-<n>.wav), to time a glitch someone saw or heard as it happened.
+namespace mark {
+struct Frame {
+    std::uint64_t t_ns;
+    std::uint64_t present;
+    std::uint64_t wait_us;   // totals since start: draws waiting for pipelines,
+    std::uint64_t skipped;   // draws skipped while one compiled,
+    std::uint32_t built;     // pipelines built
+    std::uint32_t queued;    // now: pipelines waiting to compile
+    std::uint32_t audio_min_us;  // during the frame: least audio queued,
+    std::uint32_t audio_gap_us;  // longest gap between pushes,
+    std::uint32_t audio_drops;   // chunks dropped (output not draining)
+    std::uint32_t audio_dry;     // dry-outs (playback paused to refill)
+};
+constexpr double kBeforeS = 5.0, kAfterS = 7.0;
+constexpr std::size_t kFrames = 1024;
+constexpr std::size_t kAudioSeconds = 16;
+Frame g_frames[kFrames];
+std::size_t g_frame_count = 0;
+std::atomic<int> g_requests{0};
+std::atomic<std::uint32_t> g_audio_min_us{UINT32_MAX};
+std::atomic<std::uint32_t> g_audio_gap_us{0};
+std::atomic<std::uint32_t> g_audio_drops{0};
+std::atomic<std::uint32_t> g_audio_dry{0};
+std::mutex g_audio_mutex;
+std::vector<s16> g_audio;           // stereo ring, kAudioSeconds at 48 kHz
+std::uint64_t g_audio_written = 0;  // stereo frames pushed in all
+u32 g_audio_rate = 32000;
+struct Pending {
+    int id;
+    std::uint64_t t_ns;
+};
+std::vector<Pending> g_pending;
+int g_next_id = 1;
+
+void note_audio(std::uint32_t queued_us, std::uint32_t gap_us) {
+    std::uint32_t v = g_audio_min_us.load(std::memory_order_relaxed);
+    while (queued_us < v && !g_audio_min_us.compare_exchange_weak(v, queued_us)) {
+    }
+    v = g_audio_gap_us.load(std::memory_order_relaxed);
+    while (gap_us > v && !g_audio_gap_us.compare_exchange_weak(v, gap_us)) {
+    }
+}
+
+void keep_audio(const s16* samples, u32 frames, u32 rate) {
+    std::lock_guard<std::mutex> lock(g_audio_mutex);
+    const std::size_t ring = kAudioSeconds * 48000u;
+    if (g_audio.empty())
+        g_audio.resize(ring * 2u);
+    g_audio_rate = rate;
+    for (u32 i = 0; i < frames; i++) {
+        const std::size_t at = (g_audio_written + i) % ring;
+        g_audio[at * 2u] = samples[i * 2u];
+        g_audio[at * 2u + 1u] = samples[i * 2u + 1u];
+    }
+    g_audio_written += frames;
+}
+
+void write_wav(const std::string& path, const std::vector<s16>& pcm, u32 rate) {
+    FILE* f = std::fopen(path.c_str(), "wb");
+    if (f == nullptr) {
+        std::fprintf(stderr, "[mark] could not write %s\n", path.c_str());
+        return;
+    }
+    const std::uint32_t data = static_cast<std::uint32_t>(pcm.size() * sizeof(s16));
+    auto u32le = [&](std::uint32_t v) {
+        const unsigned char b[4] = {static_cast<unsigned char>(v), static_cast<unsigned char>(v >> 8),
+                                    static_cast<unsigned char>(v >> 16), static_cast<unsigned char>(v >> 24)};
+        std::fwrite(b, 1, 4, f);
+    };
+    auto u16le = [&](std::uint16_t v) {
+        const unsigned char b[2] = {static_cast<unsigned char>(v), static_cast<unsigned char>(v >> 8)};
+        std::fwrite(b, 1, 2, f);
+    };
+    std::fwrite("RIFF", 1, 4, f);
+    u32le(36u + data);
+    std::fwrite("WAVEfmt ", 1, 8, f);
+    u32le(16u);
+    u16le(1u);
+    u16le(2u);
+    u32le(rate);
+    u32le(rate * 4u);
+    u16le(4u);
+    u16le(16u);
+    std::fwrite("data", 1, 4, f);
+    u32le(data);
+    std::fwrite(pcm.data(), sizeof(s16), pcm.size(), f);  // little-endian hosts
+    std::fclose(f);
+}
+
+void dump(const Pending& m, std::uint64_t now_ns) {
+    const double from_s = -kBeforeS;
+    std::fprintf(stderr, "[mark %d] frames from %.0f s before the mark to %.0f s after:\n", m.id,
+                 kBeforeS, kAfterS);
+    std::fprintf(stderr,
+                 "[mark %d]     time  present    dt ms  audio ms  push gap  wait ms  skip  built  queue\n",
+                 m.id);
+    const std::size_t have = std::min(g_frame_count, kFrames);
+    const Frame* prev = nullptr;
+    double worst_dt = 0.0, least_audio = 1e9, wait_total = 0.0;
+    std::uint64_t skips = 0, built = 0, drops = 0, dries = 0;
+    for (std::size_t i = g_frame_count - have; i < g_frame_count; i++) {
+        const Frame& f = g_frames[i % kFrames];
+        const double rel = (static_cast<double>(f.t_ns) - static_cast<double>(m.t_ns)) / 1e9;
+        if (rel < from_s || rel > kAfterS) {
+            prev = &f;
+            continue;
+        }
+        if (prev == nullptr) {
+            prev = &f;
+            continue;
+        }
+        const double dt = (f.t_ns - prev->t_ns) / 1e6;
+        const double wait = (f.wait_us - prev->wait_us) / 1e3;
+        const std::uint64_t skip = f.skipped - prev->skipped;
+        const std::uint32_t made = f.built - prev->built;
+        const double audio = f.audio_min_us == UINT32_MAX ? -1.0 : f.audio_min_us / 1e3;
+        worst_dt = std::max(worst_dt, dt);
+        if (audio >= 0.0)
+            least_audio = std::min(least_audio, audio);
+        wait_total += wait;
+        skips += skip;
+        built += made;
+        drops += f.audio_drops;
+        dries += f.audio_dry;
+        std::fprintf(stderr,
+                     "[mark %d] %+8.3fs %8llu %8.1f %9.1f %9.1f %8.1f %5llu %6u %6u%s%s%s%s\n",
+                     m.id, rel, static_cast<unsigned long long>(f.present), dt, audio,
+                     f.audio_gap_us / 1e3, wait, static_cast<unsigned long long>(skip), made,
+                     f.queued, dt > 25.0 ? "  SLOW" : "", f.audio_dry != 0 ? "  DRY" : "",
+                     f.audio_drops != 0 ? "  DROP" : "", skip != 0 ? "  SKIP" : "");
+        prev = &f;
+    }
+    std::fprintf(stderr,
+                 "[mark %d] summary: slowest frame %.1f ms, least audio %.1f ms, %u dry, %u dropped, "
+                 "%.1f ms waiting for %llu pipelines built, %llu draws skipped\n",
+                 m.id, worst_dt, least_audio, static_cast<unsigned>(dries),
+                 static_cast<unsigned>(drops), wait_total, static_cast<unsigned long long>(built),
+                 static_cast<unsigned long long>(skips));
+    // The audio pushed over the same span (it plays a queue's length later).
+    std::vector<s16> pcm;
+    u32 rate;
+    {
+        std::lock_guard<std::mutex> lock(g_audio_mutex);
+        rate = g_audio_rate;
+        const std::size_t ring = kAudioSeconds * 48000u;
+        const double span_s = (static_cast<double>(now_ns) - static_cast<double>(m.t_ns)) / 1e9 + kBeforeS;
+        std::uint64_t frames = static_cast<std::uint64_t>(span_s * rate);
+        frames = std::min<std::uint64_t>({frames, g_audio_written, ring});
+        pcm.resize(frames * 2u);
+        for (std::uint64_t i = 0; i < frames; i++) {
+            const std::size_t at = (g_audio_written - frames + i) % ring;
+            pcm[i * 2u] = g_audio[at * 2u];
+            pcm[i * 2u + 1u] = g_audio[at * 2u + 1u];
+        }
+    }
+    const char* dir_env = std::getenv("ED_MARK_DIR");
+    const std::string dir = dir_env != nullptr && dir_env[0] != '\0' ? dir_env : "logs";
+#if defined(_WIN32)
+    CreateDirectoryA(dir.c_str(), nullptr);
+#else
+    mkdir(dir.c_str(), 0755);
+#endif
+    const std::string path = dir + "/mark-" + std::to_string(m.id) + ".wav";
+    std::fprintf(stderr, "[mark %d] audio: %s (%.1f s, the mark %.1f s in)\n", m.id, path.c_str(),
+                 pcm.size() / 2.0 / rate, std::min(kBeforeS, pcm.size() / 2.0 / rate));
+    std::thread([path, pcm = std::move(pcm), rate] { write_wav(path, pcm, rate); }).detach();
+}
+
+// Each present: record the frame, take new marks, write out finished ones.
+void record_frame() {
+    const std::uint64_t now = SDL_GetTicksNS();
+    Frame& f = g_frames[g_frame_count % kFrames];
+    f.t_ns = now;
+    f.present = g_present_count;
+    aurora_get_pipeline_wait_totals(&f.wait_us, &f.skipped);
+    const AuroraStats* stats = aurora_get_stats();
+    f.built = stats != nullptr ? stats->createdPipelines : 0u;
+    f.queued = stats != nullptr ? stats->queuedPipelines : 0u;
+    f.audio_min_us = g_audio_min_us.exchange(UINT32_MAX, std::memory_order_relaxed);
+    f.audio_gap_us = g_audio_gap_us.exchange(0, std::memory_order_relaxed);
+    f.audio_drops = g_audio_drops.exchange(0, std::memory_order_relaxed);
+    f.audio_dry = g_audio_dry.exchange(0, std::memory_order_relaxed);
+    g_frame_count++;
+    for (int n = g_requests.exchange(0); n > 0; n--) {
+        const Pending m{g_next_id++, now};
+        g_pending.push_back(m);
+        std::fprintf(stderr, "[mark %d] marked at %.3f s (present %llu); writing it out in %.0f s\n",
+                     m.id, now / 1e9, g_present_count, kAfterS);
+    }
+    while (!g_pending.empty() &&
+           now >= g_pending.front().t_ns + static_cast<std::uint64_t>(kAfterS * 1e9)) {
+        dump(g_pending.front(), now);
+        g_pending.erase(g_pending.begin());
+    }
+}

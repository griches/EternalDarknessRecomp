+  out.push_back(static_cast<std::uint8_t>(value >> 16u));
+  out.push_back(static_cast<std::uint8_t>(value >> 8u));
+  out.push_back(static_cast<std::uint8_t>(value));
+}
+
+void emit_cp(std::vector<std::uint8_t>& out, std::uint8_t reg,
+             std::uint32_t value) {
+  out.push_back(DOL_GX_CMD_LOAD_CP_REG);
+  out.push_back(reg);
+  put_be32(out, value);
+}
+
+void emit_bp(std::vector<std::uint8_t>& out, std::uint8_t reg,
+             std::uint32_t value) {
+  out.push_back(DOL_GX_CMD_LOAD_BP_REG);
+  put_be32(out, (static_cast<std::uint32_t>(reg) << 24u) | (value & 0x00FFFFFFu));
+}
+
+struct XfWord {
+  std::uint16_t address;
+  std::uint32_t value;
+};
+
+std::uint32_t f32_bits(float value) {
+  std::uint32_t bits = 0;
+  std::memcpy(&bits, &value, sizeof bits);
+  return bits;
+}
+
+// Contiguous words become one XF load each, at most 16 words long (the parser
+// keeps the count in a byte).
+void emit_xf(std::vector<std::uint8_t>& out, const std::vector<XfWord>& words) {
+  std::size_t i = 0;
+  while (i < words.size()) {
+    std::size_t n = 1;
+    while (i + n < words.size() && n < 16u &&
+           words[i + n].address == words[i].address + n)
+      ++n;
+    out.push_back(DOL_GX_CMD_LOAD_XF_REG);
+    put_be32(out, (static_cast<std::uint32_t>(n - 1u) << 16u) |
+                      words[i].address);
+    for (std::size_t k = 0; k < n; ++k)
+      put_be32(out, words[i + k].value);
+    i += n;
+  }
+}
+
+// BP writes that do work rather than set state (Dolphin's FifoPlayer skips
+// the same): draw done, tokens, EFB copy, bbox and perf clears, TMEM preload,
+// TLUT load (repeated separately), texture invalidate, and the BP mask.
+bool bp_is_trigger(std::uint32_t reg) {
+  switch (reg) {
+  case 0x45u: case 0x47u: case 0x48u: case 0x52u: case 0x55u: case 0x56u:
+  case 0x57u: case 0x63u: case 0x65u: case 0x66u: case 0x67u: case 0xFEu:
+    return true;
+  default:
+    return false;
+  }
+}

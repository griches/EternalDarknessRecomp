+bool save_png_rgb(const std::filesystem::path& path, const uint8_t* rgb, uint32_t width, uint32_t height) noexcept {
+  FILE* file = nullptr;
+#ifdef _WIN32
+  file = _wfopen(path.c_str(), L"wb");
+#else
+  file = std::fopen(path.c_str(), "wb");

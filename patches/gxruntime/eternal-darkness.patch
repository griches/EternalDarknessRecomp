+// Old-ucode mixer_control to the newer bit layout used below (Dolphin
+// AXUCode::ConvertMixerControl): main L/R always mix; bit 4 selects DPL2.
+// New layout: 0x1/0x2/0x4 main L/R/S, 0x8 main ramp, 0x10/0x20/0x80 auxA
+// L/R/S, 0x40 auxA ramp, 0x100 auxA-S ramp, 0x200/0x400/0x1000 auxB L/R/S,
+// 0x800 auxB ramp, 0x2000 auxB-S ramp.
+static u16 convert_old_mixer_control(u16 mc) {
+    u16 ret = 0x0001u | 0x0002u;
+    if (mc & 0x0010u) {
+        if ((mc & 0x0006u) == 0)
+            ret |= 0x0200u | 0x0400u;
+        if ((mc & 0x0007u) == 1)
+            ret |= 0x0010u | 0x0020u | 0x0080u;
+    } else {
+        if (mc & 0x0001u)
+            ret |= 0x0010u | 0x0020u;
+        if (mc & 0x0002u)
+            ret |= 0x0200u | 0x0400u;
+        if (mc & 0x0004u) {
+            ret |= 0x0004u;
+            if (ret & 0x0010u)
+                ret |= 0x0080u;
+            if (ret & 0x0200u)
+                ret |= 0x1000u;
+        }
+    }
+    if (mc & 0x0008u)
+        ret |= 0x0008u | 0x0040u | 0x0100u | 0x0800u | 0x2000u;
+    return ret;
+}

+// NDC x shift for one draw (0: leave it), its projection's x scaled by xs.
+float widescreen_hud_shift(const gxc::DrawPlan& plan, float xs) {
+  const auto& P = plan.constants.projection;
+  if (!g_widescreenHud || P[3][2] != 0.f || P[3][3] != 1.f || P[0][0] <= 0.f)
+    return 0.f;
+  // The HUD space's edges in NDC; a squeezed HUD is symmetric and inside +-1.
+  const float left = P[0][3] * xs;
+  const float right = (P[0][0] * 640.f + P[0][3]) * xs;
+  if (left < -0.97f || right > 0.97f || left > -0.5f || std::fabs(left + right) > 0.05f)
+    return 0.f;
+  const float spare = 1.f - right;
+  const auto& M = plan.constants.posnormalmatrix;
+  float x0 = 1e9f, x1 = -1e9f, y0 = 1e9f, y1 = -1e9f;
+  for (uint32_t v = 0; v < plan.vertex_count; ++v) {
+    const float* p = plan.vertices.data() + static_cast<size_t>(v) * gxc::kVertexFloats;
+    const float vx = M[0][0] * p[0] + M[0][1] * p[1] + M[0][2] * p[2] + M[0][3];
+    const float vy = M[1][0] * p[0] + M[1][1] * p[1] + M[1][2] * p[2] + M[1][3];
+    const float nx = (P[0][0] * vx + P[0][3]) * xs;
+    x0 = std::min(x0, nx);
+    x1 = std::max(x1, nx);
+    y0 = std::min(y0, vy);
+    y1 = std::max(y1, vy);
+  }
+  if (x0 > x1)
+    return 0.f;
+  const int b0 = std::clamp(static_cast<int>(y0 / 8.f), 0, kHudBands - 1);
+  const int b1 = std::clamp(static_cast<int>(y1 / 8.f), 0, kHudBands - 1);
+  const bool crossesCentre = x0 < 0.25f && x1 > -0.25f;
+  bool bandHasCentre = false;
+  for (int b = b0; b <= b1; ++b) {
+    if (crossesCentre)
+      g_hudCentreNow[b] = true;
+    bandHasCentre = bandHasCentre || g_hudCentrePrev[b] || g_hudCentreNow[b];
+  }
+  if (bandHasCentre)
+    return 0.f;
+  if (x0 > 0.25f)
+    return spare;
+  if (x1 < -0.25f)
+    return -spare;
+  return 0.f;
+}

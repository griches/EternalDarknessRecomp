+namespace aurora::gfx::ssao {
+namespace {
+using webgpu::g_device;
+using webgpu::g_queue;
+
+constexpr auto kAoFormat = wgpu::TextureFormat::R16Float;
+
+// DEPTH_TYPE: texture_depth_2d, or _multisampled_2d with MSAA (textureLoad's
+// third argument is then the sample, 0).
+constexpr const char* kShader = R"(
+struct Params { proj: vec4f, depth: vec4f, vp: vec4f, misc: vec4f, size: vec4f };
+@group(0) @binding(0) var depthTex: DEPTH_TYPE;
+@group(0) @binding(1) var aoTex: texture_2d<f32>;
+@group(0) @binding(2) var samp: sampler;
+@group(0) @binding(3) var<uniform> P: Params;
+@group(0) @binding(4) var colorTex: texture_2d<f32>;
+struct VOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f };
+@vertex fn vs(@builtin(vertex_index) i: u32) -> VOut {
+  let p = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
+  var o: VOut;
+  o.pos = vec4f(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);
+  o.uv = p;
+  return o;
+}
+fn depth_at(p: vec2i) -> f32 {
+  let q = clamp(p, vec2i(0), vec2i(P.size.xy) - vec2i(1));
+  return textureLoad(depthTex, q, 0);
+}
+// Reversed Z: the cleared far plane is 0 (sky, no occlusion).
+fn view_z(d: f32) -> f32 {
+  let n = (d - P.depth.z) / (P.depth.w - P.depth.z);
+  return P.depth.y / (n - P.depth.x);
+}
+fn view_pos(p: vec2f, d: f32) -> vec3f {
+  let z = view_z(d);
+  let nx = (p.x - P.vp.x) / P.vp.z * 2.0 - 1.0;
+  let ny = 1.0 - (p.y - P.vp.y) / P.vp.w * 2.0;
+  return vec3f(-z * (nx + P.proj.y) / P.proj.x, -z * (ny + P.proj.w) / P.proj.z, z);
+}
+fn to_pixel(v: vec3f) -> vec2f {
+  let nx = -v.x * P.proj.x / v.z - P.proj.y;
+  let ny = -v.y * P.proj.z / v.z - P.proj.w;
+  return vec2f(P.vp.x + (nx + 1.0) * 0.5 * P.vp.z, P.vp.y + (1.0 - ny) * 0.5 * P.vp.w);
+}
+fn pos_at(p: vec2i) -> vec3f { return view_pos(vec2f(p) + vec2f(0.5), depth_at(p)); }
+
+// misc = (radius, strength, blur x, blur y)
+@fragment fn ao(in: VOut) -> @location(0) vec4f {
+  let px = vec2i(in.pos.xy) * 2;
+  let d = depth_at(px);
+  if (d <= 1e-7) { return vec4f(1.0); }
+  let c = pos_at(px);
+  let r = pos_at(px + vec2i(2, 0));
+  let l = pos_at(px - vec2i(2, 0));
+  let u = pos_at(px - vec2i(0, 2));
+  let dn = pos_at(px + vec2i(0, 2));
+  // The neighbour on the same surface (the smaller step in depth).
+  let dx = select(c - l, r - c, abs(r.z - c.z) < abs(c.z - l.z));
+  let dy = select(c - u, dn - c, abs(dn.z - c.z) < abs(c.z - u.z));
+  var n = normalize(cross(dx, dy));
+  if (dot(n, -c) < 0.0) { n = -n; }
+  let noise = fract(52.9829189 * fract(dot(in.pos.xy, vec2f(0.06711056, 0.00583715))));
+  let ang = noise * 6.2831853;
+  let t0 = normalize(select(cross(n, vec3f(0.0, 1.0, 0.0)), cross(n, vec3f(1.0, 0.0, 0.0)), abs(n.y) > 0.9));
+  let b0 = cross(n, t0);
+  let t = t0 * cos(ang) + b0 * sin(ang);
+  let b = cross(n, t);
+  let radius = P.misc.x;
+  let dist = abs(c.z);
+  var occ = 0.0;
+  for (var i = 0; i < 12; i++) {
+    let fi = f32(i);
+    let a = fi * 2.3999632;
+    let rr = sqrt((fi + 0.5) / 12.0);
+    let dir = t * (cos(a) * rr) + b * (sin(a) * rr) + n * sqrt(max(0.0, 1.0 - rr * rr));
+    let k = (fi + noise) / 12.0;
+    let s = c + dir * (radius * mix(0.15, 1.0, k * k));
+    let sd = depth_at(vec2i(to_pixel(s)));
+    if (sd <= 1e-7) { continue; }
+    let sz = abs(view_z(sd));
+    // Something in front of the sample point (nearer the eye) hides it.
+    if (sz < abs(s.z) - 0.02 * radius) {
+      occ += smoothstep(0.0, 1.0, radius / max(abs(dist - sz), 1e-3));
+    }
+  }
+  // Bright pixels (a lit window's view, a lamp, sunlight) are lit, not in
+  // shade: the occlusion fades out over them.
+  let col = textureLoad(colorTex, clamp(px, vec2i(0), vec2i(P.size.xy) - vec2i(1)), 0).rgb;
+  let lit = smoothstep(0.25, 0.6, max(col.r, max(col.g, col.b)));
+  let ao = 1.0 - occ / 12.0 * (1.0 - lit);
+  return vec4f(ao, 0.0, 0.0, 1.0);
+}
+// Within a surface only: weights fall with the depth step.
+@fragment fn blur(in: VOut) -> @location(0) vec4f {
+  let q = vec2i(in.pos.xy);
+  let dir = vec2i(P.misc.zw);
+  let zc = abs(view_z(depth_at(q * 2)));
+  let half = vec2i(P.size.zw);
+  var sum = 0.0;
+  var wsum = 0.0;
+  for (var k = -4; k <= 4; k++) {
+    let p = clamp(q + dir * k, vec2i(0), half - vec2i(1));
+    let z = abs(view_z(depth_at(p * 2)));
+    let w = exp(-f32(k * k) / 8.0) * exp(-abs(z - zc) / max(0.03 * zc, 1e-3));
+    sum += textureLoad(aoTex, p, 0).r * w;
+    wsum += w;
+  }
+  return vec4f(sum / max(wsum, 1e-5), 0.0, 0.0, 1.0);
+}
+@fragment fn apply(in: VOut) -> @location(0) vec4f {
+  let ao = textureSampleLevel(aoTex, samp, in.pos.xy / P.size.xy, 0.0).r;
+  let v = pow(clamp(ao, 0.0, 1.0), P.misc.y);
+  return vec4f(v, v, v, 1.0);
+}
+)";
+
+float env_float(const char* name, float fallback) {
+  const char* e = std::getenv(name);
+  return e != nullptr ? static_cast<float>(std::atof(e)) : fallback;
+}
+// AURORA_SSAO=<strength> (testing) overrides the game's setting.
+std::atomic<float> g_strength{env_float("AURORA_SSAO", 0.f)};
+const bool g_strengthFromEnv = std::getenv("AURORA_SSAO") != nullptr;
+const float g_radius = env_float("AURORA_SSAO_RADIUS", 40.f);
+// AURORA_SSAO_SHOW=1 (testing): the frame shows the occlusion alone.
+const bool g_show = std::getenv("AURORA_SSAO_SHOW") != nullptr;
+
+struct Pipelines {
+  uint32_t samples = 0;
+  wgpu::TextureFormat colorFormat = wgpu::TextureFormat::Undefined;
+  wgpu::BindGroupLayout layout;
+  wgpu::RenderPipeline ao, blur, apply;
+};
+Pipelines g_p;
+
+struct Targets {
+  wgpu::Extent3D size{};
+  wgpu::Texture raw, blurred, back;  // half size
+  wgpu::TextureView rawView, blurredView, backView;
+  wgpu::TextureView depth, color;
+  wgpu::BindGroup aoGroup, blurH, blurV, applyGroup;
+};
+Targets g_t;
+wgpu::Sampler g_sampler;
+wgpu::Buffer g_params[2];  // [0] AO, horizontal blur and apply; [1] vertical blur
+
+void make_pipelines(uint32_t samples, wgpu::TextureFormat colorFormat) {
+  std::string code = kShader;
+  const std::string type = samples > 1 ? "texture_depth_multisampled_2d" : "texture_depth_2d";
+  code.replace(code.find("DEPTH_TYPE"), 10, type);
+  wgpu::ShaderSourceWGSL source{};
+  source.code = code.c_str();
+  const wgpu::ShaderModuleDescriptor moduleDesc{.nextInChain = &source, .label = "SSAO"};
+  const auto module = g_device.CreateShaderModule(&moduleDesc);
+  const std::array entries{
+      wgpu::BindGroupLayoutEntry{
+          .binding = 0,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture = {.sampleType = wgpu::TextureSampleType::Depth,
+                      .viewDimension = wgpu::TextureViewDimension::e2D,
+                      .multisampled = samples > 1},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 1,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture = {.sampleType = wgpu::TextureSampleType::Float, .viewDimension = wgpu::TextureViewDimension::e2D},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 2,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .sampler = {.type = wgpu::SamplerBindingType::Filtering},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 3,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .buffer = {.type = wgpu::BufferBindingType::Uniform, .minBindingSize = 80},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 4,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture = {.sampleType = wgpu::TextureSampleType::Float, .viewDimension = wgpu::TextureViewDimension::e2D},
+      },
+  };
+  const wgpu::BindGroupLayoutDescriptor layoutDesc{.label = "SSAO", .entryCount = entries.size(), .entries = entries.data()};
+  g_p.layout = g_device.CreateBindGroupLayout(&layoutDesc);
+  const wgpu::PipelineLayoutDescriptor pipelineLayoutDesc{.label = "SSAO", .bindGroupLayoutCount = 1, .bindGroupLayouts = &g_p.layout};
+  const auto pipelineLayout = g_device.CreatePipelineLayout(&pipelineLayoutDesc);
+  const auto make = [&](const char* entry, wgpu::TextureFormat format, uint32_t count, bool multiply) {
+    const wgpu::BlendState blend{
+        .color = {.operation = wgpu::BlendOperation::Add,
+                  .srcFactor = wgpu::BlendFactor::Zero,
+                  .dstFactor = wgpu::BlendFactor::Src},
+        .alpha = {.operation = wgpu::BlendOperation::Add,
+                  .srcFactor = wgpu::BlendFactor::Zero,
+                  .dstFactor = wgpu::BlendFactor::One},
+    };
+    const wgpu::ColorTargetState target{
+        .format = format,
+        .blend = multiply && !g_show ? &blend : nullptr,
+        .writeMask = multiply ? wgpu::ColorWriteMask::Red | wgpu::ColorWriteMask::Green | wgpu::ColorWriteMask::Blue
+                              : wgpu::ColorWriteMask::All,
+    };
+    const wgpu::FragmentState fragment{.module = module, .entryPoint = entry, .targetCount = 1, .targets = &target};
+    const wgpu::RenderPipelineDescriptor desc{
+        .label = "SSAO",
+        .layout = pipelineLayout,
+        .vertex = {.module = module, .entryPoint = "vs"},
+        .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList},
+        .multisample = {.count = count},
+        .fragment = &fragment,
+    };
+    return g_device.CreateRenderPipeline(&desc);
+  };
+  g_p.ao = make("ao", kAoFormat, 1, false);
+  g_p.blur = make("blur", kAoFormat, 1, false);
+  g_p.apply = make("apply", colorFormat, samples, true);
+  g_p.samples = samples;
+  g_p.colorFormat = colorFormat;
+  g_t = {};  // bind groups follow the layout
+}
+
+// color: the resolved EFB for the occlusion pass; any other float view
+// elsewhere (the apply pass resolves into the EFB, so may not sample it).
+wgpu::BindGroup group(const wgpu::TextureView& ao, const wgpu::Buffer& params, const wgpu::TextureView& color) {
+  const std::array entries{
+      wgpu::BindGroupEntry{.binding = 0, .textureView = g_t.depth},
+      wgpu::BindGroupEntry{.binding = 1, .textureView = ao},
+      wgpu::BindGroupEntry{.binding = 2, .sampler = g_sampler},
+      wgpu::BindGroupEntry{.binding = 3, .buffer = params, .size = 80},
+      wgpu::BindGroupEntry{.binding = 4, .textureView = color},
+  };
+  const wgpu::BindGroupDescriptor desc{.label = "SSAO", .layout = g_p.layout, .entryCount = entries.size(), .entries = entries.data()};
+  return g_device.CreateBindGroup(&desc);
+}
+
+void make_targets(const wgpu::Extent3D& size, const wgpu::TextureView& depth, const wgpu::TextureView& color) {
+  const auto half = [&](const char* label, wgpu::Texture& tex, wgpu::TextureView& view) {
+    const wgpu::TextureDescriptor desc{
+        .label = label,
+        .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding,
+        .size = {(size.width + 1) / 2, (size.height + 1) / 2, 1},
+        .format = kAoFormat,
+    };
+    tex = g_device.CreateTexture(&desc);
+    view = tex.CreateView();
+  };
+  g_t.size = size;
+  g_t.depth = depth;
+  g_t.color = color;
+  half("SSAO", g_t.raw, g_t.rawView);
+  half("SSAO blurred", g_t.blurred, g_t.blurredView);
+  half("SSAO back", g_t.back, g_t.backView);
+  g_t.aoGroup = group(g_t.backView, g_params[0], color);  // (aoTex unused)
+  g_t.blurH = group(g_t.rawView, g_params[0], g_t.backView);
+  g_t.blurV = group(g_t.blurredView, g_params[1], g_t.rawView);
+  g_t.applyGroup = group(g_t.backView, g_params[0], g_t.rawView);
+}
+
+void draw(const wgpu::CommandEncoder& cmd, const wgpu::RenderPipeline& pipeline, const wgpu::BindGroup& bind,
+          const wgpu::TextureView& target, const wgpu::TextureView& resolve, bool load, const char* label) {
+  const wgpu::RenderPassColorAttachment attachment{
+      .view = target,
+      .resolveTarget = resolve,
+      .loadOp = load ? wgpu::LoadOp::Load : wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+      .clearValue = {1.0, 1.0, 1.0, 1.0},
+  };
+  const wgpu::RenderPassDescriptor desc{.label = label, .colorAttachmentCount = 1, .colorAttachments = &attachment};
+  auto pass = cmd.BeginRenderPass(&desc);
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, bind);
+  pass.Draw(3);
+  pass.End();
+}
+} // namespace
+
+float strength() noexcept { return g_strength.load(std::memory_order_relaxed); }
+
+void set_strength(float strength) noexcept {
+  if (!g_strengthFromEnv)
+    g_strength.store(strength, std::memory_order_relaxed);
+}
+
+void apply(const wgpu::CommandEncoder& cmd, const Scene& scene, const wgpu::TextureView& color,
+           const wgpu::TextureView& resolve, const wgpu::TextureView& depth, const wgpu::TextureView& resolved,
+           const wgpu::Extent3D& size, uint32_t msaaSamples) {
+  const float s = strength();
+  if (s <= 0.f || !scene.valid || scene.width <= 0.f || scene.height <= 0.f || scene.p00 == 0.f ||
+      scene.p11 == 0.f || !depth)
+    return;
+  if (!g_sampler) {
+    const wgpu::SamplerDescriptor samplerDesc{
+        .label = "SSAO",
+        .addressModeU = wgpu::AddressMode::ClampToEdge,
+        .addressModeV = wgpu::AddressMode::ClampToEdge,
+        .magFilter = wgpu::FilterMode::Linear,
+        .minFilter = wgpu::FilterMode::Linear,
+    };
+    g_sampler = g_device.CreateSampler(&samplerDesc);
+    for (auto& b : g_params) {
+      const wgpu::BufferDescriptor desc{.label = "SSAO", .usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst, .size = 80};
+      b = g_device.CreateBuffer(&desc);
+    }
+  }
+  const auto colorFormat = webgpu::g_graphicsConfig.surfaceConfiguration.format;
+  if (g_p.samples != msaaSamples || g_p.colorFormat != colorFormat)
+    make_pipelines(msaaSamples, colorFormat);
+  if (!g_t.raw || g_t.size.width != size.width || g_t.size.height != size.height || g_t.depth.Get() != depth.Get() ||
+      g_t.color.Get() != resolved.Get())
+    make_targets(size, depth, resolved);
+  const float halfW = static_cast<float>((size.width + 1) / 2), halfH = static_cast<float>((size.height + 1) / 2);
+  float params[2][20];
+  for (int i = 0; i < 2; ++i) {
+    float* p = params[i];
+    p[0] = scene.p00, p[1] = scene.p02, p[2] = scene.p11, p[3] = scene.p12;
+    p[4] = scene.a, p[5] = scene.b, p[6] = scene.minDepth, p[7] = scene.maxDepth;
+    p[8] = scene.left, p[9] = scene.top, p[10] = scene.width, p[11] = scene.height;
+    p[12] = g_radius, p[13] = s, p[14] = i == 0 ? 1.f : 0.f, p[15] = i == 0 ? 0.f : 1.f;
+    p[16] = static_cast<float>(size.width), p[17] = static_cast<float>(size.height), p[18] = halfW, p[19] = halfH;
+    g_queue.WriteBuffer(g_params[i], 0, p, sizeof params[i]);
+  }
+  const webgpu::gpu_prof::Zone zone{cmd, "SSAO"};
+  draw(cmd, g_p.ao, g_t.aoGroup, g_t.rawView, nullptr, false, "SSAO");
+  draw(cmd, g_p.blur, g_t.blurH, g_t.blurredView, nullptr, false, "SSAO blur");
+  draw(cmd, g_p.blur, g_t.blurV, g_t.backView, nullptr, false, "SSAO blur");
+  draw(cmd, g_p.apply, g_t.applyGroup, color, msaaSamples > 1 ? resolve : nullptr, true, "SSAO apply");
+}
+
+} // namespace aurora::gfx::ssao

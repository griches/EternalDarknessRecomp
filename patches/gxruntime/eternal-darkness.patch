+// A row or column black right across the finished frame is a bar, whatever
+// was under it (a bar over a dark scene leaves it unchanged).
+constexpr const char* kCoverShader = R"(
+struct VOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f };
+@vertex fn vs(@builtin(vertex_index) i: u32) -> VOut {
+  let p = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
+  var o: VOut;
+  o.pos = vec4f(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);
+  o.uv = p;
+  return o;
+}
+@group(0) @binding(0) var finished: texture_2d<f32>;
+@group(0) @binding(1) var samp: sampler;
+@group(1) @binding(0) var scene: texture_2d<f32>;
+fn brightest(uv: vec2f) -> f32 {
+  let c = textureSampleLevel(finished, samp, uv, 0.0).rgb;
+  return max(c.r, max(c.g, c.b));
+}
+@fragment fn cover(in: VOut) -> @location(0) vec4f {
+  var row = 0.0;
+  var column = 0.0;
+  for (var i = 0; i < 24; i++) {
+    let t = (f32(i) + 0.5) / 24.0;
+    row = max(row, brightest(vec2f(t, in.uv.y)));
+    column = max(column, brightest(vec2f(in.uv.x, t)));

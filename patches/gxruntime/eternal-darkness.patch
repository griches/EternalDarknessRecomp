+// its GX work, decoding and drawing beside it; returns game's result once it
+// has finished. One thread (game called here) when GX threading is off:
+// DOL_GX_THREAD=0, trace recording, or the live Aurora GX path.
+int dol_aurora_run_game(int (*game)(void*), void* arg);
+// True while the game runs on its own thread.
+bool dol_aurora_gx_threaded(void);

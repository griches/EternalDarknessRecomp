+// GXRuntime recomp patch: the XFB in guest RAM (gfx/xfb_present.hpp). Each
+// display copy's texture is drawn at the copy's own size (640x528 for a
+// full-screen copy, not the render resolution) and read back, a few hundred
+// KB; once mapped it is encoded and kept for the next display copy to the same
+// destination to write.
+namespace xfb_ram {
+struct Slot {
+  wgpu::Buffer buffer;
+  uint64_t size = 0;
+  uint32_t bytesPerRow = 0;
+  bool bgra = false;
+  gfx::gxcore::XfbRamTarget target;
+  std::atomic<bool> busy{false};
+};
+Slot g_slots[3];
+wgpu::Texture g_texture;  // render worker only
+wgpu::TextureView g_view;
+
+Slot* encode(wgpu::CommandEncoder& encoder, const webgpu::TextureWithSampler& source,
+             const gfx::gxcore::XfbRamTarget& target) {
+  if (target.width == 0 || !source.view || !webgpu::g_CopyPipeline) {
+    return nullptr;
+  }
+  Slot* slot = nullptr;
+  for (auto& s : g_slots) {
+    if (!s.busy.load(std::memory_order_acquire)) {
+      slot = &s;
+      break;
+    }
+  }
+  if (slot == nullptr) {
+    return nullptr;  // the earlier readbacks are still mapping: next frame
+  }
+  const uint32_t width = target.width, height = target.height;  // the copy's own texture
+  const auto format = webgpu::g_graphicsConfig.surfaceConfiguration.format;
+  if (!g_texture || g_texture.GetWidth() != width || g_texture.GetHeight() != height ||
+      g_texture.GetFormat() != format) {
+    const wgpu::TextureDescriptor desc{
+        .label = "XFB RAM readback texture",
+        .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::CopySrc,
+        .size = {.width = width, .height = height, .depthOrArrayLayers = 1},
+        .format = format,
+    };
+    g_texture = g_device.CreateTexture(&desc);
+    g_view = g_texture.CreateView();
+  }
+  const std::array attachments{wgpu::RenderPassColorAttachment{
+      .view = g_view,
+      .loadOp = wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+  }};
+  const wgpu::RenderPassDescriptor passDesc{
+      .label = "XFB RAM readback pass",
+      .colorAttachmentCount = attachments.size(),
+      .colorAttachments = attachments.data(),
+  };
+  const auto pass = encoder.BeginRenderPass(&passDesc);
+  pass.SetPipeline(webgpu::g_CopyPipeline);
+  pass.SetBindGroup(0, webgpu::create_copy_bind_group(source), 0, nullptr);
+  pass.SetViewport(0.f, 0.f, static_cast<float>(width), static_cast<float>(height), 0.f, 1.f);
+  pass.Draw(3);
+  pass.End();
+  const uint32_t bytesPerRow = (width * 4u + 255u) & ~255u;
+  const uint64_t size = static_cast<uint64_t>(bytesPerRow) * height;
+  if (!slot->buffer || slot->size != size) {
+    const wgpu::BufferDescriptor desc{
+        .label = "XFB RAM readback buffer",
+        .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+        .size = size,
+    };
+    slot->buffer = g_device.CreateBuffer(&desc);
+    slot->size = size;
+  }
+  slot->bytesPerRow = bytesPerRow;
+  slot->bgra = format == wgpu::TextureFormat::BGRA8Unorm || format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  slot->target = target;
+  slot->busy.store(true, std::memory_order_release);
+  const wgpu::TexelCopyTextureInfo src{.texture = g_texture};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = bytesPerRow, .rowsPerImage = height},
+      .buffer = slot->buffer,
+  };
+  const wgpu::Extent3D extent{.width = width, .height = height, .depthOrArrayLayers = 1};
+  encoder.CopyTextureToBuffer(&src, &dst, &extent);
+  return slot;
+}
+
+void map(Slot* slot) {
+  if (slot == nullptr) {
+    return;
+  }
+  slot->buffer.MapAsync(wgpu::MapMode::Read, 0, slot->size, wgpu::CallbackMode::AllowSpontaneous,
+                        [slot](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                          if (status == wgpu::MapAsyncStatus::Success) {
+                            const auto* data =
+                                static_cast<const uint8_t*>(slot->buffer.GetConstMappedRange(0, slot->size));
+                            gfx::gxcore::xfb_ram_store(data, slot->bytesPerRow, slot->bgra, slot->target);
+                            slot->buffer.Unmap();
+                          }
+                          slot->busy.store(false, std::memory_order_release);
+                        });
+}

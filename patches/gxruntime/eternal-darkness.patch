+#pragma once
+
+// GXRuntime recomp patch: frame interpolation. When the screen refreshes
+// faster than the game draws (120 Hz against its 60), the frames in between
+// replay the game frame's own draw packet with each draw's matrices blended
+// from the previous frame's (common.cpp end_frame). This part keeps each
+// frame's draws and uniforms, matches the draws of one frame to the last's,
+// and builds the blended uniform buffers.
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace gxruntime::gxcore {
+struct DrawPlan;
+} // namespace gxruntime::gxcore
+
+namespace aurora::gfx::interp {
+using Uniforms = std::shared_ptr<const std::vector<uint8_t>>;
+
+// On while frames in between are wanted; takes effect at the next frame.
+void set_wanted(bool on) noexcept;
+// This frame's draws and uniforms are being kept (decided at begin_frame).
+bool recording() noexcept;
+
+// Render thread: a new frame, a uniform upload (its offset in the frame's
+// uniform buffer) and a draw's vertex and shared uniform offsets.
+void begin_frame() noexcept;
+void note_uniform(uint32_t offset, const uint8_t* data, size_t length) noexcept;
+void note_draw(const gxruntime::gxcore::DrawPlan& plan, uint32_t vsOffset, uint32_t xfOffset) noexcept;
+
+enum class Result : uint8_t {
+  Blend,       // the buffers are built
+  Still,       // nothing moved: the frames in between would be this one
+  Cut,         // the camera jumped: blending would smear two shots together
+  NoReference, // no previous frame to blend from
+};
+// One buffer per phase in (0, 1): this frame's uniforms (uniformSize bytes)
+// with every matched draw's matrices at t between the previous frame (0) and
+// this one (1). Anything but Blend leaves `out` empty: show this frame.
+Result build(const float* phases, size_t count, size_t uniformSize, std::vector<Uniforms>& out);
+
+struct Stats {
+  uint32_t draws = 0;   // this frame's draws with uniforms of their own
+  uint32_t matched = 0; // found in the previous frame by geometry
+  uint32_t loose = 0;   // found by state alone (geometry built each frame)
+  uint32_t moved = 0;   // whose position matrix changed
+  uint32_t jumped = 0;  // ... by too much to blend
+  Result result = Result::NoReference;
+};
+Stats last_stats() noexcept;
+
+// Photo mode: frames are kept while on (as for frames in between); the frame
+// just ended is taken as the held one (photo_capture, false without draws);
+// its uniforms are rebuilt for a free camera: every perspective draw's
+// projection through fn (in: the game's, out: the photo's), the HUD (small
+// orthographic draws) moved off the screen when hideHud.
+using PhotoProjection = void (*)(const float in[4][4], float out[4][4], const void* user);
+// A lens flare's light at `light` on the game's screen (-1..1), seen through
+// the scene's projection: the 2x2 map of the screen that takes it to where
+// the photo sees it; false when it is out of sight (the flare left out).
+using PhotoFlare = bool (*)(const float light[2], const float scene[4][4], float m[2][2], const void* user);
+void set_photo(bool on) noexcept;
+bool photo_capture() noexcept;
+Uniforms photo_build(size_t uniformSize, PhotoProjection fn, const void* user, bool hideHud, PhotoFlare flare);
+} // namespace aurora::gfx::interp

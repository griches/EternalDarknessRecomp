+    seen.palette = palette;
+  }
+  const bool cycling = seen.paletteChanged != UINT32_MAX && frame - seen.paletteChanged <= 8u;
+  for (const auto& e : g_emitTextures)
+    if (format == e.format && width == e.width && height == e.height &&
+        (e.hash != 0u ? seen.hash == e.hash : cycling))
+      return true;

<rml>
<head>
	<title>Eternal Darkness HUD</title>
	<style>
		body {
			width: 100%;
			height: 100%;
			margin: 0;
			font-family: "Fira Sans";
			font-weight: bold;
			font-size: 18dp;
			pointer-events: none;
		}
		#fps {
			display: block;
			position: absolute;
			left: 14dp;
			top: 10dp;
			padding: 3dp 8dp;
			color: #f0e6c8;
			background-color: #00000099;
			border-radius: 4dp;
		}
	</style>
</head>
<body>
	<div id="fps"></div>
</body>
</rml>

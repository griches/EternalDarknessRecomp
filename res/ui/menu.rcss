/* RmlUi has no default style sheet: declare what the menu uses. */
div { display: block; }
span { display: inline; }

/* The Tome: ink on parchment pages bound in dark leather. Art drawn by
   tools/ui/make_tome_art.py. */
body {
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	font-family: "IM FELL English";
	font-weight: normal;
	font-size: 25dp;
	color: #2a1810;
	background-color: #120a05;
	decorator: image(tome/leather.png fill);
}

/* Over the game the page sits on the dimmed, paused frame. */
body.overlay {
	background-color: #000000b0;
	decorator: none;
}

#book {
	display: flex;
	padding: 6dp;
	background-color: #5e3f1c;
	border: 1dp #2a1a0c;
	border-radius: 3dp;
}

.page {
	position: relative;
	display: flex;
	flex-direction: column;
	width: 470dp;
	padding: 30dp 50dp 20dp 50dp;
	border: 1dp #8a6a3a;
	decorator: image(tome/parchment.png fill);
}

/* Options opens as a spread; every other menu is a single page. */
#page1 {
	display: none;
}

body.spread #page1 {
	display: flex;
}

body.spread .page {
	width: 430dp;
}

/* Hand-ruled frame inside the page edge. */
.rule {
	position: absolute;
	left: 13dp;
	top: 13dp;
	right: 13dp;
	bottom: 13dp;
	border: 1dp #7a201266;
}

#emblem,
#emblem-divider {
	display: none;
}

/* The emblem sits midway between the page's ruled frame (its line ends 14dp
   down, the emblem starts at the 30dp padding: 16dp) and the divider's line
   (7dp margin + half the 18dp divider: 16dp). */
body.branded #emblem {
	display: block;
	width: 220dp;
	height: 220dp;
	margin: 0 auto 7dp auto;
}

body.branded #emblem-divider {
	display: block;
	width: 300dp;
	height: 18dp;
	margin: 0 auto 12dp auto;
}

#heading {
	font-family: "IM FELL English SC";
	font-size: 38dp;
	color: #8e1b12;
	text-align: center;
	margin-bottom: 4dp;
}

body.branded #heading {
	display: none;
}

/* "I · Display": a section of a spread. */
.section {
	font-family: "IM FELL English SC";
	font-size: 22dp;
	color: #7a2012;
	border-bottom: 1dp #7a201280;
	padding: 0 2dp 2dp 2dp;
	margin: 16dp 0 4dp 0;
}

/* A break between groups of rows on a single page. */
.gap {
	height: 24dp;
	margin: 4dp 70dp;
	decorator: image(tome/rule.png contain center center);
}

.row {
	display: flex;
	align-items: center;
	padding: 4dp 2dp;
}

/* The red-ink diamond beside the chosen row. */
.mark {
	width: 14dp;
	height: 14dp;
	margin-right: 10dp;
	visibility: hidden;
}

/* Dotted leader from a setting to its value. */
.leader {
	flex: 1;
	height: 22dp;
	margin: 0 8dp;
	decorator: image(tome/leader.png repeat-x left bottom);
}

.label { }

.value {
	font-style: italic;
	color: #5a3a20;
	white-space: nowrap;
}

.row.selected {
	color: #8e1b12;
}

.row.selected .mark {
	visibility: visible;
}

.row.selected .value {
	color: #8e1b12;
}

.row.selected .leader {
	decorator: image(tome/leader-red.png repeat-x left bottom);
}

.row.disabled,
.row.disabled .value {
	color: #8a7a62;
}

.row.selected.disabled {
	color: #9a6a5a;
}

.note {
	/* Always two lines tall, so a longer help text never resizes (and so
	   re-centres) the page as the selection moves. */
	height: 48dp;
	overflow: hidden;
	margin-top: 14dp;
	font-style: italic;
	font-size: 18dp;
	color: #6a4a2a;
	text-align: center;
}

#hint {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 16dp;
	font-size: 17dp;
	font-style: italic;
	color: #a08660;
	text-align: center;
}

body.overlay #hint {
	color: #d2bf98;
}

/* Button and key icons (Kenney Input Prompts, CC0) in their ink versions
   (res/ui/glyphs/ink), drawn straight on the parchment. */
img.glyph {
	width: 32dp;
	height: 32dp;
	margin-left: 4dp;
	vertical-align: middle;
}

.sep {
	display: inline-block;
	width: 18dp;
}

.keycap {
	display: inline-block;
	padding: 1dp 8dp;
	margin-left: 4dp;
	border: 1dp #5a3a20;
	border-radius: 4dp;
	font-size: 17dp;
	font-style: normal;
	color: #2a1810;
	vertical-align: middle;
}

.unbound {
	color: #8a7a62;
}

/* Long lists (Button mapping): tighter rows. */
body.compact .row {
	padding: 1dp 2dp;
	font-size: 21dp;
}

body.compact .page {
	width: 560dp;
	padding-top: 22dp;
}

body.compact #heading {
	font-size: 32dp;
}

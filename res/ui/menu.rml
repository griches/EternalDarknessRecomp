<rml>
<head>
	<title>Eternal Darkness</title>
	<link type="text/rcss" href="menu.rcss"/>
</head>
<body>
	<!-- The Tome: each menu is a parchment page (Options a two-page spread). -->
	<div id="book">
		<div class="page" id="page0">
			<div class="rule"></div>
			<img id="emblem" src="emblem.png"/>
			<img id="emblem-divider" src="tome/divider.png"/>
			<div id="heading"></div>
			<div class="menu" id="menu0"></div>
			<div class="note" id="note0"></div>
		</div>
		<div class="page" id="page1">
			<div class="rule"></div>
			<div class="menu" id="menu1"></div>
			<div class="note" id="note1"></div>
		</div>
	</div>
	<div id="hint"></div>
</body>
</rml>
